#!/bin/bash

set -euo pipefail

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: required command '$cmd' is not available in PATH" >&2
    exit 1
  fi
}

if [[ ! -d ./opkg-utils ]]; then
  local opkg_source="https://github.com/thespinmaster/opkg-utils"
  echo "cloning opkg-utils from (${opkg_source})"
  require_cmd git
  git clone "${opkg_source}"
fi

./install-opkg-utils

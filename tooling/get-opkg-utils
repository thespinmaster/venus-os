#!/bin/bash

set -euo pipefail

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: required command '$cmd' is not available in PATH" >&2
    exit 1
  fi
}
 
if [[ ! -d ./opkg-utils ]]; then
  require_cmd git
  git clone https://github.com/shr-project/opkg-utils
else
  echo "opkg-utils exists"
fi

uninstall_coreutils=

if ! opkg list-installed 2>/dev/null | grep -q "^coreutils "; then
  opkg update
  opkg install coreutils
  uninstall_coreutils=1
fi

cur_dir="$PWD"
trap 'cd "$cur_dir"' EXIT

cd ./opkg-utils/
make install

((uninstall_coreutils==1)) &&
  opkg remove coreutils
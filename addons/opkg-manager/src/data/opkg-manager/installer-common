#!/usr/bin/env bash

set -o nounset
RC_LOCAL_SCRIPT="${RC_LOCAL_SCRIPT-}"

PACKAGE_ACTION="${1:-}"
# set package name using the path of the calling file's location
PACKAGE_NAME="${PACKAGE_NAME-"$(basename "$(dirname "$(realpath "${0}")")")"}"
PACKAGE_DBUS_SETTINGS="${PACKAGE_DBUS_SETTINGS-}"
PACKAGE_DEVICE_KEY="${PACKAGE_DEVICE_KEY-}"
PACKAGE_DEVICE_SERVICE_NAME="${PACKAGE_DEVICE_SERVICE_NAME-}"
PACKAGE_DEVICE_DISPLAY_NAME="${PACKAGE_DEVICE_DISPLAY_NAME-}"
PACKAGE_SERVICES="${PACKAGE_SERVICES-}"
PACKAGE_GUI_V2_PLUGIN_NAME="${PACKAGE_GUI_V2_PLUGIN_NAME-}"
PACKAGE_VERSION_NEW=
PACKAGE_VERSION_CURRENT=
RESTART_GUI=
RUNNING_FROM_GUI=

[[ "$PACKAGE_ACTION" == "dev-install" || "$PACKAGE_ACTION" == "dev-remove" ]] &&
	DEV_INSTALL=1;

[[ ${DEV_INSTALL:-} == 1 ]] && [[ -d /data/dev/addons/opkg-manager/src ]] &&
	export VE_ROOT_PATH=/data/dev/addons/opkg-manager/src


[[ -n "${__SOURCE_COMMON_SOURCED:-}" ]] || {
	# shellcheck source=/data/dev/addons/opkg-manager/src/data/opkg-manager/source-common
	source "${VE_ROOT_PATH:-}/data/opkg-manager/source-common" && __SOURCE_COMMON_SOURCED=1; }

__try_call() {
	local calling_method="${1}"
	if declare -F "${calling_method}" >/dev/null; then
		shift
		${calling_method} "$@"
	fi
}

__install_common_has_device_vars() {
	[[ -n "${PACKAGE_DEVICE_KEY:-}" ]] ||
	[[ -n "${PACKAGE_DEVICE_SERVICE_NAME:-}" ]] ||
	[[ -n "${PACKAGE_DEVICE_DISPLAY_NAME:-}" ]]
}

__install_common_has_custom_overview_pages() {
	declare -p PACKAGE_CUSTOM_OVERVIEW_PAGES >/dev/null 2>&1 || return 1
	((${#PACKAGE_CUSTOM_OVERVIEW_PAGES[@]} > 0))
}
__install_common_has_custom_nav_pages() {
	declare -p PACKAGE_CUSTOM_NAV_PAGES >/dev/null 2>&1 || return 1
	((${#PACKAGE_CUSTOM_NAV_PAGES[@]} > 0))
}
__install_common_has_custom_menus() {
	declare -p PACKAGE_CUSTOM_MENUS >/dev/null 2>&1 || return 1
	((${#PACKAGE_CUSTOM_MENUS[@]} > 0))
}

__install_common_validate_custom_overview_pages_definition() {
	declare -p PACKAGE_CUSTOM_OVERVIEW_PAGES >/dev/null 2>&1 || return 0

	local declaration=
	declaration="$(declare -p PACKAGE_CUSTOM_OVERVIEW_PAGES 2>/dev/null)"
	[[ "${declaration}" == declare\ -a* ]] || {
		echo "ERROR: PACKAGE_CUSTOM_OVERVIEW_PAGES must be a bash array with entries: Key or Key=Value" >&2
		return 1
	}

	return 0
}


__install_common_validate_custom_menus_definition() {
	declare -p PACKAGE_CUSTOM_MENUS >/dev/null 2>&1 || return 0

	local declaration=
	declaration="$(declare -p PACKAGE_CUSTOM_MENUS 2>/dev/null)"
	[[ "${declaration}" == declare\ -a* ]] || {
		echo "ERROR: PACKAGE_CUSTOM_MENUS must be a bash array with entries: Path or Path=Value" >&2
		return 1
	}

	return 0
}

__install_common_parse_custom_overview_page_entry() {
	local entry="${1:-}"
	local -n _out_key="$2"
	local -n _out_value="$3"

	[[ -n "${entry}" ]] || {
		echo "ERROR: PACKAGE_CUSTOM_OVERVIEW_PAGES contains an empty entry" >&2
		return 1
	}

	if [[ "${entry}" == *=* ]]; then
		_out_key="${entry%%=*}"
		_out_value="${entry#*=}"
	else
		_out_key="${entry}"
		_out_value=
	fi

	[[ -n "${_out_key}" ]] || {
		echo "ERROR: PACKAGE_CUSTOM_OVERVIEW_PAGES entry '${entry}' has an empty key" >&2
		return 1
	}

	return 0
}

__install_common_install_guiv2_plugin() {

	[[ -z "${PACKAGE_GUI_V2_PLUGIN_NAME:-}" ]] && return 0
	local plugin_name="${PACKAGE_GUI_V2_PLUGIN_NAME}"

	RESTART_GUI=1

	echo "Installing gui-v2 plugin: ${plugin_name}"

	mkdir -p "/data/apps/available/${plugin_name}/gui-v2" && \
		cp "/data/${PACKAGE_NAME}/${plugin_name}.json" \
			 "/data/apps/available/${plugin_name}/gui-v2/${plugin_name}.json"

	mkdir -p "/data/apps/enabled" && \
		ln -sf "/data/apps/available/${plugin_name}" /data/apps/enabled

	echo "Installing gui-v2 plugin: ${PACKAGE_GUI_V2_PLUGIN_NAME} - done"
	return 0
}

__install_common_remove_guiv2_plugin() {
  [[ -z "${PACKAGE_GUI_V2_PLUGIN_NAME:-}" ]] && return 0

	RESTART_GUI=1

	echo "Removing gui-v2 plugin: $PACKAGE_GUI_V2_PLUGIN_NAME"

	rm -rf "/data/apps/available/${PACKAGE_GUI_V2_PLUGIN_NAME}"
	rm -rf "/data/apps/enabled/${PACKAGE_GUI_V2_PLUGIN_NAME}"
}

__install_common_parse_custom_menu_entry() {
	local entry="${1:-}"
	local -n _out_path="$2"
	local -n _out_value="$3"

	[[ -n "${entry}" ]] || {
		echo "ERROR: PACKAGE_CUSTOM_MENUS contains an empty entry" >&2
		return 1
	}

	if [[ "${entry}" == *=* ]]; then
		_out_path="${entry%%=*}"
		_out_value="${entry#*=}"
	else
		_out_path="${entry}"
		_out_value=
	fi

	[[ -n "${_out_path}" ]] || {
		echo "ERROR: PACKAGE_CUSTOM_MENUS entry '${entry}' has an empty path" >&2
		return 1
	}

	return 0
}

install_common_add_remove_custom_overview_pages() {
	local action="${1:-}"
	local entry=
	local key=
	local value=

	for entry in "${PACKAGE_CUSTOM_OVERVIEW_PAGES[@]}"; do
		__install_common_parse_custom_overview_page_entry "${entry}" key value || return 1
		local path="'path':'/Settings/OpkgManager/CustomOverviewPages/${key}'"
		if [[ "${action}" == "remove" ]]; then
			dbus_common_remove_settings 1>/dev/null <<< "{$path}"
		else
			dbus_common_add_settings 1>/dev/null <<< "{$path, 'default':'${value}'}"
		fi

	done
}

__install_common_json_to_array() {
	local -n __json="$1"
	local -n __result="$2"

	[[ "${__json:1}" != "[" ]] && { __result=(); return 0; }

	mapfile -t __result < <(
		python3 -c '
import json
import sys

for value in json.loads(sys.argv[1]):
    print(value)
' "${__json}"
	)
}
__install_common_array_to_json() {
	local -n __ary="$1"
	local -n __result="$2"

	__result=$(
		python3 -c '
import json
import sys

print(json.dumps(sys.argv[1:]))
' "${__ary[@]}"
	)
}

install_common_add_remove_custom_nav_pages() {
	local action="${1:-}"
	local json_value=
	local ary_values=
	local dbus_path='/Settings/OpkgManager/CustomNavPages'

	dbus_common_get_value "${dbus_path}" json_value ''

	__install_common_json_to_array json_value ary_values

	for entry in "${PACKAGE_CUSTOM_NAV_PAGES[@]}"; do

		local full_name="qrc:/${PACKAGE_GUI_V2_PLUGIN_NAME}/${entry}.qml"
		local -i found=-1
		local -i i

		for i in "${!ary_values[@]}"; do
			[[ "${ary_values[$i]}" == "${full_name}" ]] && { found=$i; break; }
		done

		if [[ "${action}" == "remove" ]]; then
			((found!=-1)) && unset 'ary_values[$found]'
		elif ((found==-1)); then
			ary_values+=("${full_name}")
		fi

	done

	# Convert ary_values back to a JSON array
	json_value=""
	__install_common_array_to_json ary_values json_value

	dbus_common_set_string_value "${dbus_path}" "${json_value}" 1>/dev/null

	return 0
}


install_common_add_custom_menus() {
	local entry=
	local menu_path=
	local value=

	for entry in "${PACKAGE_CUSTOM_MENUS[@]}"; do
		__install_common_parse_custom_menu_entry "${entry}" menu_path value || return 1
		local path="{'path':'/Settings/OpkgManager/CustomMenus/${menu_path}', 'default':'${value}'}"
		dbus_common_add_settings 1>/dev/null <<< "$path"
	done
}

install_common_remove_custom_menus() {
	local entry=
	local menu_path=
	local value=

	for entry in "${PACKAGE_CUSTOM_MENUS[@]}"; do
		__install_common_parse_custom_menu_entry "${entry}" menu_path value || return 1
		local path="{'path':'/Settings/OpkgManager/CustomMenus/${menu_path}'}"
		dbus_common_remove_settings 1>/dev/null <<< "$path"
	done
}

__install_common_require_custom_device_vars() {
	__install_common_has_device_vars || return 1

	[[ -n "${PACKAGE_DEVICE_KEY:-}" ]] || {
		echo "ERROR: PACKAGE_DEVICE_KEY not set" >&2
		return 1
	}
	[[ -n "${PACKAGE_DEVICE_SERVICE_NAME:-}" ]] || {
		echo "ERROR: PACKAGE_DEVICE_SERVICE_NAME not set" >&2
		return 1
	}
	[[ -n "${PACKAGE_DEVICE_DISPLAY_NAME:-}" ]] || {
		echo "ERROR: PACKAGE_DEVICE_DISPLAY_NAME not set" >&2
		return 1
	}

	return 0
}

install_common_add_custom_device() {
	__install_common_require_custom_device_vars || return 1

	dbus_common_add_settings 1>/dev/null <<EOF
{'path':'/Settings/OpkgManager/Devices/${PACKAGE_DEVICE_KEY}/ProductName', 'default':'${PACKAGE_DEVICE_DISPLAY_NAME}'}
{'path':'/Settings/OpkgManager/Devices/${PACKAGE_DEVICE_KEY}/ServiceName', 'default':'${PACKAGE_DEVICE_SERVICE_NAME}'}
EOF
}

install_common_remove_custom_device() {
	__install_common_require_custom_device_vars || return 1

	dbus_common_remove_settings 1>/dev/null <<EOF
{'path':'/Settings/OpkgManager/Devices/${PACKAGE_DEVICE_KEY}/ProductName'}
{'path':'/Settings/OpkgManager/Devices/${PACKAGE_DEVICE_KEY}/ServiceName'}
EOF
}

# arguments {1} (optional): set to "remove" to remove
install_common_add_remove_patch() {
	local remove=0
	local msg=

	if [[ "${1:-}" == "remove" ]]; then
		remove=1
		msg="Reverting patched files"
  else
		msg="Patching files"
	fi

	shopt -s nullglob

  local installer_path; installer_path="$(dirname "$(realpath "${0}")")"

	for patchfile in "$installer_path"/*.patch; do
		[[ -n "$msg" ]] && { echo "$msg"; msg=; }

		RESTART_GUI=1
		if ((remove==0)); then
			file_patcher_apply_patch "$patchfile"
		else
			file_patcher_revert_patch "$patchfile"
		fi
	done

}

__initialize=0

install_common_initialize() {
	(( ${__initialize:-0} )) && return
	__initialize=1

	[[ -z "${RUNNING_FROM_GUI}" ]] && {
		[[ -f /var/lock/opkg-manager-install ]] && RUNNING_FROM_GUI=1 || RUNNING_FROM_GUI=0; }

	addsource "opkg-common"
	addsource "dbus-common"
	addsource "file-patcher"
	addsource "service-common"
  addsource "serial-device-installer"
}

install_common_uninstall_serial_device_services() {

	install_common_is_upgrade &&
		return

	addsource "serial-device-installer"

	serial_device_installer_uninstall_service "${PACKAGE_DEVICE_SERVICE_NAME}"
}

install_common_stop_services() {

	[[ -z ${PACKAGE_SERVICES:-} ]] && return

	echo "Removing services"

	local service=
	for service in "${PACKAGE_SERVICES[@]}"; do
	  # Don't remove the opkg-manager service if upgrading
		[[ "$service" == "opkg-manager" ]] && continue
		echo "Removing service: $service"
		service_common_remove_service "$service"
	done
}

install_common_start_services() {

	[[ -z ${PACKAGE_SERVICES:-} ]] && return

	local service=

	echo "Restarting services"

	for service in "${PACKAGE_SERVICES[@]}"; do
		cp -rf "/opt/victronenergy/service/${service}" "/service"

		service_common_restart_service "$service"
		service_common_restart_service "${service}/log"

		# svscan will start any other services
	done

}

install_common_install() {

  [[ -z "${PACKAGE_NAME:-}" ]] && { echo "ERROR: PACKAGE_NAME not set"; return 1; }
	__install_common_validate_custom_overview_pages_definition || return 1
	__install_common_validate_custom_menus_definition || return 1

	install_common_initialize

	__try_call "pre_install"

	echo "Registering package: ${PACKAGE_NAME}"
	opkg_common_register_package "${PACKAGE_NAME}"

	if [[ -f "/data/${PACKAGE_NAME}/buildtime" ]]; then
		echo "Package build time: $(cat /data/"${PACKAGE_NAME}"/buildtime)"
	fi

	install_common_add_remove_patch add

  if [[ -n "${PACKAGE_DBUS_SETTINGS:-}" || -n "${PACKAGE_DBUS_SETTINGS_DEPRECATED:-}" ]]; then
		echo "Adding dbus settings"

		[[ -n "${PACKAGE_DBUS_SETTINGS_DEPRECATED:-}" ]] &&
			dbus_common_remove_settings <<< "${PACKAGE_DBUS_SETTINGS_DEPRECATED}" 1>/dev/null

		[[ -n "${PACKAGE_DBUS_SETTINGS:-}" ]] && {
			dbus_common_add_settings <<< "${PACKAGE_DBUS_SETTINGS}" 1>/dev/null
		}
	fi

	if __install_common_has_custom_overview_pages; then
		install_common_add_remove_custom_overview_pages || return 1
	fi

	if __install_common_has_custom_nav_pages; then
	  echo "Adding custom nav pages"
		install_common_add_remove_custom_nav_pages || return 1
	fi

	if __install_common_has_custom_menus; then
		echo "Adding gui-v1 custom menus"
		install_common_add_custom_menus || return 1
	fi

	if __install_common_has_device_vars; then
		echo "Adding custom device info"
		install_common_add_custom_device || return 1
	fi

	if [[ -n "${PACKAGE_DEVICE_SERVICE_NAME}" ]]; then
		addsource "serial-device-installer"
		# shellcheck disable=SC2034  # used by serial_device_installer
		DEVICE_SERVICE_NAME="${PACKAGE_DEVICE_SERVICE_NAME}"
		serial_device_installer_add_service_mapping
	fi

	install_common_start_services

	[[ -n "${PACKAGE_GUI_V2_PLUGIN_NAME:-}" ]] &&
		RESTART_GUI=1

	__try_call "post_install"

	__install_common_finalize

	echo "Finished installing $PACKAGE_NAME"

	return 0
}

install_common_remove() {

	[[ -z "$PACKAGE_NAME" ]] && { echo "ERROR: PACKAGE_NAME not set"; return 1; }

	__install_common_validate_custom_overview_pages_definition || return 1
	__install_common_validate_custom_menus_definition || return 1

	install_common_initialize

	__try_call "pre_remove"

	[[ -n "${RC_LOCAL_SCRIPT:-}" ]] &&
		opkg_common_remove_script_from_rc_local "${RC_LOCAL_SCRIPT}"

	opkg_common_unregister_package "$PACKAGE_NAME"

	install_common_stop_services

	install_common_add_remove_patch remove

	if __install_common_has_device_vars; then
		echo "Removing custom service settings"
		install_common_remove_custom_device || return 1
	fi

	if ! install_common_is_upgrade; then
		if [[ -n "${PACKAGE_DBUS_SETTINGS:-}" ]]; then
			echo "Removing dbus settings"
			dbus_common_remove_settings <<< "$PACKAGE_DBUS_SETTINGS" 1>/dev/null
		fi
	fi

	if __install_common_has_custom_overview_pages; then
		echo "Removing custom overview page settings"
		install_common_add_remove_custom_overview_pages remove || return 1
	fi

	if __install_common_has_custom_nav_pages; then
		echo "Removing custom gui-v2 navigation page settings"
		install_common_add_remove_custom_nav_pages remove || return 1
	fi

	if __install_common_has_custom_menus; then
		echo "Removing custom menu settings"
		install_common_remove_custom_menus || return 1
	fi

	if [[ -n "${PACKAGE_DEVICE_SERVICE_NAME}" ]]; then
		echo "Removing services for ${PACKAGE_DEVICE_SERVICE_NAME}"
		install_common_uninstall_serial_device_services
	fi

	[[ -n "${PACKAGE_GUI_V2_PLUGIN_NAME:-}" || "$PACKAGE_NAME" == "opkg-manager" ]] &&
		RESTART_GUI=1

	__try_call "post_remove"

	if install_common_is_upgrade; then
		echo "Removed previous install, upgrading now..."
	else
	  __install_common_finalize
		echo "Finished removing $PACKAGE_NAME"
	fi

	return 0
}

install_common_is_upgrade() {
	[[ $PACKAGE_ACTION == "upgrade-remove" || $PACKAGE_ACTION == "upgrade-install"  ]]
}

install_common_is_remove() {
	[[ $PACKAGE_ACTION == "remove" || $PACKAGE_ACTION == "upgrade-remove" || $PACKAGE_ACTION == "dev-remove" ]]
}

__install_common_finalize() {

	((!RESTART_GUI)) && {
		echo "  nothing to do "
		return
	}

	if ((RUNNING_FROM_GUI)); then
		echo "::FINALIZING-INSTALL::" # ui
		sleep 5 # time to see final messages in ui before restarting
	else
		echo "Finalizing install" # ui
	fi

	if install_common_is_remove; then
		__try_call "finalize_remove"
		__install_common_remove_guiv2_plugin
	else
		__try_call "finalize_install"
		__install_common_install_guiv2_plugin
	fi

	# ((RESTART_GUI)) && # always restart ui(s)
		install_common_restart_gui

}

install_common_restart_gui() {
	echo "Restarting UI..."
	svc -t /service/flashmq
	svc -t /service/gui >/dev/null
}

###########################################################################

if [[ $PACKAGE_ACTION == "configure" ]]; then
  declare package_no_extension="${2%.*}"

	# shellcheck disable=SC2034  # Used in other scripts
	PACKAGE_VERSION_NEW="$(awk '/Version:/ {print $2}' "${package_no_extension}".control 2>/dev/null)"
	PACKAGE_VERSION_CURRENT="$(opkg status "$PACKAGE_NAME" 2>/dev/null | awk '/Version:/ {print $2}' 2>/dev/null)"
	[[ -z "$PACKAGE_VERSION_CURRENT" ]] \
		&& PACKAGE_ACTION="install" \
		|| PACKAGE_ACTION="upgrade-install"
	#TODO downgrade?
elif [[ "$PACKAGE_ACTION" == "upgrade" ]]; then
	PACKAGE_ACTION="upgrade-remove"
fi

case "${PACKAGE_ACTION}" in
  install|upgrade-install|configure|dev-install)
	  echo "Install Action: $PACKAGE_ACTION"
		install_common_install;;
  remove|upgrade-remove|dev-remove)
	  echo "Install Action: $PACKAGE_ACTION"
    install_common_remove;;
esac

DEFAULT_USB_PROPS="ID_MODEL,ID_VENDOR,ID_SERIAL"

# __device_send_props_as_json <associated array of properties>
# takes an associated array of properties and returns a JSON string of properties.
__device_send_props_as_json() {
  local -n assoc_ref="$1"
  local json="{"
  local first=1
  local key value escaped_key escaped_value

  for key in "${!assoc_ref[@]}"; do
    value="${assoc_ref[$key]}"
    escaped_key=${key//\\/\\\\}
    escaped_key=${escaped_key//\"/\\\"}
    escaped_value=${value//\\/\\\\}
    escaped_value=${escaped_value//\"/\\\"}
    (( first )) && first=0 || json+=","
 
    json+="\"${escaped_key}\":\"${escaped_value}\""
  done

  json+="}"
  printf '%s\n' "$json"
}

# __autoReconnect <service path> <out tty>
# for testing... re-connects the usb device without physically re-plugging in the device
# <service path> The name of the path at OpkgManager/CustomServices/${service_path}/DEVICE_TTY
# <out tty> The name of the usb port
__autoReconnect() {
  [[ -z "${1:-}" ]] && return
  
  local service_path="${1}"
  local -n device="${2}"
 
  dbus_common_get_value "/Settings/OpkgManager/CustomServices/${service_path}/TestTTY" device
 
  [[ -z $device || ! -e /dev/$device ]] && return 0 # no device or device does not exist
  
  echo "Auto connecting device: $device"
  (
    local this_path; this_path=$(dirname "${BASH_SOURCE[0]}")
    $this_path/../libs/usb-lib "reconnect" "$device" 1>/dev/null 2>/dev/null
    (($?==0)) && echo "✓ Reconnect succeeded" || echo "✗ Reconnect failed"
  )
}
 
# device_detect_usb <dbus service path> <autoReconnect (optional)>
# usage device_detect_usb "Inetbox" "ttyUSB0"
# <dbus service path> is the name of the Custom Service 
#  i.e. Inetbox =/OpkgManager/CustomServices/Inetbox/...
# detects the usb device that gets plugged in to a port
# Returns a json string containing:
#  port: < the tty port name i.e. ttyUSB0 >
#  process: < the name process of any service currently using the port (if any) >
#  serialStarterProbing: < true if the port is being probed by the serial starter >
#  usbProps: < a | separated list of usb properties the supplied service path requires >
device_detect_usb() {
  # Configurable property list (edit as needed)
 
  local service_path="${1}"
  local autoReconnect="${2:-}"
  local tty=
 
  if [[ -n $autoReconnect ]]; then
    __autoReconnect $service_path tty
  fi
 
  [[ -z $tty ]] && device_get_usb_port tty
  [[ -e "/dev/${tty}" ]] || { echo "Device not found" >&2; return 1; }
 
  echo "✓ Found device: $tty"

  local -A json_props
  local usb_props=
  local process_pid= process_name= possible_process_name=
  local service_name= 

  __fill_usb_props "$tty" "${service_path}" usb_props
  
  #echo "usb_props=$usb_props"
  echo "Getting device status..."

  # notes
  # fuser can be used to get the pid from the tty port
  # svstat can return pid of the service when up. 
  # A service may be running, but not using the tty port (might be crashing, etc.)
  #   so need to poll svstat first to see if service name is available, then fuser as a backup
  # Try to get the service name using the VE_SERVICE and the serial-starter.conf file
  # if service name is found probe its status for a stable pid
  # probe for a stable pid service or process using service name or tty port
  # if a stable pid is found and not using service name, see if we can get a service name
  #   from from pid
  # if no service name is found use the process name

  local -i process_state=0
  DEVICE_TTY="$tty"
  local service_name=

  serial_device_installer_service_name_from_tty "${DEVICE_TTY}" service_name || true
  [[ -n $service_name ]] &&
    service_name_or_tty="/service/${service_name}.${DEVICE_TTY}" || service_name_or_tty="$DEVICE_TTY"

  DEVICE_SERVICE_NAME="$service_name"

  device_get_stable_tty_process_pid "$service_name_or_tty" process_pid possible_process_name
  process_state=$?
 
  if (( process_state == 0 )); then
    if [[ -n "${DEVICE_SERVICE_NAME:-}" ]]; then
      service_name="${DEVICE_SERVICE_NAME:-}"
    elif ! device_find_service_from_pid "$process_pid" "$tty" service_name; then
      process_name=$(ps -p "$process_pid" -o comm= 2>/dev/null | tr -d ' ')
    fi 
  elif (( process_state == 2 )); then
    if [[ -n "${DEVICE_SERVICE_NAME:-}" ]]; then
      service_name="${DEVICE_SERVICE_NAME} [Unstable]"
    else
      process_name="[Unstable]"
    fi
  elif (( process_state == 130 )); then
    return 130
  fi
 
  local sid=$(__get_usb_prop "$tty" "SERIAL_DEVICE_ID")

  if (( process_state == 1 )) then
    echo "✓ Device not in use"
  elif [[ -n $sid ]]; then
    echo "⚠ Warning: Custom device in use by: ${service_name:-$process_name}"
  elif [[ $process_name == "[Unstable]" ]]; then
    echo "⚠ Warning: Custom device in use by unstable device(s)"
    [[ -n $possible_process_name ]] && echo "   possibly $possible_process_name"
  else
    echo "✗ Error: Device in use by: ${service_name:-$process_name}"
  fi
 
  json_props["port"]="$tty"
  json_props["process"]="$process_name"
  json_props["service"]="$service_name"
  json_props["usbProps"]="$usb_props"
  json_props["sid"]="$sid"
 
  echo "Done"

  # keep last
  __device_send_props_as_json json_props
  
  return 0
}


# device_apply <tty> <service path> <usp props>
# usage "ttyUSB0" "Inetbox" $usbProps
device_apply() {
 
  local service_path="$1"
  local tty="$2"
  local usbProps="$3"
  local usbProps_current=

  echo "Installing USB serial device..."

  # check passed args
  [[ -z "${service_path}" ]] && { echo "device_apply: Error: Service path not passed" >&2; return 1; }
  [[ -z "${tty}" ]] && { echo "device_apply: Error: tty not passed" >&2; return 1; }
  [[ -z "${usbProps}" ]] && { echo "device_apply: Error: usbProps not passed" >&2; return 1; }

  # check tty is still valid, if so get props
  [[ -e "/dev/${tty}" ]] && { __fill_usb_props "${tty}" "${service_path}" usbProps_current; }
  
  # compare props with passed props to detect if device is the same as the one detected 
  # in device_detect_usb.
  [[ "${usbProps_current}" != "${usbProps}" ]] && { echo "Usb device has changed. Re-detect" >&2; return; }
 
  local sid=$(__get_usb_prop $tty SERIAL_DEVICE_ID)

  #if [[ -n $sid ]]; then
  #  echo "Removing existing serial starter rule"
  #  device_remove "$sid" "$tty" || \
  #    echo "⚠ Warning: failed to remove existing serial starter rule"
  #fi

  # get dbus values
  local dbus_path_prefix="/Settings/OpkgManager/CustomServices"
  local service_name= usb_mapping_name=
  dbus_common_get_value "${dbus_path_prefix}/${service_path}/ServiceName" service_name
 
  # fill serial-starter-installer variables
  DEVICE_UDEV_PROPS="${usbProps}"
  DEVICE_TTY="${tty}"
  DEVICE_SID="${sid:-}"
  DEVICE_SERVICE_NAME="${service_name}"
  DEVICE_SERVICE_MAPPING_NAME="${usb_mapping_name}"

  # do install and start service
  serial_device_installer_install_from_sid && serial_device_installer_start_service 1>/dev/null || {
    echo "✗ Failed"
    return 1
  }
  
  # ensure serial starter service is running
  if [[ "$(svstat /service/serial-starter)" == *"serial-starter: down"* ]]; then
    echo "⚠ Warning: serial-starter: down. Restarting..."
    svc -u /service/serial-starter
  fi

  # start our service
  echo "Starting service..."

  local r= out_pid=;
  device_get_stable_tty_process_pid "$SERVICE_PATH/$DEVICE_SERVICE_NAME.$DEVICE_TTY" out_pid; r=$?
  ((r==130)) && return 130; # cancelled
  ((r==1)) && { echo "✗ Service not started"; return 1; }
  ((r==2)) && { echo "✗ Service not stable"; return 1; }
  
  echo "~~✓ Starting service"
  echo "✓ Done"
  return 0
}

# device_get_usb_port <out tty>
# Uses udevadm to monitor when a usb device is added
# Returns the device port (tty) of the added device
# Use ^C to cancel monitoring
device_get_usb_port() {
  local fifo
  local line
  local path
  local -n _tty="$1"
  local UDEV_PID=""
  local FIFO_PATH=""
 
_device_cleanup_udevadm() {
  echo "_device_cleanup_udevadm"
  if [[ -n "$UDEV_PID" ]]; then
    kill -2 "$UDEV_PID" 2>/dev/null
    #wait "$UDEV_PID" 2>/dev/null
    UDEV_PID=""
  fi
  if [[ -n "$FIFO_PATH" ]]; then
    rm -f "$FIFO_PATH"
    FIFO_PATH=""
  fi
}

  fifo=$(mktemp -u)
  mkfifo "$fifo"
  FIFO_PATH="$fifo"
  
  trap '_device_cleanup_udevadm' SIGTERM SIGINT 

  udevadm monitor --subsystem-match=tty -u > "$fifo" &
 
  UDEV_PID=$!
  # ---
  # NOTE: Bash signal handling (traps) only occure between commands.
  # If we use a blocking read, Bash cannot process signals (like SIGTERM)
  # and the process will not exit until the read returns.
  # By using a timed read (-t 1) on $fifo, we allow Bash to periodically 
  # check for signals and run the trap handler, so the process can be 
  # stopped/cancelled gracefully.
  # The loop only exits if the FIFO is removed or closed.
  # ---
  
  while true; do
    if read -r -t 0.5 line < "$fifo"; then
      if [[ "$line" =~ ^UDEV\ .*[\[][0-9]*\.[0-9]*[]]\ add\  ]]; then
        # Extract the path
        path=${line#*add      }
        path=${path%% *}
        # Extract tty device name
        _tty=${path##*/}
        kill -2 "$UDEV_PID"
        wait "$UDEV_PID" 2>/dev/null
        UDEV_PID=
        break
      fi
    elif [[ ! -p "$fifo" ]]; then
        # read timed out or FIFO closed
        break
    fi
  done < "$fifo"
 
  # Remove FIFO (cleanup will also do this, but for safety)
  rm -f "$fifo"
  FIFO_PATH=""
  
}

# __get_usb_prop <tty> <property name>
# Usage: model=$(__get_usb_prop ttyUSB0 ID_MODEL)
__get_usb_prop() {
    udevadm info --query=property --name="$1" | sed -n "s/^$2=//p"
}

# get_usb_props <tty> <array_var_name> <property list>
# Usage: get_usb_props ttyUSB0 usb_props PROPS[@]
__fill_usb_props() {
  local tty="$1"
  local service_path="$2"
  local -n udevadm_props_ref="$3"
  local prop val found_name
  local udevadm_out udevadm_props=""
  local usb_prop_names=
  local -a __props

  usb_prop_names=$udevadm_props_ref
  udevadm_props_ref=""

  # Get props to retrieve using the service_path else use defaults
  dbus_common_get_value "/Settings/OpkgManager/CustomServices/${service_path}/UsbProps" usb_prop_names
  [[ -z $usb_prop_names ]] && usb_prop_names="$DEFAULT_USB_PROPS"
  
  udevadm_out=$(udevadm info --query=property --name="$tty" 2>/dev/null)
  
  IFS=',' read -r -a __props <<< "$usb_prop_names"
  for prop in "${__props[@]}"; do
    [[ ${prop:0,1} == "+" ]] && prop=${prop:1}
    val=$(echo "$udevadm_out" | sed -n "s/^$prop=//p")
    udevadm_props="$udevadm_props,$prop=$val"
  done

  if [[ -n $udevadm_props ]]; then
    udevadm_props_ref=${udevadm_props:1} #strip starting ,
  else
    udevadm_props_ref=""
  fi

}
  
# device_get_stable_tty_process_pid <tty|service_path> <out_pid> [out_possible_names] [stable_checks]
# Samples a tty or service path and returns success once the same PID has been
# observed for the requested number of consecutive checks.
# Return codes:
#   0 = stable PID found and written to out_pid
#   1 = no process currently using the tty/service
#   2 = unstable startup detected before becoming stable
#   3 = invalid arguments
device_get_stable_tty_process_pid() {
 
  local service="" tty=""
  local -n __out_pid="${2}"
  local __out_possible_names_name="${3:-}"
  local -A possible_names=()
  local -A seen_pids=()
  local -A seen_signatures=()
  local -i stable_checks="${4:-5}"
  local -i max_checks=0
  local possible_name="" current_name="" joined_possible_names="" current_signature=""
  local current_pid="" last_pid=""
  local -i i=0 consecutive_same_pid=0 unstable_seen=0 observed_any=0 cancelled=0
  local -i success=

  [[ -z "${1:-}" || -z "${2:-}" ]] && return 3
  [[ "${1:0:1}" == "/" ]] && service="${1}" || tty="${1}"

  (( stable_checks < 1 )) && stable_checks=1
  (( max_checks = stable_checks * 4 ))

  trap 'cancelled=1' SIGINT SIGTERM
 
  __out_pid=
  [[ -n "$__out_possible_names_name" ]] && printf -v "$__out_possible_names_name" '%s' ""

  for ((i=1; i<=max_checks; i++)); do
    (( cancelled )) && break

    current_pid=""
    if [[ -n "$service" ]]; then
      current_pid=$(svstat "$service" 2>/dev/null)
      if [[ "$current_pid" =~ \(pid[[:space:]]+([0-9]+)\) ]]; then
        current_pid="${BASH_REMATCH[1]}"
      else
        current_pid=""
      fi
    else
      current_pid=$(fuser "/dev/$tty" 2>/dev/null | tr -s ' ')
      [[ -n "$current_pid" ]] && current_pid="${current_pid##* }"
    fi

    if [[ -n "$current_pid" ]]; then
      observed_any=1
      current_name=$(ps -p "$current_pid" -o comm= 2>/dev/null | tr -d ' ')
      [[ -n "$current_name" ]] && possible_names["$current_name"]=""

      current_signature=$(ps -p "$current_pid" -o args= 2>/dev/null)
      [[ -z "$current_signature" && -r "/proc/$current_pid/cmdline" ]] && current_signature=$(tr '\000' ' ' < "/proc/$current_pid/cmdline" | sed 's/[[:space:]]*$//')
      current_signature="${current_signature:-${current_name:-pid:$current_pid}}"

      if [[ "$current_pid" == "$last_pid" ]]; then
        ((consecutive_same_pid+=1))
        if (( unstable_seen == 0 && consecutive_same_pid >= stable_checks )); then
          __out_pid="$current_pid"
          success=1
          break;
        fi
      else
        [[ -n "$last_pid" ]] && unstable_seen=1
        if [[ -n "${seen_pids[$current_pid]+x}" ]] || [[ -n "${seen_signatures[$current_signature]+x}" ]]; then
          last_pid="$current_pid"
          break
        fi
        last_pid="$current_pid"
        consecutive_same_pid=1
      fi

      seen_pids["$current_pid"]="$current_signature"
      seen_signatures["$current_signature"]="$current_pid"
    else
      [[ -n "$last_pid" ]] && unstable_seen=1
      last_pid=""
      consecutive_same_pid=0
    fi

    sleep 0.5 &
    wait $! 2>/dev/null || true
    (( cancelled )) && { trap - SIGINT SIGTERM; return 130; }
  done

  trap - SIGINT SIGTERM
  (( cancelled )) && return 130
  (( success )) && return 0
  
  while IFS= read -r possible_name; do
    [[ -z "$possible_name" ]] && continue
    [[ -n "$joined_possible_names" ]] && joined_possible_names+=" or "
    joined_possible_names+="$possible_name"
  done < <(printf '%s\n' "${!possible_names[@]}" | sort)
  [[ -n "$__out_possible_names_name" ]] && printf -v "$__out_possible_names_name" '%s' "$joined_possible_names"
 
  (( observed_any == 1 || unstable_seen == 1 )) && return 2
  return 1
}
 
device_find_service_from_pid() {
  local pid="$1" ppid comm
  local tty="$2"
  local -n out_service_name="$3"
  out_service_name=""
  local __service_name=
 
  while [[ -n "$pid" && "$pid" -gt 1 ]]; do
    
    comm="$(ps -p "$pid" -o comm= 2>/dev/null | tr -d ' ')"

    if [[ "$comm" == "supervise" ]]; then
     __service_name="$(basename "$(readlink -f "/proc/$pid/cwd")")"
     if [[ -d "/service/${__service_name}.${tty}" ]] ; then
        out_service_name="${__service_name}.${tty}"
        return 0  
      elif [[ -d "/service/${__service_name}" ]] ; then
        out_service_name="${__service_name}"
        return 0
      fi
    fi

    ppid="$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d ' ')"
    [[ -z "$ppid" ]] && break
    pid="$ppid"
  done
  return 1
}
 
device_remove_all() {
  for arg in "$@"; do
    device_remove "$arg"
  done
}

device_remove() {

  local dbus_service_name="${1}" # dbus_inetbox_sid_5f90
  [[ -z "$dbus_service_name" ]] && return 1

  DEVICE_SERVICE_NAME=
  DEVICE_SID=
  DEVICE_TTY="${2:-}"

  dbus_common_get_value "/Settings/Devices/${dbus_service_name}/Sid" DEVICE_SID
  dbus_common_delete_tree "Devices/${dbus_service_name}"

  [[ -z "$DEVICE_SID" ]] && return 1

  serial_device_installer_remove_service

  return 0
}

case "${1:-}" in
  detect)
    shift

		device_detect_usb "${1:-}" "${2:-}"
		;;
  apply)
    shift
    device_apply "${1:-}" "${2:-}" "${3:-}" 
    ;;
  remove)
    shift
    if [[ "${2:-}" == "all" ]]; then
      shift
      device_remove_all "${1:-}"
      exit $?
    fi
    device_remove "${1:-}"
    ;;

  *)
    if [[ -n ${1:-} ]]; then
      echo "device: invalid command : ${1}" >&2
    fi
    ;;
esac

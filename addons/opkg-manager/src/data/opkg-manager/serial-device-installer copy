#!/usr/bin/env bash

set -o nounset

declare __this_path;__this_path="$(dirname "${BASH_SOURCE[0]}")"

[[ -n "${__SOURCE_COMMON_SOURCED:-}" ]] || {
	# shellcheck source=/data/dev/addons/opkg-manager/src/data/opkg-manager/source-common
	source "$__this_path/source-common" && __SOURCE_COMMON_SOURCED=1; }

addsource "libs/log-lib"
addsource "service-common"

SERVICE_PATH="${SERVICE_PATH:-"/service"}"
SERIAL_STARTER_START_SERVICE_PATH="${SERIAL_STARTER_START_SERVICE_PATH:-"/dev/serial-starter"}"
SERIAL_STARTER_CONFIG_FILE="${SERIAL_STARTER_CONFIG_FILE:-"/data/conf/serial-starter.d/opkg-manager.conf"}" # "/etc/venus/serial-starter.conf"}"
SERIAL_STARTER_RULES_FILE="${SERIAL_STARTER_RULES_FILE:-"/data/conf/opkg-manager-serial-starter.rules"}"
#symlink file *must* be placed after the serial-starter.rules file
SERIAL_STARTER_RULES_FILE_SYMLINK="${SERIAL_STARTER_RULES_FILE_SYMLINK:-"/etc/udev/rules.d/serial-starter.rules-50-opkg-manager.rules"}"

# Ensures the udev-visible rules symlink points at SERIAL_STARTER_RULES_FILE.
serial_device_installer_ensure_rules_file_symlink() {
  [[ -n "${SERIAL_STARTER_RULES_FILE_SYMLINK:-}" ]] || {
    log_error "ERROR: SERIAL_STARTER_RULES_FILE_SYMLINK not set"
    return 1
  }

  if [[ -e "${SERIAL_STARTER_RULES_FILE_SYMLINK}" && ! -L "${SERIAL_STARTER_RULES_FILE_SYMLINK}" ]]; then
    log_error "ERROR: SERIAL_STARTER_RULES_FILE_SYMLINK exists and is not a symlink:${SERIAL_STARTER_RULES_FILE_SYMLINK}"
    return 1
  fi

  local current_target=""
  [[ -L "${SERIAL_STARTER_RULES_FILE_SYMLINK}" ]] && current_target="$(readlink "${SERIAL_STARTER_RULES_FILE_SYMLINK}")"

  if [[ "${current_target}" == "${SERIAL_STARTER_RULES_FILE}" ]]; then
    return 0
  fi

  ln -sfn "${SERIAL_STARTER_RULES_FILE}" "${SERIAL_STARTER_RULES_FILE_SYMLINK}" || {
    log_error "ERROR: failed to update SERIAL_STARTER_RULES_FILE_SYMLINK:${SERIAL_STARTER_RULES_FILE_SYMLINK} -> ${SERIAL_STARTER_RULES_FILE}"
    return 1
  }

  return 0
}

serial_device_installer_remove_rules_file_symlink() {
  [[ -n "${SERIAL_STARTER_RULES_FILE_SYMLINK:-}" ]] || return 0

  rm -f "${SERIAL_STARTER_RULES_FILE_SYMLINK}" || {
    log_error "ERROR: failed to remove SERIAL_STARTER_RULES_FILE_SYMLINK:${SERIAL_STARTER_RULES_FILE_SYMLINK}"
    return 1
  }

  return 0
}

# requires: DEVICE_SERVICE_NAME
# optional: DEVICE_SERVICE_MAPPING_NAME
# args_byref service_mapping_name
__get_service_mapping_name_byref() {
  local -n _service_mapping_name="${1}"
  _service_mapping_name="${DEVICE_SERVICE_MAPPING_NAME:-}"

  [[ -z "${_service_mapping_name}" ]] && {
    _service_mapping_name="ve_${DEVICE_SERVICE_NAME//-/_}" # replace - with _
    _service_mapping_name="${_service_mapping_name//./_}" # replace . with _
  }
}

# requires: DEVICE_UDEV_PROPS
# args_byref props
# args_byref count_of_filled
__count_of_filled_props_byref() {
  local -n _out_props=${1}
  local -n _count_of_filled=${2}
  _count_of_filled=0
  for key in "${!_out_props[@]}"; do
    [[ ${key:0:1} == "+" ]] && continue
    [[ -n "${_out_props[$key]}" ]] && (( _count_of_filled+=1 ))
  done
  return 0
}

# requires vars: DEVICE_UDEV_PROPS
# required args: props_byref
__read_props_byref() {

  local -n _out_props="$1";
  local -a __props
  local -A new_props
  local key value

  # Split the string into array by NUL character
  IFS=',' read -r -a __props <<< "$DEVICE_UDEV_PROPS"
  for key_value in "${__props[@]}"; do
    k="${key_value%%=*}";
    value=
    [[ "$key_value" == *"="* ]] && value="${key_value#*=}"
    [[ "$k" =~ ^[a-zA-Z0-9_+]+$ ]] || { echo "DEVICE_UDEV_PROPS are invalid" >&2; return 1; }

    new_props["$k"]="$value"
  done

  # array was loaded without any erros so unset
  # the origional values and add the new ones
  for k in "${!_out_props[@]}"; do unset "_out_props[$k]"; done
  for k in "${!new_props[@]}"; do
     _out_props["$k"]="${new_props[$k]}";
  done

  return 0
}

# requires vars: DEVICE_UDEV_PROPS
__write_props() {
  # shellcheck disable=SC2178
  local -n _props=$1
  local k=
  local key

  DEVICE_UDEV_PROPS=""
  for k in "${!_props[@]}"; do
    DEVICE_UDEV_PROPS+="$k=${_props[$k]}"$','
  done
  [[ "${DEVICE_UDEV_PROPS:(-1)}" == $',' ]] &&
    DEVICE_UDEV_PROPS="${DEVICE_UDEV_PROPS::-1}"

}

# requires vars: DEVICE_UDEV_PROPS
# args = {1} tty
# args = {2} in,out props
__fill_props_from_tty() {

  local tty="${1}"
  [[ -z "${tty}" ]] && { echo "ERROR: DEVICE_TTY not set;" >&2; return 1; }

  # shellcheck disable=SC2178
  local -n __props=${2}

  local props_to_grep=""
  __prepare_props_for_grep_byref __props props_to_grep

  local usb_info_lines
  usb_info_lines=$(udevadm info --name="/dev/${tty}" --query=property | grep -E "${props_to_grep}")

  local key value
  local -i filled_count=0
  while IFS= read -r line; do
    key="${line%%=*}"
    value="${line#*=}"
    [[ -z "${key}" ]] && continue
    __props["${key}"]="${value}"
    ((filled_count+=1))
  done <<<"${usb_info_lines}"

  return 0
}

# args: in byref props
# args: {2} out byref props_to_grep
__prepare_props_for_grep_byref() {
  # shellcheck disable=SC2178
  local -n ___props="${1}"
  local -n __props_to_grep="${2}"
  local prop key_for_regex
  for prop in "${!___props[@]}"; do
    key_for_regex="${prop//+/\\+}"
    __props_to_grep+="${key_for_regex}=|"
  done
  if [[ -n $__props_to_grep ]]; then
    __props_to_grep=${__props_to_grep::-1}
  fi
}

#args: {1} dev_path, {2} byref out tty
__get_tty_paths() {
  local -n _out=$1
  _out=(/sys/class/tty/ttyUSB* /sys/class/tty/ttyACM*)
}

__tty_device_exists() {
  [[ -e "/dev/${1}" ]] && return 0
}

# args: in byref props
# args: {2} out byref tty
__get_tty_from_props_byref() {

  local -n _props="${1}"
  local -n out_tty="${2}"
  local usb_dev_path
  local -i count_of_filled_props=0 count_of_matched_props=0
  local -i usb_def_path_index=0 found_index=-1
  local props_to_compare
  local -a tty_paths=(); __get_tty_paths tty_paths
  local props_to_grep="DEVPATH|"

  out_tty=

  __prepare_props_for_grep_byref _props props_to_grep
  __count_of_filled_props_byref _props count_of_filled_props

  for dev in "${tty_paths[@]}"; do
    [ -e "$dev" ] || continue

    count_of_matched_props=0

    props_to_compare=$(udevadm info -q property -p "$dev" | grep -E "${props_to_grep}")

    local key value

    while IFS= read -r line; do
      [[ $line =~ ^DEVPATH=* ]] && {
        usb_dev_path=${line#*=}; continue; }

      key="${line%%=*}"; value="${line#*=}"
      [[ -z "${key}" ]] && continue
      [[ "${_props[${key}]:-}" == "${value}" ]] && ((count_of_matched_props+=1))
    done <<<"${props_to_compare}"

    ((count_of_filled_props==count_of_matched_props)) && {
      ((found_index+=1))

      ((found_index==usb_def_path_index)) && break;
    }
    usb_dev_path=

  done

  if  [[ $usb_dev_path ]]; then
    # shellcheck disable=SC2034
    out_tty=$(basename "$usb_dev_path")
    return 0
  fi

  echo "ERROR: DEVICE_TTY device does not exist" >&2
  return 1
}


# requires vars: DEVICE_SERVICE_NAME,
# optional vars: DEVICE_SERVICE_MAPPING_NAME, DEVICE_SID
# required arg1 (byref in) array of usb props
# required arg2 (byref out) the serial_starter_rule
# required arg3 (byref out) the serial_starter_rule_comment comment
__create_serial_starter_rule_byref() {

  log_trace

  [[ $# -lt 3 ]] && { log_error "ERROR: missing args"; return 1; }

  local -n _props="${1}"
  local -n out_serial_starter_rule="${2}"
  local -n out_serial_starter_rule_comment="${3}"
  local service_mapping_name
  local kv
  local rules=""

  [[ -z "${DEVICE_SERVICE_NAME:-}" ]] && { log_error "ERROR 1: DEVICE_SERVICE_NAME not set"; return 1; }

  __get_service_mapping_name_byref service_mapping_name

  for kv in "${!_props[@]}"; do
    [[ "${kv}" == "ID_BUS" ]] && continue
    [[ "${kv}" == "+SERIAL_DEVICE_ID" || "${kv}" == "SERIAL_DEVICE_ID" ]] && continue
    [[ -z "${_props[$kv]}" ]] && continue

    if [[ "${kv:0:1}" == "+" ]]; then
      rules+="ENV{${kv:1}}=\"${_props[$kv]}\", "
    else
      rules+="ENV{${kv}}==\"${_props[$kv]}\", "
    fi
  done

  log_trace "udevadm matches ${rules}"
  if [[ -z "${rules}" ]]; then
    log_error "ERROR: No DEVICE_UDEV_PROPS values set."
    return 1
  fi

  if [[ -z "${DEVICE_SID:-}" ]]; then
    # a 4 bit hex value
    DEVICE_SID=$(hexdump -n 2 -e '/2 "%04x"' /dev/urandom) || {
      log_error "ERROR creating DEVICE_SID"
      return 1
    }
  fi

  rules+="ENV{SERIAL_DEVICE_ID}=\"${DEVICE_SID}\", "
  rules+="ENV{VE_SERVICE}=\"${service_mapping_name}\""
  rules="ENV{ID_BUS}==\"usb\", ${rules}"

  out_serial_starter_rule_comment="# sid:${DEVICE_SID}: ${DEVICE_SERVICE_NAME}"
  out_serial_starter_rule="ACTION==\"add\", ${rules}"

  log_trace "new serial starter rule=${out_serial_starter_rule}"

  return 0
}

# requires vars: SERIAL_STARTER_RULES_FILE, DEVICE_SERVICE_NAME
# required args: {1}= serial_starter_rule
# required args: {2}= serial_starter_rule_comment
__add_rule_to_serial_starter_rules_file() {

  log_trace

  local serial_starter_rule="${1}"
  local serial_starter_rule_comment="${2:-}"

  [[ -z "${serial_starter_rule}" ]] && { log_error "ERROR: serial starter rule not set"; return 1; }

  if grep -qF "${serial_starter_rule}" "${SERIAL_STARTER_RULES_FILE}" 2>/dev/null; then
    log "Serial starter rule exists in the file."
    return 0
  fi

  # make sure we don't add rules with duplicate DEVICE_IDs
  # aka changing device service
  serial_device_installer_remove_device_rule

  local rule_with_comment="${serial_starter_rule_comment}"$'\n'"${serial_starter_rule}"$'\n'
  echo "${rule_with_comment}" >> "${SERIAL_STARTER_RULES_FILE}"

  log "Rule added successfully."
  return 0
}

# validates: DEVICE_SERVICE_NAME, DEVICE_UDEV_PROPS, SERIAL_STARTER_RULES_FILE,
#            SERIAL_STARTER_RULES_FILE_SYMLINK, SERIAL_STARTER_CONFIG_FILE
__validate_all() {

  [[ -z "${DEVICE_SERVICE_NAME:-}" ]] && {
    log_error "ERROR 1: DEVICE_SERVICE_NAME not set"
    return 1
  }
  [[ -z "${DEVICE_UDEV_PROPS:-}" ]] && {
    log_error "ERROR: DEVICE_UDEV_PROPS not set"
    return 1
  }

  [[ -f "${SERIAL_STARTER_RULES_FILE:-}" ]] && {
    [[ -r "${SERIAL_STARTER_RULES_FILE:-}" ]] || {
      log_error "ERROR: SERIAL_STARTER_RULES_FILE does not have read access:$SERIAL_STARTER_RULES_FILE"
      return 1
    }
    [[ -w "${SERIAL_STARTER_RULES_FILE:-}" ]] || {
      log_error "ERROR: SERIAL_STARTER_RULES_FILE does not have write access:$SERIAL_STARTER_RULES_FILE"
      return 1
    }
  }

  serial_device_installer_ensure_rules_file_symlink || return 1

  [[ -f "${SERIAL_STARTER_CONFIG_FILE:-}" ]] && {
    [[ -r "${SERIAL_STARTER_CONFIG_FILE:-}" ]] || {
      log_error "ERROR: SERIAL_STARTER_CONFIG_FILE does not have read access:$SERIAL_STARTER_CONFIG_FILE"
      return 1
    }
    [[ -w "${SERIAL_STARTER_CONFIG_FILE:-}" ]] || {
      log_error "ERROR: SERIAL_STARTER_CONFIG_FILE does not have write access:$SERIAL_STARTER_CONFIG_FILE"
      return 1
    }
  }

}

# args: {1} allow_tty_discovery (1=true, 0=false)
__serial_device_installer_install_internal() {
  local -i allow_tty_discovery=${1:-1}

  __validate_all || return 1

  local tty
  local -A props; __read_props_byref props || return 1
  local -i count; __count_of_filled_props_byref props count || return 1

  if ((count==0)); then
    if ((allow_tty_discovery==0)); then
      echo "ERROR: DEVICE_UDEV_PROPS must include key=value entries for DEVICE_SID install" >&2
      return 1
    fi

    [[ $(type -t callback_get_tty_port) == function ]] && {
      callback_get_tty_port tty || return 1
      DEVICE_TTY=${tty:-}
    }
    if [[ -n ${DEVICE_TTY:-} && -e /dev/${DEVICE_TTY:-} ]]; then
      tty=$DEVICE_TTY
    else
      echo "ERROR: cannot get DEVICE_TTY" >&2
      return 1
    fi
    __fill_props_from_tty "$tty" props || return 1
    __count_of_filled_props_byref props count || return 1

    (( count==0 )) && {
      echo "ERROR: no DEVICE_UDEV_PROPS found" >&2; return 1; }

    # This is a warning so we continue but log to stderr
    ((count!=${#props[@]}  ))  && {
      echo "WARNING: not all DEVICE_UDEV_PROPS found" >&2; }

    __write_props props

  elif [[ -n ${DEVICE_TTY:-} && -e /dev/${DEVICE_TTY:-} ]]; then
    tty=$DEVICE_TTY
  elif ((allow_tty_discovery==0)); then
    echo "ERROR: DEVICE_TTY must be set to an existing device for DEVICE_SID install" >&2
    return 1
  else
    __get_tty_from_props_byref props tty || return 1
  fi

  local serial_starter_rule serial_starter_rule_comment
  __create_serial_starter_rule_byref props serial_starter_rule serial_starter_rule_comment || return 1

  __add_rule_to_serial_starter_rules_file "${serial_starter_rule}" "${serial_starter_rule_comment}" || return 1

  serial_device_installer_add_service_mapping || return $?

  DEVICE_TTY=$tty

  # reload udm
  serial_device_installer_refresh_udevadm "add"

  return 0
}

###################################################
# public methods
###################################################

# required vars: SERIAL_STARTER_CONFIG_FILE, DEVICE_SERVICE_MAPPING_NAME, DEVICE_SERVICE_NAME
serial_device_installer_add_service_mapping() {

  log_trace

  local service_mapping_name; __get_service_mapping_name_byref service_mapping_name

  local find_pattern="^[[:space:]]*service[[:space:]]+${service_mapping_name}[[:space:]]+${DEVICE_SERVICE_NAME}[[:space:]]*$"

  if ! grep -Eq "${find_pattern}" "${SERIAL_STARTER_CONFIG_FILE}" 2>/dev/null; then
    local tmp
    tmp=$(mktemp)
    local entry="service ${service_mapping_name}"$'\t\t'"${DEVICE_SERVICE_NAME}"
    {
      printf '%s\n' "${entry}"
      cat "${SERIAL_STARTER_CONFIG_FILE}"
    } >"$tmp" || {
          rm -f "$tmp"
          log_error "ERROR: could not update ${SERIAL_STARTER_CONFIG_FILE}"
          return 1
        }

    mv "$tmp" "${SERIAL_STARTER_CONFIG_FILE}" || {
      rm -f "$tmp"
      log_error "ERROR: could not replace ${SERIAL_STARTER_CONFIG_FILE}"
      return 1
    }

    serial_device_installer_restart_serial_starter_service

    log "Added service mapping config"
  else
    log "Service mapping already exists"
  fi
}


################################################
# Removes the rule added to the serial-starter.rules file
# Removes the service mapping from the serial-starter.conf file
# Sets DEVICE_TTY var to empty
# required vars: SERIAL_STARTER_CONFIG_FILE, DEVICE_SERVICE_NAME
# optional vars: DEVICE_SERVICE_MAPPING_NAME
################################################
serial_device_installer_remove_service_mapping() {

  log_trace

  [[ ! -f "${SERIAL_STARTER_CONFIG_FILE}" ]] && return 0
  [[ -z "${DEVICE_SERVICE_NAME}" ]] && { log_error "DEVICE_SERVICE_NAME not supplied"; return 1; }

  local service_mapping_name; __get_service_mapping_name_byref service_mapping_name

  local pattern="^[[:space:]]*service[[:space:]]\+${service_mapping_name}[[:space:]]\+${DEVICE_SERVICE_NAME}[[:space:]]*$"

  local tmp
  tmp=$(mktemp)
  sed "/$pattern/d" "$SERIAL_STARTER_CONFIG_FILE" > "$tmp"

  if cmp -s "$SERIAL_STARTER_CONFIG_FILE" "$tmp"; then
    log_trace "Service mapping not found"
    rm "$tmp"
  else
    mv "$tmp" "$SERIAL_STARTER_CONFIG_FILE"
    log "Removed service mapping"

    serial_device_installer_restart_serial_starter_service

  fi
}

# required vars: DEVICE_SERVICE_NAME, DEVICE_UDEV_PROPS,
#                SERIAL_STARTER_RULES_FILE, SERIAL_STARTER_CONFIG_FILE
#                SERIAL_STARTER_START_SERVICE_PATH, SERVICE_PATH
# optional vars: DEVICE_TTY, DEVICE_SERVICE_MAPPING_NAME
serial_device_installer_install() {
  __serial_device_installer_install_internal 1
}

# DEVICE_SID-first install path for callers that already resolved tty + usb props.
# required vars: DEVICE_SERVICE_NAME, DEVICE_UDEV_PROPS (key=value list),
#                SERIAL_STARTER_RULES_FILE, SERIAL_STARTER_CONFIG_FILE
# optional vars: DEVICE_SID, DEVICE_TTY, DEVICE_SERVICE_MAPPING_NAME
serial_device_installer_install_from_sid() {
  __serial_device_installer_install_internal 0
}

################################################
# updates udevadm for a usb device
# optional vars: DEVICE_TTY
# required arg 1: "add" if adding a device; "remove" if removing
################################################
serial_device_installer_refresh_udevadm() {
  local action="${1}"
  #[[ -z "${DEVICE_TTY}" ]] && { log_error "ERROR: DEVICE_TTY not set"; return 1; }
  [[ -z "${action}" ]] && { log_error "ERROR: action arg not not supplied"; return 1; }
  [[ "${action}" != "add" && "${action}" != "remove" ]] && {
     log_error "ERROR: invalid action. should be 'add' or 'remove'"; return 1; }

  udevadm control --reload
	[[ -n "${DEVICE_TTY:-}" ]] && {
		udevadm trigger --action="$action" "/sys/class/tty/$DEVICE_TTY"
		# when manualy removing we re-add so udevadm rules get re-run & thus re-freshed
		[[ $action == "remove" ]] && {
			udevadm trigger --action="add" "/sys/class/tty/$DEVICE_TTY"
		}
	}

}

serial_device_installer_restart_serial_starter_service() {

  local serial_starter_service="/service/serial-starter"

  if [ "$(svstat "$serial_starter_service" | awk '{print $2}')" = "up" ]; then
    svc -t "$serial_starter_service"
  else
    svc -u "$serial_starter_service"
  fi
}

################################################
# removes a serial starter rule from the serial-starter.rules file (/etc/udev/rules.d/serial-starter.rules)
# required vars: SERIAL_STARTER_RULES_FILE, either DEVICE_SID or DEVICE_TTY must be set
################################################
serial_device_installer_remove_rule() {
  log_trace

  [[ ! -f "${SERIAL_STARTER_RULES_FILE:-}" ]] && return 0

  if [[ -z "${DEVICE_SID:-}" ]]; then
    [[ -z "${DEVICE_TTY:-}" ]] && { log_error "ERROR: DEVICE_TTY variable not set"; return 1; }

    DEVICE_SID=$(serial_device_installer_get_usb_prop "$DEVICE_TTY" "SERIAL_DEVICE_ID")

    [[ -z "${DEVICE_SID:-}" ]] && { log_info "Cannot find SERIAL_DEVICE_ID, nothing to do"; return 0; }
  fi

  local tmp
  tmp="$(mktemp)" || return 1

  sed \
    -e "/^[[:space:]]*$/N;/^[[:space:]]*\n[[:space:]]*# sid:${DEVICE_SID}:.*$/d" \
    -e "\|^[[:space:]]*# sid:${DEVICE_SID}:.*$|d" \
    -e "\|ENV{SERIAL_DEVICE_ID}=\"${DEVICE_SID}\"|d" \
    "${SERIAL_STARTER_RULES_FILE}" | sed \
    -e '/^$/N;/^\n$/D' > "$tmp" || {
      rm -f "$tmp"
      return 1
    }

  if ! cmp -s "${SERIAL_STARTER_RULES_FILE}" "$tmp"; then
    mv "$tmp" "${SERIAL_STARTER_RULES_FILE}"
    local file_name;file_name="$(basename "${SERIAL_STARTER_RULES_FILE}")"
    log "Removed rule from ${file_name}"
  else
    rm -f "$tmp"
  fi

  return 0
}

# Removes a serial device rule and refreshes udev for a known/active tty when possible.
# required vars: SERIAL_STARTER_RULES_FILE
# optional vars: DEVICE_SID, DEVICE_TTY
serial_device_installer_remove_device_rule() {
  serial_device_installer_remove_rule || return 1

  __ensure_TTY_from_TTY_or_SID 2>/dev/null || true
	serial_device_installer_refresh_udevadm "remove" || true

  return 0
}

# Restarts all services that are not already running for
# the specific DEVICE_SERVICE_NAME.
# required vars: DEVICE_SERVICE_NAME, SERIAL_STARTER_START_SERVICE_PATH SERIAL_STARTER_CONFIG_FILE
serial_device_installer_restart_services() {

  log_trace

  [[ -z "${DEVICE_SERVICE_NAME}" ]] && { log_error "DEVICE_SERVICE_NAME not supplied"; return 1; }

  local -a tty_paths=(); __get_tty_paths tty_paths
  local tty=
  local service_mapping_name; __get_service_mapping_name_byref service_mapping_name

  for dev in "${tty_paths[@]}"; do
    [ -e "$dev" ] || continue
    tty="${dev##*/}"

    local ve_service
    ve_service=$(serial_device_installer_get_usb_prop "$tty" "VE_SERVICE")

    if [[ "$service_mapping_name" == "$ve_service" ]]; then
      #triggers rule 1 in serial-starter.rules file
      # which in-turn creates a tty file in /dev/serial-starter
      # which is picked up by the serial-starter service (serial-starter.sh)
      # ... and starts the service
      udevadm trigger --action=add /sys/class/tty/${tty}
    fi

  done

}
################################################
# Add a file (ttyACME) to /dev/serial-starter/
# this file is picked up by the serial-starter
# and starts the service.
# Requires variables:
# DEVICE_TTY, DEVICE_SERVICE_NAME, SERIAL_STARTER_START_SERVICE_PATH
################################################
serial_device_installer_start_service() {

  log_trace

  [[ -z "${DEVICE_SERVICE_NAME}" ]] && {
    log_error "ERROR 2: DEVICE_SERVICE_NAME not set"
    return 1
  }

  [[ -d "${SERIAL_STARTER_START_SERVICE_PATH}" ]] || {
    mkdir -p "${SERIAL_STARTER_START_SERVICE_PATH}"
  }

	if [[ -z "$DEVICE_TTY" ]]; then
    local -A props; __read_props_byref props || return 1
    __get_tty_from_props_byref props tty || return 1
  else
    __tty_device_exists "$DEVICE_TTY" || { log_error "ERROR: DEVICE_TTY device does not exist"; return 1; }
  fi

  log "starting service ${SERIAL_STARTER_START_SERVICE_PATH}/${DEVICE_SERVICE_NAME}.${DEVICE_TTY}"

  # make sure there is not a stuck lock in place
  rm -f "/var/lock/serial-starter/${DEVICE_TTY}"
  rm -f "/run/lock/serial-starter/${DEVICE_TTY}"

  touch "${SERIAL_STARTER_START_SERVICE_PATH}/${DEVICE_TTY}"
  return 0
}


# arguments: tty, <property name>
serial_device_installer_get_usb_prop() {
  udevadm info --query=property --name="$1" | sed -n "s/^$2=//p"
}

__ensure_TTY_from_TTY_or_SID() {

  if [[ -z "${DEVICE_TTY:-}" ]]; then
    serial_device_installer_TTY_from_SID && return 0
  fi

  __tty_device_exists "${DEVICE_TTY:-}" || { log_error "ERROR: DEVICE_TTY device does not exist"; return 1; }
  return 0
}

# Finds and sets the DEVICE_TTY variable from
# the Serial Device ID (DEVICE_SID)
# required vars: DEVICE_SID
serial_device_installer_TTY_from_SID() {
  local -A props; props["SERIAL_DEVICE_ID"]=${DEVICE_SID}
  __get_tty_from_props_byref props tty && DEVICE_TTY=$tty
}

# Finds the service name from the tty value by
# by looking up the VE_SERVICE from the udevadm props
# then finding the service_name in the SERIAL_STARTER_CONFIG_FILE
# requires SERIAL_STARTER_CONFIG_FILE
serial_device_installer_service_name_from_tty() {
  local ve_service
  local tty="${1}"
  local -n __service_name="${2}"

  __service_name=""
  ve_service=$(serial_device_installer_get_usb_prop "$tty" "VE_SERVICE")
  [[ -z "${ve_service}" ]] && { log_error "ERROR: VE_SERVICE not found"; return 1; }
  [[ ! -f "${SERIAL_STARTER_CONFIG_FILE}" ]] && {
    log_error "ERROR: SERIAL_STARTER_CONFIG_FILE not found"; return 1; }

  __service_name=$(grep -E "^service[[:space:]]+${ve_service}[[:space:]]+" "${SERIAL_STARTER_CONFIG_FILE}" \
      | sed -n '1p')

  __service_name=${__service_name##* }

  [[ -z "${__service_name}" ]] && {
    log_error "ERROR: DEVICE_SERVICE_NAME not found for VE_SERVICE:${ve_service}"
    __service_name=""
    return 1
  }
  return 0
}

#########################################
# Stops all the services using running using the supplied DEVICE_SERVICE_NAME
# Then removes the directories /service/DEVICE_SERVICE_NAME.DEVICE_TTY & /var/volatile/services/DEVICE_SERVICE_NAME.DEVICE_TTY
# optional variables: SERVICE_PATH
# required variables: 1 : DEVICE_SERVICE_NAME
# optional arguments: --no-remove-usb-rule, --no-remove-service-mapping
#########################################
serial_device_installer_uninstall_package() {
  local service_name="$DEVICE_SERVICE_NAME"
  local -i remove_rule=1 remove_mapping=1
  local service_root="${SERVICE_PATH%/}"

  log_trace

  [[ "${1-}" = "--no-remove-usb-rule" || "${2-}" = "--no-remove-usb-rule" ]] && remove_rule=0
  [[ "${1-}" == "--no-remove-service-mapping" || "${2-}" == "--no-remove-service-mapping"  ]] && remove_mapping=0

  [[ -z "$service_name" ]] && { log_error "DEVICE_SERVICE_NAME not supplied"; return; }
  local tty=

  # 1) Remove serial-starter mapping.
  ((remove_mapping)) &&
    serial_device_installer_remove_service_mapping

  local service
  for service in "${service_root}/${service_name}".*; do
    [[ ! -d "$service" ]] && continue
    log "Stopping $service"
    DEVICE_TTY="${service##*.}"

    ((remove_rule)) && {
      DEVICE_SID=
      serial_device_installer_remove_device_rule
    }
    service_common_remove_service "${service_name}.${DEVICE_TTY}"

  done

  return 0

}

# Backward-compatible uninstall entry point.
serial_device_installer_uninstall() {
  serial_device_installer_uninstall_package "$@"
}

# used by opkg-bridge to un-install
# required: DEVICE_TTY or DEVICE_SID
#           DEVICE_SERVICE_NAME, SERVICE_PATH, SERIAL_STARTER_CONFIG_FILE
serial_device_installer_remove_service() {

  local service_name=

	# ignore error code (tty may not exist and we check DEVICE_TTY below)
  __ensure_TTY_from_TTY_or_SID 2>/dev/null || true

	[[ -n "${DEVICE_TTY:-}" ]] &&
		serial_device_installer_service_name_from_tty "${DEVICE_TTY}" service_name

  # Remove rule first to avoid serial-starter recreating the instance while stopping.
  serial_device_installer_remove_device_rule || true

	if [[ -n "${DEVICE_TTY:-}" && -n "${service_name}" ]]; then
		service_common_remove_service "${service_name}.${DEVICE_TTY}"
	fi

	return 0
}

#!/usr/bin/env bash

service_common_service_up() { svstat "/service/${1}" | grep -q "^/service/${1}: up "; }

__stop_service_tree() {
	local d="$1"

	[[ -d "$d" ]] || return 0

	# Prevent supervise from immediately respawning the run/log trees.
	touch "$d/down" 2>/dev/null || true
  svc -dx "$d" 2>/dev/null || true

  if [[ -d "$d/log" ]]; then
    touch "$d/log/down" 2>/dev/null || true
    svc -dx "$d/log" 2>/dev/null || true
  fi

}

service_common_remove_service() {

  local service_name="${1}"

  echo "Uninstalling service instance: ${service_name}"

  # 1) Stop canonical and volatile service trees.
  __stop_service_tree "/service/$service_name"
  __stop_service_tree "/var/volatile/services/$service_name"
  sleep 2

  # 2) Remove service dirs/symlink.
  rm -rf "/service/$service_name" 2>/dev/null || true
  rm -rf "/var/volatile/services/$service_name" 2>/dev/null || true

  sleep 2

  # 3) Kill any remaining processes
  pkill -f -- "$service_name"

  # 4) Verification.
  if pgrep -f -- "$service_name" 2>/dev/null | grep -vx "$$" >/dev/null 2>&1; then
    echo "WARNING: matching processes still found for $service_name"
  else
    echo "OK: no matching processes for $service_name"
  fi

  if [[ -d "/service/$service_name" || -d "/var/volatile/services/$service_name" ]]; then
    echo "WARNING: service directories still exist"
    [[ -d "/service/$service_name" ]] && echo " - /service/$service_name"
    [[ -d "/var/volatile/services/$service_name" ]] && echo " - /var/volatile/services/$service_name"
  else
    echo "OK: service directories removed"
  fi

}

# stops a service and waits for it to end before returning
service_common_stop_service_and_wait() {
	local service_name="${1}"

	service_common_service_up $service_name || return

	local pid_service=$(pgrep $service_name)
	[[ -z $pid_service ]] && return

	svc -d /service/$service_name >/dev/null 2>&1 || true
	while [ -d "/proc/$pid_service"  ]; do
		sleep 1 & wait $!
	done
	return 0
}

service_common_restart_service() {
	local service="${1}"
	if service_common_service_up "$service"; then
		svc -t "/service/$service"
	else
		svc -u "/service/$service"
	fi
}

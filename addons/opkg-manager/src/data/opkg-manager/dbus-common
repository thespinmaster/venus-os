#!/bin/bash

# dbus-common: Functions for managing dbus settings for Venus OS themes

set -o nounset

# Function: dbus_common_add_settings
# Reads JSON settings lines from stdin and registers them all in one dbus call.
# Each line must be a JSON object: {"path":"/Settings/group/name", "default":"value"}
# Accepts any stdin source: <<< string, < file, or pipe.
dbus_common_add_settings () {
	local settings
	local line

	while IFS= read -r line; do
		line="${line#"${line%%[![:space:]]*}"}"
		[[ -z "$line" || "$line" == \#* ]] && continue
		settings+="${line}, "
	done

	[[ -n "$settings" ]] && {
		dbus -y com.victronenergy.settings / AddSettings "%[ $settings ]"
	}
}

dbus_common_list_keys() {
	local basePath="$1"
	local -n __out_list_settings="$2"
	local values=

	[[ -z "$basePath" || "$basePath" == "/" || "$basePath" == "/Settings" ]] && { echo "ERROR:dbus_common_delete_tree:Invalid path:" >&2; return 1; }

	__get_dbus_values values "$basePath"

	__list_settings settings "$basePath" <<< "$values" || return 1
	__out_list_settings=$settings

}

# Function: dbus_common_list_settings
# Reads JSON or Python-dict formatted lines from stdin and outputs paths byref.
# Supports two formats:
#   JSON: {"path": "/Settings/group/name"} or {'path': '/Settings/group/name'}
#   Python dict: {'FolderA/PropA': 'value a'} — extracts the key as the path
# Arguments:
#   $1 - output variable name (byref)
#   $2 - basePath (optional prefix)
#   $3 - callback (optional function name for custom joining/formatting)
__list_settings() {
	local -n __out="$1"
	local basePath="${2:-}"
	local callback="${3:-}"
	local line=
	local fullpath=
	local normalized_path=
	local -a paths=()

	if [[ $# -lt 1 || $# -gt 3 ]]; then
		echo "Usage: dbus_common_list_settings outVar [basePath] [callback] << stdin" >&2
		return 1
	fi

	if [[ -t 0 ]]; then
		echo "Error: no input provided (pipe data on stdin)" >&2
		return 1
	fi

	while IFS= read -r line; do
		# Skip blank lines and comments, including lines with leading whitespace.
		line="${line#"${line%%[![:space:]]*}"}"
		[[ -z "$line" || "$line" == \#* ]] && continue

		fullpath=

		# Try to match JSON format with "path" key (single or double quotes).
		if [[ "$line" =~ [\"\']path[\"\'][[:space:]]*:[[:space:]]*[\"\']([^\"\']+)[\"\'] ]]; then
			fullpath="${BASH_REMATCH[1]}"
		# Otherwise try to extract the first quoted string as the path.
		elif [[ "$line" =~ ^[[:space:]]*\{?[[:space:]]*[\"\']([^\"\']+)[\"\'][[:space:]]*: ]]; then
			fullpath="${BASH_REMATCH[1]}"
		else
			continue
		fi

		if [[ -n "$basePath" ]]; then
			normalized_path="${basePath%/}/${fullpath#/}"
		else
			normalized_path="$fullpath"
		fi

		paths+=("$normalized_path")
	done

	if [[ -n "$callback" ]]; then
		if ! declare -F "$callback" >/dev/null; then
			echo "Error: callback function '$callback' was not found" >&2
			return 1
		fi
		"$callback" paths __out
		return $?
	fi

	printf -v __out '%s\n' "${paths[@]}"
	__out="${__out%$'\n'}"
}

# Function: dbus_common_remove_settings
# Removes all settings listed from stdin.
# Arguments:
#   $1 - basePath (optional prefix)
#   stdin - JSON or Python dict formatted lines
dbus_common_remove_settings() {
	local basePath="${1:-}"
	local settings=

	_join_settings_for_remove() {
		local -n __paths="$1"
		local -n __joined="$2"
		local path=
		__joined=
		for path in "${__paths[@]}"; do
			__joined+="'${path}', "
		done
	}

	__list_settings settings "$basePath" _join_settings_for_remove || return 1

	[[ -n "$settings" ]] && {
		dbus -y com.victronenergy.settings / RemoveSettings "%[ $settings ]"
	}
}

dbus_common_set_string_value() {
	local path="${1}"
  local value="${2}"

	if ! dbus -y com.victronenergy.settings "$path" SetValue "$value" ; then
		local basePath="${basePath%/*}"
		local name="${basePath##*/}"
		if dbus -y com.victronenergy.settings / AddSetting "$basePath" "$name" s 0 0; then
			dbus -y com.victronenergy.settings "$path" SetValue "$value"
		else
			echo "Error: Adding setting: AddSettings \"%[ {'path':'${path}', 'default':''} ]\""
		fi
		return 1
	fi


}

# Function: dbus_common_get_value
# Get a value from the dbus settings service
# com.victronenergy.settings /Settings/Arg1/
# AddSetting is called first to create the path if it doesn't exist (idempotent).
# Arguments:
#   $1 - path (string) Path and name of the value to retrieve "OpkgManager/SerialInstaller"
#   $2 - setting (string) The name of the setting to get
#   $3 - default (optional string) The default value if the value returned is empty.
dbus_common_get_value() {
	local path="$1"
	local -n __value="$2"
	local default_value="${3:-}"
	local value

	value="$(dbus -y com.victronenergy.settings "$path" GetValue 2>/dev/null)"

	#strip single quotes from the start and end
	value="${value#\'}"
	value="${value%\'}"

	if [[ -z $value ]]; then
		__value="$default_value"
		if [[ -z $__value ]]; then
			return 1 # return 1 if no value or default is provided
		fi
	else
		__value="$value"
	fi
	return 0
}

__get_dbus_values() {
	local -n __out_values="$1"
	local basePath="$2"

	dbus_common_get_value "$basePath" __out_values

	# values can be either on a single line or on multiple lines
	# values="{'FolderA/PropA': 'value a', 'FolderB/PropB': 'value b'}"
	# values="{'FolderA/PropA': 'value a',
	# 'FolderB/PropB': 'value b'}"

	# So we collapse any newlines, then re-introduce them only at entry boundaries (, ')
	# This makes values with commas safe, and handles multi-line input
	__out_values="${__out_values//$'\n'/}"
	__out_values="${__out_values//", '"/$',\n\''}"
}

# Function: dbus_common_delete_tree
# Deletes all child settings under a dbus path by reading their current
# keys and removing them.
# Arguments:
#   $1 - basePath: the dbus path to delete, e.g. "OpkgManager/SerialInstaller"
#        Must not be empty or "/".
dbus_common_delete_tree() {
	local basePath="$1"
	local values=

	[[ -z "$basePath" || "$basePath" == "/" || "$basePath" == "/Settings" ]] && { echo "ERROR:dbus_common_delete_tree:Invalid path:" >&2; return 1; }

	__get_dbus_values values "$basePath"

	dbus_common_remove_settings "$basePath" <<< "$values"

}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	case "${1:-}" in
		dbus-remove-settings)
			shift
			dbus_common_remove_settings "$@"
			;;
		dbus-list-keys)
			shift
			settings_list=
			dbus_common_list_keys "${1}" settings_list || exit $?
			echo "$settings_list"
			;;
		dbus-add-settings)
			shift
			dbus_common_add_settings "$@"
			;;
		dbus-delete-tree)
			shift
			dbus_common_delete_tree "$1"
			;;
	esac
fi

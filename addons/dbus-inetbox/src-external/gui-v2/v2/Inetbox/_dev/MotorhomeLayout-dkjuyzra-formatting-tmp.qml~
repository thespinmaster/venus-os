import QtQuick
import QtQuick.Controls
import QtQuick.Layouts

Page {
    background: Rectangle { color: "black" }
    anchors.fill: parent

    RowLayout {
        id: mainRow
        spacing:1
        anchors {left:parent.left;right:parent.right}

        Layout.fillWidth: true

        RoomTempsColumnLayout {}
				TanksColumnLayout {}


        RowLayout {
            spacing: 1
            ColumnLayout {
                id: inputLoad
                width: 100
                anchors { top: parent.top; bottom: parent.bottom }
                spacing: 1

                Repeater {
                    model: ["red", "white", "blue"]

                    Rectangle {
                        color: modelData
                        width:parent.width
                        Layout.fillHeight: true
                    }
                }
            }

            Rectangle {
                id: battery
                border.color: "yellow";
                color:"steelblue"
                Layout.fillWidth: true
                Layout.fillHeight: true
            }

            ColumnLayout {
                id: outputLoad
                width: 100
                anchors { top: parent.top; bottom: parent.bottom;right:parent.right }
                spacing: 1

                Repeater {
                    model: ["red", "white", "blue"]

                    Rectangle {
                        color: modelData
                        width:parent.width
                        Layout.fillHeight: true
                    }
                }
            }
        }
    }

    Rectangle { color:'orange';opacity: .1; border.color: "yellow"; anchors {fill:mainRow} }

		component RoomTempsColumnLayout: ColumnLayout {
				spacing:1
				Rectangle { color: "red"; width:100; height: 100}
				Rectangle { color: "green"; width:40; height: 40}
		}

		component TanksColumnLayout: ColumnLayout {
			id: tanks
			width: 200
			anchors { top: parent.top; bottom: parent.bottom }
			spacing: 1

			Repeater {
					model: ["green", "green", "green","green", "green"]

					Rectangle {
							color: modelData
							width:parent.width
							Layout.fillHeight: true
					}
			}
	}
}

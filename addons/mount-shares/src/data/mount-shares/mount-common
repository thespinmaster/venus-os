#!/usr/bin/env bash

__this_path="$(dirname "${BASH_SOURCE[0]}")"

if [[ -f "$__this_path/../opkg-manager/libs/log-lib" ]]; then
  # shellcheck disable=SC1091
  . "$__this_path/../opkg-manager/libs/log-lib"
else
  . "$__this_path/../../../../opkg-manager/src/data/opkg-manager/libs/log-lib"
fi

# readonly mount_common_path="${VENUS_ROOT_DIR:-}/data/mount-shares"
readonly mountshares_conf_file="/data/conf/mount-shares.conf"

# exposed so can override for mocking
__mount_common___read() {
  # shellcheck disable=SC2162
  read "$@"
}

__update_mount_settings() {
  local target="${1}"
  local mount_settings="${2}"
  local line
  local -i found=0
  local temp_file

  [[ -f "${mountshares_conf_file}" ]] || {
    mkdir -p "$(dirname "${mountshares_conf_file}")"
    echo "${mount_settings}" >> "${mountshares_conf_file}"
    return 0
  }

  temp_file="$(mktemp)"
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line##* }" == "${target}" ]]; then
      echo "${mount_settings}" >> "${temp_file}"
      found=1
    else
      echo "${line}" >> "${temp_file}"
    fi
  done < "${mountshares_conf_file}"

  ((found == 0)) && echo "${mount_settings}" >> "${temp_file}"
  mv "${temp_file}" "${mountshares_conf_file}"

  return 0
}

##############################################
# Waits for a mount point to become available.
# Checks every 0.5 seconds.
# Args:
#   {1} mount point path (required)
#   {2} tries or --quiet (optional, default: 10)
#   {3} --quiet (optional)
mount_common_wait_on_mount_point() {
  local mount_point="${1}"
  local -i count=0 tries=10
  local -i quiet=0

  if [[ "${2:-}" == "--quiet" ]]; then
    quiet=1
  elif [[ -n "${2:-}" ]]; then
    tries="${2}"
  fi

  [[ "${3:-}" == "--quiet" ]] && quiet=1

  while ((count < tries)); do
    mountpoint -q "$mount_point" && {
      ((quiet == 0)) && log_error "mountpount available: ${1}"
      return 0
    }
    sleep .5
    ((count += 1))
  done

  ((quiet == 0)) && log_error "mountpount not available: ${1}"
  return 1
}

#############################################################################
# Mounts using raw passthrough mount arguments.
# If --targetpath is provided, ensures the directory exists.
# Args:
#   --targetpath | -tp : target mount path metadata (optional)
#   {*} mount command args passed directly to mount
#############################################################################
mount_common_mount_server() {
  local mount_point=
  local -a mount_args=()
  local -i retval=0

  while (($# > 0)); do
    case "$1" in
    --targetpath=* | -tp=*)
      mount_point="${1#*=}"
      ;;
    --targetpath | -tp)
      shift
      mount_point="${1:-}"
      ;;
    *)
      mount_args+=("$1")
      ;;
    esac
    shift
  done

  ((${#mount_args[@]} > 0)) || {
    log_error "ERROR: mount args missing"
    return 1
  }

  if [[ -n "${mount_point}" ]] && [[ "${mount_point}" == /* ]] && [[ ! -d "${mount_point}" ]]; then
    mkdir -p "${mount_point}" || {
      log_error "Unable to create mountpount folder"
      return 1
    }
  fi

  mount "${mount_args[@]}" || {
    retval=$?
    log_error "ERROR: mount returned exit code $retval"
    return $retval
  }

  return 0
}

##############################################
# Reads mountpoints.conf and mounts each saved entry.
# Expected config format per line:
#   <mount args> <target path>
# Blank and comment lines are skipped.
mount_common_mount_all() {
  local line target
  local -a mount_args=()
  local -i target_index=0

  if [[ ! -f ${mountshares_conf_file} ]]; then
    log "missing mountpoint.conf file"
    return 0
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == [[:blank:]#]* ]] && continue

    read -r -a mount_args <<< "$line"
    ((${#mount_args[@]} > 1)) || continue

    target_index=$((${#mount_args[@]} - 1))
    target="${mount_args[$target_index]}"

    [[ "$target" == /* ]] || continue
    (mount_common_mount_server --targetpath "$target" "${mount_args[@]}" &) || true
  done <"${mountshares_conf_file}"

  return 0
}

#############################################################################
# Mounts using passthrough args and stores settings to mountpoints.conf.
# Stores entries in this format:
#   <mount args> <target path>
# Args:
#   --targetpath | -tp : target mount path metadata (required)
#   -- : optional separator before passthrough mount args
#   {*} all other args are passed through to mount
#############################################################################
mount_common_mount() {
  local mount_target=
  local mount_settings=
  local -a mount_args=()
  local -a persisted_args=()
  local arg

  while (($# > 0)); do
    case "$1" in
    --targetpath=* | -tp=*)
      mount_target="${1#*=}"
      ;;
    --targetpath | -tp)
      shift
      mount_target="${1:-}"
      ;;
    --)
      shift
      mount_args=("$@")
      break
      ;;
    *)
      mount_args+=("$1")
      ;;
    esac
    shift
  done

  ((${#mount_args[@]} > 0)) || {
    log_error "ERROR: mount args missing"
    return 1
  }

  [[ -n "${mount_target}" ]] || {
    log_error "ERROR: target path is required: --targetpath|-tp"
    return 1
  }

  mount_common_mount_server --targetpath "${mount_target}" "${mount_args[@]}" || return 1

  for arg in "${mount_args[@]}"; do
    [[ "${arg}" == "${mount_target}" ]] && continue
    persisted_args+=("${arg}")
  done
  persisted_args+=("${mount_target}")

  mount_settings="${persisted_args[*]}"
  __update_mount_settings "${mount_target}" "${mount_settings}"
}

# exposed so can override for mocking
# overriding read callin bashdb fails
__mount_common___read() {
  # shellcheck disable=SC2162
  read "$@"
}

mount_common_mountprompt() {
  local source target username password options type

  __mount_common___read -r -p "Enter the mount type cifs|nfs [default cifs]: " type
  __mount_common___read -r -p "Enter server ip/host address and path: " source
  [[ -z "${source}" ]] && { echo "cancelled"; return 1; }
  __mount_common___read -r -p "Enter local mount point folder: [default folder /data/mnt/]: " target
  [[ -z "${target}" ]] && { echo "cancelled"; return 1; }
  __mount_common___read -r -p "Enter username for share: " username
  __mount_common___read -r -s -p "Enter password for share: " password
  echo
  __mount_common___read -r -p "Enter extra options [defaults exec,mfsymlinks ('none'; no options)]: " options

  type="${type:-cifs}"
  options="${options:-exec,mfsymlinks}"
  [[ "${source:0:2}" != "//" ]] && source="//${source}"
  [[ "${target:0:1}" != "/" ]] && target="/data/mnt/$target"
  [[ "${options}" == "none" ]] && options=""
  [[ -n "${options}" ]] && options=",${options}"

  # shellcheck disable=SC2140
  mount_common_mount --targetpath="$target" -t "${type}" -o "username=${username},password=${password}${options}" "${source}" "${target}"
  echo "done"

}


# Removes a saved mount entry by target path from mountpoints.conf.
# Args:
#   {1} mount target path
mount_common_remove_mount() {
  [[ -f "${mountshares_conf_file}" ]] || return 0

  local mount_target="${1}"
  local line
  local temp_file

  temp_file="$(mktemp)"
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line##* }" == "${mount_target}" ]] && continue
    echo "${line}" >> "${temp_file}"
  done < "${mountshares_conf_file}"

  mv "${temp_file}" "${mountshares_conf_file}"

  return 0
}

case "${1:-}" in
  mount_server)
    shift
    mount_common_mount_server "$@"
    ;;
  mount)
    shift
    mount_common_mount "$@"
    ;;
  mount-all)
    shift
    mount_common_mount_all
    ;;
  waitformount)
    shift
    mount_common_wait_on_mount_point "$@"
    ;;
  *)
    shift
    mount_common_mountprompt
    ;;
esac
{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
 
    "configurations": [
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash Dbg: (active file)",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "terminalKind": "integrated",
            
            "args": []
        },
 
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash Dbg (defined script)",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/utils/opkg-helpers/tests/serial-device-installer-tests",
            "terminalKind": "integrated",
            "args": []
        },
        {
            "name": "Python Debugger: dbus-ne-shunt",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-ne-shunt/src/opt/victronenergy/dbus-ne-shunt/main.py",
            "console": "integratedTerminal",
            "args": ["--serial", "/dev/ttyACM0", "--debug"]
        },
        {
            "name": "Python Debugger: opkg-make-index",
            "type": "debugpy",
            "request": "launch",
        
            "program": "/usr/local/bin/opkg-make-index",
            "console": "integratedTerminal",
            "args": ["-p","Packages", "/home/admin/dev/projects/venus-os/feed"]
        }
    ]
}
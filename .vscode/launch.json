{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
 
    "configurations": [
        {
            "type": "bashdb",
            "presentation": { "group": "bash" },
            "request": "launch",
            "name": "Bash - active file",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "terminalKind": "integrated",
            
            "args": []
        },
 
        {
            "type": "bashdb",
            "presentation": { "group": "bash" },
            "request": "launch",
            "name": "Bash - defined script",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/utils/opkg-helpers/tests/serial-device-installer-tests",
            "terminalKind": "integrated",
            "args": []
        },
        {
            "name": "Python - active file",
            "presentation": { "group": "python"},
            "type": "debugpy",
            "request": "launch",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "dbus-inetbox-async (ttyUSB0)",
            "presentation": { "group": "inetbox" },
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/services/dbus-inetbox/src/opt/victronenergy/dbus-inetbox-async",
            "program": "__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--serial", "/dev/ttyUSB0", "--debug_lin"]
        },
        {
            "name": "dbus-inetbox-orig (ttyUSB0)",
            "presentation": { "group": "inetbox" },
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/services/dbus-inetbox/src/opt/victronenergy/dbus-inetbox-orig",
            "program": "__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--serial", "/dev/ttyUSB0", 
                "--debug_lin"]
        },
        {
            "name": "Inetbox-orig (SIM)",
            "presentation": {"hidden": true},
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/services/dbus-inetbox/src/opt/victronenergy/dbus-inetbox-orig",
            "program": "__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--serial", "/tmp/lin_sim", "--debug_lin"]
        },
        {
            "name": "Inetbox-async (SIM)",
            "presentation": {"hidden": true},
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/services/dbus-inetbox/src/opt/victronenergy/dbus-inetbox-async",
            "program": "__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--serial", "/tmp/lin_sim", "--debug_lin"]
        },
        {
            "name": "LIN Device Player",
            "presentation": {"hidden": true},
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-inetbox/tests/device.py",
            "args": [
                "${workspaceFolder}/services/dbus-inetbox/tests/assets/serial-init-recording.json",
                "--speed",
                "1"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "dbus-ne-shunt",
            "presentation": { "group": "dbus-ne-shunt"},
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-ne-shunt/src/opt/victronenergy/dbus-ne-shunt/main.py",
            "console": "integratedTerminal",
            "args": ["--serial", "/dev/ttyACM0", "--debug"]
        },
    ],
    "compounds": [
        {
            "name": "dbus-inetbox-orig + lin-playback",
            "presentation": { "group": "inetbox" },
            "configurations": [
                "LIN Device Player",
                "Inetbox-orig (SIM)"
            ],
            "stopAll": true
        },
        {
            "name": "dbus-inetbox-async + lin-playback",
            "presentation": { "group": "inetbox" },
            "configurations": [
                "LIN Device Player",
                "Inetbox-async (SIM)"
            ],
            "stopAll": true
        }
    ]
}
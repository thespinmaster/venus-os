{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
 
    "configurations": [
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash Dbg: (active file)",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "terminalKind": "integrated",
            
            "args": []
        },
 
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash Dbg (defined script)",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/utils/opkg-helpers/tests/serial-device-installer-tests",
            "terminalKind": "integrated",
            "args": []
        },
        {
            "name": "Python Debugger: install-helper",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-ne-shunt/src/CONTROL/install-helper",
            "console": "integratedTerminal",
            "args": ["usb-serial-helper.detect_add", 
            "${workspaceFolder}/services/dbus-ne-shunt/serial-starter.rules",
            "dbus-ne-shunt",
            "neshunt", 
            "",
            "1a86:7523"]
        }
    ]
}
{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
 
    "configurations": [
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash Dbg: (active file)",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "terminalKind": "integrated",
            
            "args": []
        },
 
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash Dbg (defined script)",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/utils/opkg-helpers/tests/serial-device-installer-tests",
            "terminalKind": "integrated",
            "args": []
        },
        {
            "name": "Python: dbus-ne-shunt",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-ne-shunt/src/opt/victronenergy/dbus-ne-shunt/main.py",
            "console": "integratedTerminal",
            "args": ["--serial", "/dev/ttyACM0", "--debug"]
        },
        {
            "name": "Python: dbus-inetbox",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-inetbox/src/opt/victronenergy/dbus-inetbox/__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--serial", "/dev/ttyUSB0", "--debug_lin"]
        },
        {
            "name": "Inetbox-orig ttyUSB0",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-inetbox/src/opt/victronenergy/dbus-inetbox-orig/__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--serial", "/dev/ttyUSB0", 
                "--debug_lin"]
        },
        {
            "name": "SIM Inetbox-orig",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-inetbox/src/opt/victronenergy/dbus-inetbox-orig/__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--serial", "/tmp/lin_sim", "--debug_lin"]
        },
        {
            "name": "Python: (active file)",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "LIN Device Simulator",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-inetbox/tests/device.py",
            "args": [
                "${workspaceFolder}/services/dbus-inetbox/tests/assets/serial-init-recording.json",
                "--speed",
                "1"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "LIN Client",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/dbus-inetbox/tests/client.py",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "compounds": [
        {
            "name": "LIN Simulator + Client",
            "configurations": [
                "LIN Device Simulator",
                "LIN Client"
            ],
            "stopAll": true
        },
        {
            "name": "LIN Simulator + inetbox",
            "configurations": [
                "LIN Device Simulator",
                "SIM Inetbox-orig"
            ],
            "stopAll": true
        }
    ]
}
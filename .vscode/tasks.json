{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  //"command": "bash ${workspaceFolder}/tasks/run-tests",
  //"command": "echo hello",
  //"command": "${workspaceFolder}/utils/opkg-manager/tests/serial-device-installer",
  
  "version": "2.0.0",
  
  "tasks": [
    {
      "label": "all tests",
      "type": "shell",
      
      "problemMatcher":[],
      "command": "bash ${workspaceFolder}/tasks/run-tests",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "run bash script",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/run-current-tests",
      "args": ["${workspaceFolder}/utils/opkg-manager/tests/serial-device-installer-tests"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false,
        "preserveTerminalName": false,
        "echo": false
      },
    },
    {
      "label": "build qmlplugin",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin qt6",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["qt6"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin armhf",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["armhf"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin armhf qt6",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["armhf", "qt6"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build all opkg packages",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/make-packages",
      
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "run all venus-os tests",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/run-tests",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "build opkg-manager mount-shares packages",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/make-packages opkg-manager mount-shares",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Restart Venus-GUI Service",
      "type": "shell",
      "command": "svc -t /service/gui",
        "presentation": {
          "reveal": "never",
          "panel": "shared",
          "close": false
        },
      "problemMatcher": []
    },
    {
      "label": "Venus UI Logs",
      "type": "shell",
      "command": "tail -F /var/log/gui/current | cut -c27-",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    }
  ]
}
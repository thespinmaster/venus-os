{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "opkgPackage",
      "type": "promptString",
      "description": "Package to build (leave empty to reuse last; e.g. opkg-manager, mount-shares, themer, or all)",
      "default": ""
    },
    {
      "id": "opkgPromoteFeed",
      "type": "promptString",
      "description": "Feed to promote (leave empty for all; e.g. main or opkg-manager)",
      "default": ""
    }
  ],
  "tasks": [
    {
      "label": "opkg develop build (prompt)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/opkg-develop-build-task",
        "${workspaceFolder}",
        "${input:opkgPackage}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Develop-only build with prompt for package."
    },
    {
      "label": "Promote feed target (blank = all)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/opkg-promote-feed-task",
        "${workspaceFolder}",
        "${input:opkgPromoteFeed}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Promote develop feeds into release feeds."
    },
    {
      "label": "cleanup vscode server installs",
      "type": "shell",
      "command": "${workspaceFolder}/tasks/cleanup-vscode-server.sh",
      //"args": ["--dry-run"],
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always"
      },
      "detail": "Removes all but the latest VS Code server install from ~/.vscode-server/bin (dry run by default). Remove --dry-run to actually delete."
    },
    {
      "label": "all tests",
      "type": "shell",
      "problemMatcher":[],
      "command": "bash ${workspaceFolder}/tasks/run-tests",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      },
      "detail": "Finds and runs tests in all folders." 
    },
    {
      "label": "run bash script",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/run-current-tests",
      "args": ["${workspaceFolder}/utils/opkg-manager/tests/serial-device-installer-tests"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false,
        "preserveTerminalName": false,
        "echo": false
      }
    },
    {
      "label": "build qmlplugin",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin qt6",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["qt6"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin armhf",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["armhf"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin armhf qt6",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["armhf", "qt6"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build all opkg packages",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/make-packages",
      
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "cleanup opkg develop feed",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/make-packages --clean-develop",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Clears the opkg develop feeds folder used by package builds."
    },
    {
      "label": "run all venus-os tests",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/run-tests",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "build opkg-manager",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/make-packages opkg-manager",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "build mount-shares",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/make-packages mount-shares",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "build themer",
      "type": "shell",
      "command": "bash ${workspaceFolder}/tasks/make-packages themer",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Restart Venus-GUI Service",
      "type": "shell",
      "command": "svc -t /service/gui",
        "presentation": {
          "reveal": "never",
          "panel": "shared",
          "close": false
        },
      "problemMatcher": []
    },
    {
      "label": "Venus UI Logs",
      "type": "shell",
      "command": "tail -F /var/log/gui/current | cut -c27-",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "clear": false,
        "close": false
      },
      "problemMatcher": []
    }
    ,
    {
      "label": "Build opkg-manager Blind Install",
      "type": "shell",
      "command": "bash utils/opkg-manager/blind-install/build_tgz",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  //"command": "bash ${workspaceFolder}/tasks/run-tests",
  //"command": "echo hello",
  //"command": "${workspaceFolder}/utils/opkg-manager/tests/serial-device-installer",
  
  "version": "2.0.0",
  
  "tasks": [
    {
      "label": "all tests",
      "type": "shell",
      
      "problemMatcher":[],
      "command": "bash ${workspaceFolder}/tasks/run-tests",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "run bash script",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/run-current-tests",
      "args": ["${workspaceFolder}/utils/opkg-manager/tests/serial-device-installer-tests"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false,
        "preserveTerminalName": false,
        "echo": false
      },
    },
    {
      "label": "build qmlplugin",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin qt6",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["qt6"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin armhf",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["armhf"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "build qmlplugin armhf qt6",
      "type": "shell",
      "problemMatcher":[],
      "command": "${workspaceFolder}/tasks/build-qmlplugin",
      "args": ["armhf", "qt6"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
  ]
}
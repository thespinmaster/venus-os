#!/usr/bin/env bash
set -euo pipefail

##############################################################
# Build the packages_helper C binary for opkg list parsing.
# This replaces the Python helper to improve UI startup speed.
#
# The binary is compiled standalone with no Qt/heavy dependencies.
# Supports: armhf (Raspberry Pi), x86_64 (development/testing)
#
# Args:
#   armhf     - Cross-compile for ARM (Raspberry Pi / Venus OS devices)
#   (default) - Compile for current host architecture
##############################################################

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
bridge_src="$repo_root/addons/opkg-manager/src-external/packages-helper"
output_dir="$repo_root/addons/opkg-manager/src/data/opkg-manager/opkg-bridge"
output_bin="$output_dir/packages_helper"

armhf_build=false

for arg in "$@"; do
    case "$arg" in
        armhf)
            armhf_build=true
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            exit 1
            ;;
    esac
done

cd "$bridge_src" || exit 1
mkdir -p "$output_dir"

if $armhf_build; then
    echo "Building packages_helper for armhf (Raspberry Pi)..."
    arm-linux-gnueabihf-gcc \
        -O2 -Wall -Wextra -o \
        "$output_bin" packages_helper.c
else
    echo "Building packages_helper for native architecture..."
    gcc \
        -O2 -Wall -Wextra -o \
        "$output_bin" packages_helper.c
fi

if [[ -f "$output_bin" ]]; then
    chmod +x "$output_bin"
    echo "✓ packages_helper binary created successfully"
    file "$output_bin"
else
    echo "✗ Failed to create packages_helper binary"
    exit 1
fi

#!/bin/bash
# Record serial initialization by snooping on real connection (no proxy latency)
# Transparent Tee - WORKING

set -e

OUTPUT_FILE="/data/dev/services/dbus-inetbox/tests/assets/serial-init-recording.json"
REAL_PORT="/dev/ttyUSB0"
SNIFFER_PID=""
APP_PID=""

cleanup() {
    echo ""
    echo "Cleaning up..."
    
    if [ -n "$APP_PID" ] && kill -0 "$APP_PID" 2>/dev/null; then
        echo "Stopping app (PID $APP_PID)..."
        kill "$APP_PID" 2>/dev/null || true
        sleep 1
    fi
    
    if [ -n "$SNIFFER_PID" ] && kill -0 "$SNIFFER_PID" 2>/dev/null; then
        echo "Stopping sniffer (PID $SNIFFER_PID)..."
        kill "$SNIFFER_PID" 2>/dev/null || true
    fi
    
    echo "Done"
    exit 0
}

trap cleanup SIGINT SIGTERM EXIT

echo "============================================"
echo "SERIAL RECORDING WITH APP INITIALIZATION"
echo "============================================"
echo ""
echo "Setup:"
echo "  Real device:     $REAL_PORT"
echo "  Recording to:    $OUTPUT_FILE"
echo ""

# Start Python sniffer in background
echo "[1/2] Starting serial sniffer..."
python3 - "$REAL_PORT" "$OUTPUT_FILE" << 'PYTHON_END' &
import sys
import serial
import json
import time

real_port = sys.argv[1]
output_file = sys.argv[2]

ser = serial.Serial(real_port, 9600, timeout=0.01)
start_time = time.time()
chunks = []

print(f"[SNIFFER] Listening on {real_port}...", flush=True)

try:
    while True:
        if ser.in_waiting > 0:
            data = ser.read(ser.in_waiting)
            timestamp = time.time() - start_time
            chunks.append({
                "timestamp": timestamp,
                "direction": "in",
                "data": data.hex()
            })
            print(f"[SNIFFER] {len(data):4d} bytes: {data.hex(' ')}", flush=True)
        time.sleep(0.001)
except KeyboardInterrupt:
    ser.close()
    with open(output_file, 'w') as f:
        json.dump({"chunks": chunks}, f, indent=2)
    print(f"\n[SNIFFER] Saved to {output_file}", flush=True)
    sys.exit(0)
PYTHON_END

SNIFFER_PID=$!
sleep 1

echo "      Sniffer running (PID $SNIFFER_PID)"
echo ""

# Start the app directly on real port (no proxy!)
echo "[2/2] Starting dbus-inetbox app..."
cd /data/dev/services/dbus-inetbox/src/opt/victronenergy/dbus-inetbox-orig
python3 __main__.py --serial "$REAL_PORT" 2>&1 | sed 's/^/[APP] /' &
APP_PID=$!

echo "      App running (PID $APP_PID)"
echo ""
echo "============================================"
echo "RECORDING IN PROGRESS"
echo "============================================"
echo ""
echo "Device initialization is being recorded."
echo "Allow 30-60 seconds for full initialization cycle."
echo ""
echo "Press Ctrl+C to stop recording"
echo ""

# Wait for user interrupt
sleep 999999
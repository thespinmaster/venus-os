#!/usr/bin/env bash
set -euo pipefail

# Build defaults to armhf for Venus OS target compatibility.
# Optional args:
#   native  - build for host architecture instead of armhf
#   armhf   - explicit armhf build (same as default)
#   qt5     - force Qt5
#   qt6     - force Qt6

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
plugin_src="$repo_root/addons/opkg-manager/src-external/qmlplugin"
plugin_build="$plugin_src/build"
plugin_output="$repo_root/addons/opkg-manager/src/opt/victronenergy/gui/qml/OpkgManager"
qt_major="auto"
armhf_build=true

for arg in "$@"; do
	case "$arg" in
		armhf)
			armhf_build=true
			;;
		native)
			armhf_build=false
			;;
		qt6)
			qt_major="6"
			;;
		qt5)
			qt_major="5"
			;;
		*)
			echo "Unknown argument: $arg" >&2
			echo "Valid args: native, armhf, qt5, qt6" >&2
			exit 1
			;;
	esac
done


if $armhf_build; then
	plugin_build="$plugin_src/build-armhf"
	export CC=arm-linux-gnueabihf-gcc
	export CXX=arm-linux-gnueabihf-g++
	export PKG_CONFIG_LIBDIR=/usr/lib/arm-linux-gnueabihf/pkgconfig:/usr/share/pkgconfig
	export PKG_CONFIG_SYSROOT_DIR=/

	cmake_args=(
		-DCMAKE_BUILD_TYPE=Release
		-DCMAKE_SYSTEM_NAME=Linux
		-DCMAKE_SYSTEM_PROCESSOR=arm
		-DCMAKE_SYSROOT=/
		-DCMAKE_FIND_ROOT_PATH=/usr/arm-linux-gnueabihf
		-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY
		-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY
	)
else
	cmake_args=()
fi

if [[ "$qt_major" != "auto" ]]; then
	cmake_args+=("-DQMLPLUGIN_QT_MAJOR=$qt_major")
fi

cmake_args+=("-DQMLPLUGIN_OUTPUT_DIR=$plugin_output")

cmake_bin="${CMAKE_BIN:-}"
if [[ -z "$cmake_bin" ]]; then
	if command -v cmake >/dev/null 2>&1; then
		cmake_bin="$(command -v cmake)"
	elif command -v cmake3 >/dev/null 2>&1; then
		cmake_bin="$(command -v cmake3)"
	else
		echo "Error: CMake was not found on PATH." >&2
		echo "Install CMake or rerun with CMAKE_BIN set to its full path." >&2
		exit 127
	fi
fi

if [[ -f "$plugin_build/CMakeCache.txt" ]]; then
	cached_src="$(grep '^CMAKE_HOME_DIRECTORY:INTERNAL=' "$plugin_build/CMakeCache.txt" | cut -d= -f2- || true)"
	if [[ -n "$cached_src" && "$cached_src" != "$plugin_src" ]]; then
		echo "Resetting qmlplugin build cache due to source path change"
		rm -rf "$plugin_build"
	fi
fi

mkdir -p "$plugin_build"
mkdir -p "$plugin_output"
"$cmake_bin" -S "$plugin_src" -B "$plugin_build" "${cmake_args[@]}"
"$cmake_bin" --build "$plugin_build"

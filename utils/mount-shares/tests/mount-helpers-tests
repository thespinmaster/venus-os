  mount_common_mount_server "cifs" "$(stage_get_user_name)" "$(stage_get_password)" \
              "$(stage_get_server_ip_path)" "$(stage_get_mount_point_dir)" "" 3>&1 2>&1
  exitcode=$?
  assert_exitcode $exitcode "--This should succeed before doing any validation tests below"

  (( exitcode==0 )) || return
  for src in "${invalid_cifs_ips[@]}"; do
    stdout=$(mount_common_mount_server "cifs" "$(stage_get_user_name)" "$(stage_get_password)" \
                "${src}" "$(stage_get_mount_point_dir)" "" 2>&1)
    exitcode=$?
    assert_eq 1 $exitcode "${src} should be invalid"
    if ((exitcode==0)) && [[ ! "$stdout" == "ERROR: host path is invalid" ]] &&
       [[ ! "$stdout" == "ERROR: host name or ip address is invalid" ]]; then
       assert_result false "Invalid error returned: $stdout"
    fi

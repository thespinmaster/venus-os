test_mount_all_succeeds_calls_mount_correctly() {
 
  # Arrange

  #store the results in a test.log file as mount_common_mount_server is called in the background
  local test_log_file="${output_dir}/test.log"
  rm -f "$test_log_file"

  mountpoint() { return 1; }
  __mount_common_is_server_up() { return 0; } # error
  # shellcheck disable=SC2145
  mount() { echo "mount called:$@" >> "$test_log_file"; return 0; }

  local mount host bad_host="1.1.2/downloads" 
  local index=1
  for opt in "Opt1=a" "Opt2=b" "Opt3=b" "Opt4=e"; do
    host=$(stage_get_server_ip_path)
    [[ "$opt" == "Opt3=b" ]] && host="$bad_host"
    mount="test_${index}|cifs|$(stage_get_user_name)|$(stage_get_password)|${host}|$(stage_get_mount_point_dir)|$opt"
    printf '%s\n' "${mount}" >> "${mountpoint_conf_file}"
    ((index+=1))
  done
 
  local mount_count
  local expected_count_of_mounts=3; #as 1 of the 4 is bad

  # Act
  mount_common_mount_all 2>/dev/null
  sleep 1 # need to sleep as the mount_common_mount_server calls are executed in the background 

  # Assert
  assert_exitcode 0
  assert_file_exists "$test_log_file"

  mount_count="$(wc -l <"$test_log_file")"
  assert_eq "${expected_count_of_mounts}" "$mount_count"

  for opt in "Opt1=a" "Opt2=b" "Opt3=b" "Opt4=e"; do
    if [[ "$opt" == "Opt3=b" ]]; then
      assert_file_not_contain "$test_log_file" "$opt"
    else
      assert_file_contains "$test_log_file" "$opt"
    fi
  done
}
 

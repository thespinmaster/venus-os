          mount_helpers_mount_cifs --username="$(stage_get_user_name)" --password="$(stage_get_password)" \
          --source="$(stage_get_server_ip_path)" --target="$(stage_get_mount_point_dir)" \
          3>&1 2>/dev/null)
 
  # Assert

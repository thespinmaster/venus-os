test_mount_server_fails_when_host_has_invalid_args() {

  # Arrange
 
  mountpoint() { return 1; }
  __mount_helpers_is_server_up() { return 0; } # error
  mount() { return 0; }
  
  local stdout
  local mount_point_path; mount_point_path="$(stage_get_mount_point_dir)"
  local -i exitcode
  
  assert_dir_not_exist "$mount_point_path"
    
  invalid_cifs_hosts=(
    "//"                       # empty UNC
    "//server"                 # missing share
    "//server/"                # empty share
    "///server/share"          # too many leading slashes
    "/server/share"            # missing leading slash
    "\\\\server\\share"        # backslashes instead of slashes
    "//server//share"          # empty path element
    "//server///share"
    "//server:/share"          # illegal colon
    "//server/share/subdir"    # subdir not allowed in CIFS source
    "//server/."               # invalid share name
    "//server/.."              # invalid share name
    "//server/*"               # illegal character
    "//server/?"               # illegal character
  )

  # Act
 
  #Test everything works first
  mount_helpers_mount_server "cifs" "$(stage_get_user_name)" "$(stage_get_password)" \
              "$(stage_get_server_ip_path)" "$(stage_get_mount_point_dir)" "" 3>&1 2>&1
  exitcode=$?
  assert_exitcode $exitcode "--This should succeed before doing any validation tests below"

  (( exitcode==0 )) || return
  for src in "${invalid_cifs_hosts[@]}"; do
    stdout=$(mount_helpers_mount_server "cifs" "$(stage_get_user_name)" "$(stage_get_password)" \
                "${src}" "$(stage_get_mount_point_dir)" "" 2>&1)
 
    assert_exitcode 1 "${src} should be invalid"
    if [[ ! "$stdout" == "ERROR: host path is invalid" ]] &&
       [[ ! "$stdout" == "ERROR: host name or ip address is invalid" ]]; then
       assert_result false "Invalid error returned"
    fi
  done
  
}
 

#!/bin/bash

# exit on error
set -e

PACKAGENAME=$(basename "${0%.*}") #get file name without path
NEW_FILE=/lib/libcap-ng.so.0.0.0

if [[ -f $NEW_FILE.bak ]]; then
  echo "restoring $NEW_FILE.bak to $NEW_FILE"
  mv $NEW_FILE.bak $NEW_FILE
fi

source /data/opkg-helpers/opkg-common.sh

SCRIPT="
# ${PACKAGENAME} (do not edit)
/data/mount-nfs-cifs/ensure_mountpoints.sh
"
remove_script_from_rc_local "${SCRIPT}"

echo "successfully removed ${PACKAGENAME}"


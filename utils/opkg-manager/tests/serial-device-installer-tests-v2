  assert_eq 0 "$count_of"
  
  count_of=$(grep -o "$serial_starter_rule_code" "${SERIAL_STARTER_RULES_FILE}" | wc -l)
  assert_eq 0 "$count_of"

  assert_empty $stderr
 } 
 
 

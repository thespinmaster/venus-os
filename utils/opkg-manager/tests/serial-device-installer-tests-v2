test_remove_succeeds_when_SERIAL_STARTER_RULE_set() {

   # Arrange
  stage_default_vars
  SERIAL_STARTER_RULES_FILE="${SERIAL_STARTER_RULES_FILE}.filled"
  stage_files "${SERIAL_STARTER_RULES_FILE##*/}"
  local serial_starter_rule_header serial_starter_rule_code

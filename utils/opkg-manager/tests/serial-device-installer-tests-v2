test_install_succeeds_when_SERIAL_STARTER_RULES_TEXT_MATCH_is_empty_Rule_added_to_end() { 

  stage_default_vars
  stage_files "${SERIAL_STARTER_CONFIG_FILE##*/}" "${SERIAL_STARTER_RULES_FILE##*/}"
  TTY=ttyUSB0
  SERIAL_STARTER_RULES_TEXT_MATCH= # set to empty (rule will be added to the end)

  local stderr=

  # Act
  stderr="$(serial_device_installer_install 2>&1)"
 
  #Assert
  assert_exitcode 0
  local comment_added="# \"dummy_service\""
  local line_no=;line_no=$(awk "/${comment_added}/{ print NR; exit }" "$SERIAL_STARTER_RULES_FILE")
  assert_eq 23 "${line_no}"
  
  ((line_no++))

  local rule=;rule="$(sed ${line_no}!d "$SERIAL_STARTER_RULES_FILE")"
  expected='ACTION=="add", ENV{ID_SERIAL}=="FTDI_FT232R_USB_UART_B0001AJ7", ENV{ID_SERIAL_SHORT}=="B0001AJ7", ENV{VE_SERVICE}="ve_dummy_service"'
  assert_eq "${expected}" "${rule}"

} 


clear_output() {
  mkdir -p "$output_dir"
  rm -fr "${output_dir:?}/"*
  #cp -r "${ASSETS_DIR}/"* "$OUTPUT_DIR/"
}

stage_service_paths() {
  output_path_len="${#output_dir}"
  start_path="${SERIAL_STARTER_START_SERVICE_PATH:0:$output_path_len}"

  # ensure the path is inside the output folder
  [[ "$start_path" != "${output_dir}" ]] && {
    echo "stage_service_paths:Error invalid SERIAL_STARTER_START_SERVICE_PATH path!"; exit 1; }
  
  mkdir -p "$SERIAL_STARTER_START_SERVICE_PATH"

  start_path="${SERVICE_PATH:0:$output_path_len}"
  [[ "$start_path" != "${output_dir}" ]] && {
    echo "stage_service_paths:Error invalid SERVICE_PATH path!"; exit 1; }
  
  mkdir -p "$SERVICE_PATH"
}

stage_set_SERIAL_STARTER_RULE_for_filled() {
  local -n _header="${1:-}"; _header='# "dummy_service"'
  local -n _rule="${2:-}"; _rule='ACTION=="add", ENV{ID_SERIAL}=="FTDI_FT232R_USB_UART_B0001AJ7", ENV{ID_SERIAL_SHORT}=="B0001AJ7", ENV{VE_SERVICE}="ve_dummy_service"'
  SERIAL_STARTER_RULE="$_header"$'\n'"$_rule"
}

stage_reset_vars() {
  local -a vars=()
  # shellcheck disable=SC2199
  if [[ -n "$@" ]]; then
    vars=(SERVICE_NAME SERVICE_MAPPING_NAME TTY SERVICE_PATH SERIAL_STARTER_START_SERVICE_PATH
          SERIAL_STARTER_RULES_FILE SERIAL_STARTER_CONFIG_FILE SERIAL_STARTER_RULES_TEXT_MATCH
          UDEVADM_PROPS USE_UDEVADM_MONITOR USB_TIMEOUT)
  else
    vars=("$@")
  fi
 
  for var in "${vars[@]}"; do unset -v "$var" ;done; 
}

# shellcheck disable=SC2120
stage_default_vars() {
  SERVICE_NAME="${1:-dummy_service}"
  SERVICE_MAPPING_NAME="ve_${SERVICE_NAME}"
  TTY=
  SERVICE_PATH="$output_dir/service"
  SERIAL_STARTER_START_SERVICE_PATH="$output_dir/serial-starter"
  SERIAL_STARTER_RULE=
  SERIAL_STARTER_RULES_FILE="$output_dir/serial-starter.rules"
  SERIAL_STARTER_CONFIG_FILE="$output_dir/serial-starter.conf"
  SERIAL_STARTER_RULES_TEXT_MATCH='RUN+="/opt/victronenergy/serial-starter/cleanup.sh %k"'
  UDEVADM_PROPS=ID_BUS,ID_VENDOR,ID_MODEL,ID_SERIAL
  USE_UDEVADM_MONITOR="1"
  USB_TIMEOUT=3
}

# shellcheck disable=SC2120
stage_files() {
  
  local args=("$@")
  (( ${#args[@]} == 0 )) && {
    args=("serial-device-installer.test1.conf" "serial-device-installer.test1.conf.schema")
  }

  clear_output
 
  for file in "${args[@]}"; do
    [ -f "${assets_dir}/${file}" ] || { 
      assert_file_exists "$file" "stage_file not found" >&2; return 1; }
    cp "${assets_dir}/${file}" "${output_dir}/${file}" 
  done

  return 0
}  


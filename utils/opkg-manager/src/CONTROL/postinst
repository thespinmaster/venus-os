#!/bin/bash
 
declare package_name="opkg-manager"

declare rc_local_script="
# ${package_name} (do not edit)
${VE_ROOT_DIR:-}/data/${package_name}/rc.local.d/startup
"

. "${VE_ROOT_DIR:-}/data/${package_name}/opkg-common"

opkg_common_add_script_to_rc_local "${rc_local_script}"
 
opkg_common_register_package "${package_name}"

opkg_common_ensure_feeds

opkg_common_update_packages

echo "successfully installed ${package_name}"


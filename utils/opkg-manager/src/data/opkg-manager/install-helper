#!/bin/bash


__appendDataDir() {
	local VENUS_DATA_DIR="/data/dev/utils/opkg-manager/src"; [ -d $VENUS_DATA_DIR ] || VENUS_DATA_DIR=
  local file="${1}"
	local -n _out_dir=${2}
	_out_dir="${VENUS_DATA_DIR:-}/data/${file}"
}

# List of special pages (without .qml)
__load_source_file() {
		# may require symlink to /data/dev 
  local source_file=
	__appendDataDir "${1}" source_file
	[[ -f ${source_file} ]] || { echo "ERROR: source file does not exist:${source_file}" >&2; exit 1; }

	# shellcheck disable=SC1090
	. "${source_file}"
	
}

__add_remove_dbus_settings() {
	
	local -i remove=${1:-0} # 0 adds; 1 removes
	__load_source_file "dbus-common"

	local settings='
		Theme:s:0:0:"dark"
		TextColor:s:0:0:"#ffffff"
		BackgroundColor:s:0:0:"#1f1f1f"
		BackgroundColor2:s:0:0:"#313131"
		IconSuffixNormal:s:0:0:"active"
		IconSuffixSelected:s:0:0:"active"
		BorderColor:s:0:0:"#3c3c3c"
		Enabled:i:0:1:1
	'
 
	dbus_common_add_remove_debus_settings $remove "Themer" "$settings"
 
}
 
install_helper_post_install() {

  (
    local rc_local_script="
    # opkg-manager (do not edit)
    ${VE_ROOT_DIR:-}/data/opkg-manager/rc.local.d/startup
    "

    __load_source_file "opkg-common"
  
    opkg_common_add_script_to_rc_local "${rc_local_script}"
    
    opkg_common_register_package "opkg-manager"

    opkg_common_ensure_feeds

    opkg_common_update_packages

  )

  (
    __load_source_file "file-patcher"
    local full_path=
    __appendDataDir "opkg-manager.patch" ffull_pathe
    file_patcher_apply_patch $full_path
  )
}

install_helper_pre_remove() {
 
  (
  local rc_local_script="
# ${package_name} (do not edit)
${VE_ROOT_DIR:-}/data/opkg-manager/rc.local.d/startup
"

    . "${VE_ROOT_DIR:-}/data/${package_name}/opkg-common"

    opkg_common_remove_script_from_rc_local "${rc_local_script}"

    opkg_common_unregister_package "${package_name}"

    opkg_common_remove_feed_symlink
  )
}
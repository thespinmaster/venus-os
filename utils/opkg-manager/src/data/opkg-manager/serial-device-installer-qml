sdi_get_usb_port() {
  local fifo
  local line
  local path
  local -n _tty="$1"
  local UDEV_PID=""
  local FIFO_PATH=""
 
_sdi_cleanup_udevadm() {
  if [[ -n "$UDEV_PID" ]]; then
    kill -2 "$UDEV_PID" 2>/dev/null
    #wait "$UDEV_PID" 2>/dev/null
    UDEV_PID=""
  fi
  if [[ -n "$FIFO_PATH" ]]; then
    rm -f "$FIFO_PATH"
    FIFO_PATH=""
  fi
}

  fifo=$(mktemp -u)
  mkfifo "$fifo"
  FIFO_PATH="$fifo"
  
  trap '_sdi_cleanup_udevadm' SIGTERM SIGINT 

  udevadm monitor --subsystem-match=tty -u > "$fifo" &
 
  UDEV_PID=$!
  # ---
  # NOTE: Bash signal handling (traps) only occurs between commands.
  # If we use a blocking read, Bash cannot process signals (like SIGTERM)
  # and the process will not exit until the read returns.
  # By using a timed read (-t 1), we allow Bash to periodically check for signals
  # and run the trap handler, so the process can be stopped gracefully.
  # The loop only exits if the FIFO is removed or closed.
  # ---

  while true; do
    if read -r -t 0.5 line < "$fifo"; then
      if [[ "$line" =~ ^UDEV\ .*[\[][0-9]*\.[0-9]*[]]\ add\  ]]; then
        # Extract the path
        path=${line#*add      }
        path=${path%% *}
        # Extract tty device name
        _tty=${path##*/}
        kill -2 "$UDEV_PID"
        wait "$UDEV_PID" 2>/dev/null
        UDEV_PID=""
        break
      fi
    elif [[ ! -p "$fifo" ]]; then
        # read timed out or FIFO closed
        break
    fi
  done < "$fifo"
 
  # Remove FIFO (cleanup will also do this, but for safety)
  rm -f "$fifo"
  FIFO_PATH=""
  
}

# get_usb_props <tty> <array_var_name> <property list>
# Usage: get_usb_props ttyUSB0 usb_props PROPS[@]
sdi_get_usb_props() {
  local tty="$1"
  local -n out_assoc="$2"
  local prop_list_name="$3"
  local -n prop_list="$prop_list_name"
  local prop val found_name
  local udevadm_out
 
  declare -A assoc=()
  udevadm_out=$(udevadm info --query=property --name="/dev/$tty" 2>/dev/null)

  for prop in "${prop_list[@]}"; do
    found_name="ID_USB_${prop}"
    val=$(echo "$udevadm_out" | grep -m1 "^${found_name}=" | cut -d= -f2-)
    if [ -z "$val" ]; then
      found_name="ID_${prop}"
      val=$(echo "$udevadm_out" | grep -m1 "^${found_name}=" | cut -d= -f2-)
    fi
    assoc["$found_name"]="$val"
  done
  out_assoc=()
  for k in "${!assoc[@]}"; do
    out_assoc["$k"]="${assoc[$k]}"
  done
}

# _json_escape <string> <out_var>
# Escapes a string for safe JSON encoding and sets the result in the named variable (byref using local -n)
_sdi_json_escape() {
  local -n __out="$1"
  __out="${__out//\\/\\\\}"
  __out="${__out//\"/\\\"}"
  __out="${__out//$'\n'/\\n}"
  __out="${__out//$'\r'/\\r}"
  __out="${__out//$'\t'/\\t}"
}

# array_to_json_object <assoc_array>
# Usage: array_to_json_object usb_props
_sdi_array_to_json_object() {
  local -n assoc="$1"
  local json="{"
  local -i first=1
  local v_escaped=

  for k in "${!assoc[@]}"; do
    [[ $first -eq 0 ]] && json+="," 
    v_escaped="${assoc[$k]}"
    _sdi_json_escape v_escaped
    json+="\"$k\":\"$v_escaped\""
    first=0
  done
  json+="}"
  echo "$json"
}


# get_tty_process <tty>
# Usage: get_tty_process ttyUSB0
sdi_get_tty_process() {
  local tty="$1"
  local fuser_path="/dev/$tty"
  local first_output=""
  local current_output=""
  local i
  local pid
  local -n out_proc_name

  # Validate argument
  [[ -z "$tty" ]] && { echo ""; return 0; }
 
  # Poll fuser 7 times at 0.5s intervals (3 seconds)
  for ((i=1; i<=7; i++)); do
    current_output=$(fuser "$fuser_path" 2>/dev/null | tr -s ' ')
    if [[ $i -eq 1 ]]; then
      first_output="$current_output"
    else
      [[ "$current_output" != "$first_output" ]] && { echo ""; return 0; }
    fi
    sleep 0.5
  done

  # If output is empty, return empty string
  [[ -z "$first_output" ]] && { echo ""; return 0; }
 
  # Extract last PID from output
  # fuser output: /dev/pts/1: 1381 1586
  # We want the last number (PID)
  pid="${first_output##* }"
  [[ -z "$pid" ]] && { echo ""; return 0; }

  # Get process name
  out_proc_name=$(ps -p "$pid" -o comm= 2>/dev/null | tr -d ' ')
}
 
 

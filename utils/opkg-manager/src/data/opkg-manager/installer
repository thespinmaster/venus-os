#!/bin/bash

RC_LOCAL_SCRIPT="
# opkg-manager (do not edit)
/data/opkg-manager/rc.local.d/startup
"

DBUS_SETTINGS="
    {'path':'/Settings/OpkgManager/CustomMenus/PageSettings/OpkgPageSettingsSubMenu'}
		{'path':'/Settings/OpkgManager/CustomMenus/PageSettingsDisplay/OpkgPageSettingsDisplaySubMenu'}
"

if [[ "$1" == "dev-install" ]]; then
  VE_ROOT_DIR=/data/dev/utils/opkg-manager/src
fi

# shellcheck disable=SC1091
source "${VE_ROOT_DIR:-}/data/opkg-manager/install-helper"

if [[ "$1" == "install" || "$1" == "post-install" || "$1" == "dev-install" ]]; then
	install_helper_post_install

  opkg_common_remove_feed_symlink

  opkg_common_ensure_feeds
  
  echo "please wait, updating packages..."
  opkg_common_update_packages
  echo "done"

elif [[ "$1" == "remove" || "$1" == "post-remove" ]]; then

	install_helper_pre_remove

  opkg_common_remove_feed_symlink

  opkg_common_update_packages
  echo "done"
fi

# install_helper_finished

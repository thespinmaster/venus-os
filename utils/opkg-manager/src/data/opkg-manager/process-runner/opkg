#!/bin/bash

# Moved from opkg-common for QML ProcessRunner usage

set -o nounset

declare __this_path;__this_path=$(dirname "${BASH_SOURCE[0]}")

. "$__this_path/../opkg-common"
 
declare OPKG_PACKAGES_JSON_CACHE_FILE="/tmp/opkg-common-list-packages.json"
declare OPKG_FEEDS_JSON_CACHE_FILE="/tmp/opkg-common-feeds.json"
 
opkg_get_feeds() {
  
	local feeds_file="${OPKG_FEED_CONFIG_FILE}"
	local cache_file="${OPKG_FEEDS_JSON_CACHE_FILE}"
	local feeds_mtime=0
	local cache_mtime=0

  # note use stat -L so it follows symlinks for getting the time

	if [[ -f "$feeds_file" ]]; then
		feeds_mtime=$(stat -L -c %Y "$feeds_file" 2>/dev/null || echo 0)
	fi
	if [[ -f "$cache_file" ]]; then
		cache_mtime=$(stat -L -c %Y "$cache_file" 2>/dev/null || echo 0)
	fi

	if [[ -f "$cache_file" && $cache_mtime -ge $feeds_mtime ]]; then
		echo "$cache_file"
		return 0
	fi
  echo "Feeds" >&2

	local first=1
	printf '[' > "$cache_file"
	if [[ -f "$feeds_file" ]]; then
		while IFS= read -r line; do
			[[ -z "$line" || "$line" == \#* ]] && continue
			[[ "$line" != src/gz* ]] && continue
			set -- "$line"
			local name="$2"
			local url="$3"
			local builtin=false
			if [[ "$name" == "$OPKG_MANAGER_FEED_NAME" ]]; then
				builtin=true
			fi
			if [[ $first -eq 0 ]]; then printf ',' >> "$cache_file"; fi
			printf '{"name":"%s","url":"%s","builtin":%s}' "${name}" "${url}" "$builtin" >> "$cache_file"
			first=0
		done < "$feeds_file"
	fi
	printf ']\n' >> "$cache_file"
	echo "$cache_file"
	return 0
}

opkg_qml_feed_crud() {
	[[ "${2}" == "opkg-manager" ]] && { echo "The opkg-manager cannot be removed/edited"; exit 1; }
	__opkg_qml_feed_crud "$@"
}

__opkg_qml_feed_crud() {
	local mode="${1:-}"
	local feed_name="${2:-}"
	local feed_url="${3:-}"
	local old_feed_name="${4:-}"

  #echo "$mode,$feed_name,$feed_url,$old_feed_name" >&2
  #return 1

	# Validate feed_name
	[[ -z "${feed_name}" ]] && { echo "Invalid name" >&2; return 1; }
	[[ "${feed_name}" =~ [^a-zA-Z0-9_-] ]] && { echo "Invalid name" >&2; return 1; }
	if [[ -n "${old_feed_name}" ]] && [[ "${old_feed_name}" =~ [^a-zA-Z0-9_] ]]; then
		echo "Invalid old name" >&2
		return 1
	fi

  [[ ! -f "${OPKG_FEED_LOCAL_CONFIG_FILE}" ]] &&
    opkg_common_ensure_feeds
 
  local feed_line="src/gz ${feed_name} ${feed_url}"
 
  #for clarity use new var
  local existing_feed_name=$feed_name;
  [[ -n $old_feed_name ]] && existing_feed_name=$old_feed_name
  
  # echo "$mode,$feed_name,$feed_url,$old_feed_name,$existing_feed_name" >&2

  local -i exists=0

  feedNameExists() {
    local retval=0
    local -n _exists=$2
    _exists=0
    grep -qE "^src/gz ${1} " "${OPKG_FEED_LOCAL_CONFIG_FILE}"
    retval=$?; [[ $retval == 0 ]] && _exists=1;
  }

  feedNameExists "${existing_feed_name}" exists

  if [[ $mode == add ]]; then
    ((exists)) && { 
      echo "Feed already exists: $feed_name" >&2; return 1; }
    echo "$feed_line" >> "${OPKG_FEED_LOCAL_CONFIG_FILE}"
    return 0
  fi
 
  ((!exists)) && { 
    echo "Feed not found: $feed_name" >&2; return 1; }

  if [[ $mode == edit ]]; then
    [[ -z "${feed_url}" ]] && { 
      echo "edit: feed url required" >&2; return 1; }
 
    [[ -n $old_feed_name && ! "${feed_name}" == "${old_feed_name}" ]] && {
      # check new feed name does not exist
      feedNameExists "${feed_name}" exists
      ((exists)) && { 
        echo "Feed not found: $feed_name" >&2; return 1; }
    }

  fi

  [[ ${dry_run:-} ]] && { 
    echo "edit feed line-$mode: $feed_line"; 
    return 0; }
 
  tmp_file=$(mktemp)
  local -i found=0
  
  while IFS= read -r line; do
    if [[ "$line" == src/gz\ ${existing_feed_name}\ * ]]; then
      [[ ! $mode == remove ]] && echo "$feed_line"
      found=1
      continue
    fi
    echo "$line"
  done < "${OPKG_FEED_LOCAL_CONFIG_FILE}" > "$tmp_file"
  ((!found)) && {
    # not found add to end
    echo "$feed_line" >> "$tmp_file"
  }

  local -i retval;
  mv "$tmp_file" "${OPKG_FEED_LOCAL_CONFIG_FILE}"
  retval=$?
  ((retval)) &&
    echo "Error writing to ${OPKG_FEED_LOCAL_CONFIG_FILE}" >&2
 
  return $retval

}

# Helper to install a package and log output/errors
opkg_qml_install_package() {
  local package_name="$1"
  shift
  if [[ -z "$package_name" ]]; then
    log_error "install-package: package name not supplied"
    return 1
  fi
  log "Installing $package_name $*"
  opkg install "$package_name" "$@"
  local status=$?
  if [ $status -eq 0 ]; then
    log "install_package: $package_name installed successfully"
  else
    log_error "install_package: failed to install $package_name (status $status)"
  fi
  return $status
}

opkg_qml_upgrade_package() {
  local package_name="$1"
  shift
  if [[ -z "$package_name" ]]; then
    log_error "update-package: package name not supplied"
    return 1
  fi
  log "Upgrade $package_name $*"
  opkg upgrade "$package_name" "$@"
  local status=$?
  if [ $status -eq 0 ]; then
    log "update-package: $package_name updated successfully"
  else
    log_error "update-package: failed to updated $package_name (status $status)"
  fi
  return $status
}

opkg_qml_remove_package() {
 
  local package_name="$1"
  shift
  if [[ -z "$package_name" ]]; then
    log_error "remove-package: package name not supplied"
    return 1
  fi

  # see if the ipk is installed
  # list-installed only returns an exact match
  local installed; installed=$(opkg list-installed "${package_name}")

  # if not installed then exit
  if [[ -z "${installed}" ]]; then
    log "Not Installed ${package_name}, exiting"
    return 0
  fi

  __init_root_fs_for_writing
  __init_opkg
 
  opkg remove "${package_name}"
 
  __restore_previous_fs_access

  log_pop_indent
 
  return 0
}

opkg_qml_list_packages() {
  local -A feeds
  local line
  local feed
  local list_file
  local installed_source=""
  local installed_mode=""
  local tmp_installed_file=""
  local -a list_files=()
  local cache_tmp=""
  local latest_mtime=0
  local mtime=0
  local cache_mtime=0
  local now=0
  local cache_ttl=5
  local -i callUpdate=0
 
  [[ "${1:-}" == "update" ]] && callUpdate=1

  if [[ ! -f "${OPKG_FEED_LOCAL_CONFIG_FILE}" ]]; then
    opkg_common_ensure_feeds
    callUpdate=1
  elif [[ ! -f "${OPKG_FEED_LOCAL_CONFIG_FILE}" ]]; then
    callUpdate=1
  fi
 
  if ((callUpdate==1)); then
    opkg update
  fi

  if [[ -f "${OPKG_FEED_LOCAL_CONFIG_FILE}" ]]; then
    while IFS= read -r line; do
      [[ -z "${line}" || "${line}" == \#* ]] && continue
      [[ "${line}" != src/gz* ]] && continue
      set -- "${line}" # DONT QUOTE set -- splits on whitespace
      [[ -n "${2:-}" ]] && feeds["${2}"]=1
    done < "${OPKG_FEED_LOCAL_CONFIG_FILE}"

    mtime=$(stat -L -c %Y "${OPKG_FEED_LOCAL_CONFIG_FILE}" 2>/dev/null || echo 0)
    (( mtime > latest_mtime )) && latest_mtime=${mtime}
  fi

  if [[ "${#feeds[@]}" -eq 0 ]]; then
    printf '[]' > "${OPKG_PACKAGES_JSON_CACHE_FILE}"
    echo "No feeds" >&2
    echo ""
    return 1
  fi

  for feed in "${!feeds[@]}"; do
    list_file="/usr/lib/opkg/lists/${feed}"
    [[ -f "${list_file}" ]] || continue
    list_files+=("${list_file}")

    mtime=$(stat -L -c %Y "${list_file}" 2>/dev/null || echo 0)
    (( mtime > latest_mtime )) && latest_mtime=${mtime}
  done

  if [[ "${#list_files[@]}" -eq 0 ]]; then
    printf '[]' > "${OPKG_PACKAGES_JSON_CACHE_FILE}"
    echo "No feed files" >&2
    echo ""
    return 1
  fi

  if [[ -f "/usr/lib/opkg/status" ]]; then
    mtime=$(stat -L -c %Y "/usr/lib/opkg/status" 2>/dev/null || echo 0)
    (( mtime > latest_mtime )) && latest_mtime=${mtime}
  fi

  if [[ -f "${OPKG_PACKAGES_JSON_CACHE_FILE}" ]]; then
    cache_mtime=$(stat -L -c %Y "${OPKG_PACKAGES_JSON_CACHE_FILE}" 2>/dev/null || echo 0)
    if (( cache_mtime >= latest_mtime )); then
      echo "${OPKG_PACKAGES_JSON_CACHE_FILE}"
      return 0
    fi
  fi

  if [[ -f "/usr/lib/opkg/status" ]]; then
    installed_source="/usr/lib/opkg/status"
    installed_mode="status"
  else
    if [[ -f "${OPKG_PACKAGES_JSON_CACHE_FILE}" ]]; then
      now=$(date +%s)
      cache_mtime=$(stat -L -c %Y "${OPKG_PACKAGES_JSON_CACHE_FILE}" 2>/dev/null || echo 0)
      if (( now - cache_mtime < cache_ttl )); then
        echo "${OPKG_PACKAGES_JSON_CACHE_FILE}"
        return 0
      fi
    fi

    tmp_installed_file=$(mktemp)
    installed_source="${tmp_installed_file}"
    installed_mode="list"
    opkg list-installed > "${installed_source}"
  fi

  cache_tmp=$(mktemp)
  printf '[' > "${cache_tmp}"
  awk \
    -v installed_file="${installed_source}" \
    -v installed_mode="${installed_mode}" \
    '
    function json_escape(s, i, c, out) {
      gsub(/[\001-\010\013\014\016-\037]/, "", s)
      gsub(/\\/, "\\\\", s)
      gsub(/"/, "\\\"", s)
      gsub(/\t/, "\\t", s)
      gsub(/\r/, "", s)
      gsub(/\n/, "\\n", s)
      return s
    }
    function flush_entry() {
      if (name != "") {
        if (printed) {
          printf ","
        }
        printed = 1
        # Output installedVersion as a string (empty if not installed)
        desc_long_out = (description_long != "" && description_long != description_short) ? description_long : ""
        printf "{\"name\":\"%s\",\"description_short\":\"%s\",\"description_long\":\"%s\",\"version\":\"%s\",\"feed\":\"%s\",\"installedVersion\":\"%s\"}", \
          json_escape(name), \
          json_escape(description_short), \
          json_escape(desc_long_out), \
          json_escape(version), \
          json_escape(feed), \
          ((name in installed) ? json_escape(installed[name]) : "")
      }
      name = ""
      version = ""
      description_short = ""
      description_long = ""
      desc_active = 0
    }
    BEGIN {
      printed = 0
      name = ""
      version = ""
      description_short = ""
      description_long = ""
      desc_active = 0

      if (installed_mode == "status") {
        # Parse /usr/lib/opkg/status stanzas and keep only installed packages
        pkg = ""; ver = ""; status = ""
        while ((getline line < installed_file) > 0) {
          if (line == "") {
            if (pkg != "" && status ~ /(^|[[:space:]])installed([[:space:]]|$)/) {
              installed[pkg] = ver
            }
            pkg = ""; ver = ""; status = ""
            continue
          }

          if (line ~ /^Package: /) {
            pkg = substr(line, 10)
          } else if (line ~ /^Version: / && pkg != "") {
            ver = substr(line, 10)
          } else if (line ~ /^Status: / && pkg != "") {
            status = substr(line, 9)
          }
        }

        if (pkg != "" && status ~ /(^|[[:space:]])installed([[:space:]]|$)/) {
          installed[pkg] = ver
        }

        close(installed_file)
      } else if (installed_mode == "list") {
        # Parse output of opkg list-installed (format: name - version - description)
        while ((getline line < installed_file) > 0) {
          split(line, parts, /[[:space:]]+-[[:space:]]+/)
          if (parts[1] != "" && parts[2] != "") {
            installed[parts[1]] = parts[2]
          }
        }
        close(installed_file)
      }
    }
    FNR == 1 {
      if (NR != 1) {
        flush_entry()
      }
      n = split(FILENAME, path_parts, "/")
      feed = path_parts[n]
    }
    {
      line = $0
      if (line == "") {
        flush_entry()
        next
      }

      if (line ~ /^ / && desc_active == 1) {
        next_line = substr(line, 2)
        if (description_long == "") {
          description_long = next_line
        } else {
          description_long = description_long " " next_line
        }
        next
      }

      if (line ~ /^Package: /) {
        name = substr(line, 10)
        next
      }

      if (line ~ /^Version: /) {
        version = substr(line, 10)
        next
      }

      if (line ~ /^Description: /) {
        description_short = substr(line, 14)
        description_long = ""
        desc_active = 1
        next
      }

      desc_active = 0
    }
    END {
      flush_entry()
    }
    ' "${list_files[@]}" >> "${cache_tmp}"
  printf ']\n' >> "${cache_tmp}"

  mv "${cache_tmp}" "${OPKG_PACKAGES_JSON_CACHE_FILE}"
  echo "${OPKG_PACKAGES_JSON_CACHE_FILE}"

  [[ -n "${tmp_installed_file}" ]] && rm -f "${tmp_installed_file}"
  
  return 0
}

case "${1:-}" in
	get-feeds)

		opkg_get_feeds
		;;
	add-feed)
		opkg_qml_feed_crud "add" "${2:-}" "${3:-}" "${4:-}"
		;;
	edit-feed)
		opkg_qml_feed_crud "edit" "${2:-}" "${3:-}" "${4:-}"
		;;
	remove-feed)
		opkg_qml_feed_crud "remove" "${2:-}" "" ""
		;;

  list-packages)
    opkg_qml_list_packages "${2:-}"
    ;;
  install-package)
    shift
    opkg_qml_install_package "$@"
    ;;
  remove-package)
    shift
    opkg_qml_remove_package "$@"
    ;;
  upgrade-package)
    shift
    opkg_qml_upgrade_package "$@"
    ;;
  *)
    if [[ -n ${1:-} ]]; then
      echo "opkg-qml: incorrect command : ${1}" >&2
    fi
    ;;
esac

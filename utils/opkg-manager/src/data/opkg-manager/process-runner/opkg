#!/bin/bash
# shellcheck disable=SC2317,SC2329  # Don't warn about unreachable commands in this file

set -o nounset

declare __this_path;__this_path=$(dirname "${BASH_SOURCE[0]}")

. "$__this_path/../opkg-common"
 
declare OPKG_PACKAGES_JSON_CACHE_FILE="/tmp/opkg-common-list-packages.json"
declare OPKG_FEEDS_JSON_CACHE_FILE="/tmp/opkg-common-feeds.json"
 
__opkg_qml_feed_crud() {
	local mode="${1:-}"
	local feed_name="${2:-}"
	local feed_url="${3:-}"
	local old_feed_name="${4:-}"
 
	# Validate feed_name
	[[ -z "${feed_name}" ]] && { echo "Invalid name" >&2; return 1; }
	[[ "${feed_name}" =~ [^a-zA-Z0-9_-] ]] && { echo "Invalid name" >&2; return 1; }
	if [[ -n "${old_feed_name}" ]] && [[ "${old_feed_name}" =~ [^a-zA-Z0-9_] ]]; then
		echo "Invalid old name" >&2
		return 1
	fi

  [[ ! -f "${OPKG_FEED_CONFIG_FILE}" ]] &&
    opkg_common_ensure_feed
 
  #for clarity use new var
  local existing_feed_name=$feed_name;
  [[ -n $old_feed_name ]] && existing_feed_name=$old_feed_name
  
  # echo "$mode,$feed_name,$feed_url,$old_feed_name,$existing_feed_name" >&2

  local -i exists=0
  local -a feedNames=()
 
  feedNameExists() {
    local retval=0
    local -n _exists=$2; _exists=0
    grep -qE "^src/gz ${1} " "${OPKG_FEED_CONFIG_FILE}"
    [[ $? == 0 ]] && { _exists=1; return; }
    grep -qE "^src/gz ${1} " "/etc/opkg/venus.conf"
    [[ $? == 0 ]] && _exists=1;
  }

  feedNameExists "${existing_feed_name}" exists
  
  local feed_line="src/gz ${feed_name} ${feed_url}"

  if [[ $mode == add ]]; then
    # if adding and name does not exist; shortcut to just adding feed to the end and exiting
    ((exists)) && { 
      echo "Feed already exists: $feed_name" >&2; return 1; }
    echo "$feed_line" >> "${OPKG_FEED_CONFIG_FILE}"
    return 0
  fi
 
  ((!exists)) && { echo "Feed not found: $feed_name" >&2; return 1; }
  
  if [[ $mode == edit ]]; then
    # if an edit make sure new name does not already exist if name given is diff from old
    [[ -z "${feed_url}" ]] && { echo "edit: feed url required" >&2; return 1; }
 
    [[ -n $old_feed_name && ! "${feed_name}" == "${old_feed_name}" ]] && {
      # make sure the new feed name does not exist if name is different from existing
      feedNameExists "${feed_name}" exists
      ((exists)) && { echo "Invalid name; feed name already exists: $feed_name" >&2; return 1; }
    }

  fi
 
  tmp_file=$(mktemp)
  local -i found=0
  
  # create new contents
  # skip line if removing, else if edit find line and replace
  while IFS= read -r line; do
    if [[ "$line" == src/gz\ ${existing_feed_name}\ * ]]; then
      [[ ! "$mode" == remove ]] && echo "$feed_line"
      found=1
      continue
    fi
    echo "$line"
  done < "${OPKG_FEED_CONFIG_FILE}" > "$tmp_file"

  ((!found)) && echo "$feed_line" >> "$tmp_file"  # add to end if not found

  # make sure we update the real file and not the symlink
  local feedfile="${OPKG_FEED_CONFIG_FILE}"
  [[ -L "${feedfile}" ]] && feedfile="$(readlink "${OPKG_FEED_CONFIG_FILE}")"

  mv "$tmp_file" "${feedfile}" || { echo "Error writing to ${feedfile}" >&2; return 1; }
 
  return 0

}

__validate_package_name() {
  if [[ -z "$1" ]]; then
    log_error "opkg_qml_package_commond: package name not supplied"
    return 1
  fi
  return 0
}
 
__opkg_qml_package_command() {
   
  local command="${1}"
  local package_name="${2}"

  shift
 
  __init_root_fs_for_writing
 
  opkg "$command" "${package_name}"
  local status=$?

  __restore_previous_fs_access
 
  if [[ $status == 0 ]]; then
    log "$package_name $command succeded"
  else
    log "$package_name $command failed (status $status)"
  fi

  return status
}

opkg_qml_get_feed_type() {

  local feedfile="${OPKG_FEED_CONFIG_FILE}"
  local feedType=
  [[ -L "${feedfile}" ]] && feedfile="$(readlink "${OPKG_FEED_CONFIG_FILE}")"
  if [[ -f "${feedfile}" ]]; then
    feedType="${feedfile##*-}"    # remove everything up to last '-'
    feedType="${feedType%.conf}"  # remove suffix
  fi
  # default to release, as opkg_common_ensure_feed will take care of missing conf.
  echo "${feedType:-release}" 
}

# Helper to install a package and log output/errors
opkg_qml_install_package() {
  local package_name="$1"
  
  __validate_package_name "${package_name}" || return

  log "Installing $package_name $*"
  __opkg_qml_package_command install "$package_name" "$@"

}

opkg_qml_upgrade_package() {
  local package_name="$1"
 
  __validate_package_name "${package_name}" || return
  
  log "Upgrading $package_name $*"
  __opkg_qml_package_command upgrade "$package_name" "$@"
 
}

opkg_qml_remove_package() {
  local package_name="$1"

  __validate_package_name "${package_name}" || return

  if [[ -z $(opkg list-installed "${package_name}") ]]; then
    log "Not Installed ${package_name}, exiting"
    return 0
  fi
  
  log "Removing $package_name $*"
  __opkg_qml_package_command remove "${package_name}"
  
}

opkg_create_json_feeds_list() {
  
	local feeds_file="${OPKG_FEED_CONFIG_FILE}"
	local cache_file="${OPKG_FEEDS_JSON_CACHE_FILE}"
	local feeds_mtime=0 cache_mtime=0
 
  # note use stat -L so it follows symlinks for getting the time

	[[ -f "$feeds_file" ]] && feeds_mtime=$(stat -L -c %Y "$feeds_file" 2>/dev/null || echo 0)
	[[ -f "$cache_file" ]] && cache_mtime=$(stat -L -c %Y "$cache_file" 2>/dev/null || echo 0)
	[[ -f "$cache_file" && $cache_mtime -ge $feeds_mtime ]] && { echo "$cache_file"; return 0; } # cache still valid 
 
	local first=1
	printf '[' > "$cache_file"
	if [[ -f "$feeds_file" ]]; then

		while IFS= read -r line; do
			[[ -z "$line" || "$line" == \#* ]] && continue
			[[ "$line" != src/gz* ]] && continue
			# shellcheck disable=SC2086
			set -- $line # DONT QUOTE set -- splits on whitespace
			local type="$1" name="$2" url="$3" builtin=false
			[[ "$name" == "$OPKG_MANAGER_FEED_NAME" ]] && builtin=true || builtin=false
 
			if [[ $first -eq 0 ]]; then printf ',' >> "$cache_file"; fi
			printf '{"name":"%s","url":"%s","builtin":%s}' "${name}" "${url}" "$builtin" >> "$cache_file"
			first=0
		done < "$feeds_file"
	fi
	printf ']\n' >> "$cache_file"
	echo "$cache_file"
	return 0
}
 
opkg_qml_feed_crud() {

	[[ "${2}" == "opkg-manager" ]] && { echo "The opkg-manager cannot be removed/edited"; return 1; }
	__opkg_qml_feed_crud "$@"
}

opkg_qml_create_json_package_list() {
  local -A feeds
  local line
  local feed
  local list_file
  local installed_source=""
  local installed_mode=""
  local tmp_installed_file=""
  local -a list_files=()
  local cache_tmp=""
  local latest_mtime=0
  local mtime=0
  local cache_mtime=0
  local now=0
  local cache_ttl=5
  local -i callUpdate=0
 
  [[ "${1:-}" == "update" ]] && callUpdate=1

  if [[ ! -f "${OPKG_FEED_CONFIG_FILE}" ]]; then
    opkg_common_ensure_feed
    callUpdate=1
  fi
 
  if ((callUpdate==1)); then
    opkg update
  fi
  
  # get feed each line from opkg-manager.conf file
  # skip comments and blank lines
  if [[ -f "${OPKG_FEED_CONFIG_FILE}" ]]; then
    while IFS= read -r line; do
      [[ -z "${line}" || "${line}" == \#* ]] && continue
      [[ "${line}" != src/gz* ]] && continue
      set -- ${line} # DONT QUOTE set -- splits on whitespace
      echo "2=${2}"
      [[ -n "${2:-}" ]] && feeds["${2}"]=1
    done < "${OPKG_FEED_CONFIG_FILE}"

    mtime=$(stat -L -c %Y "${OPKG_FEED_LOCAL_CONFIG_FILE}" 2>/dev/null || echo 0)
    (( mtime > latest_mtime )) && latest_mtime=${mtime}
  fi
exit 0
  if [[ "${#feeds[@]}" -eq 0 ]]; then
    printf '[]' > "${OPKG_PACKAGES_JSON_CACHE_FILE}"
    echo "No feeds" >&2
    echo ""
    return 1
  fi

  for feed in "${!feeds[@]}"; do
    list_file="/usr/lib/opkg/lists/${feed}"
    [[ -f "${list_file}" ]] || continue
    list_files+=("${list_file}")

    mtime=$(stat -L -c %Y "${list_file}" 2>/dev/null || echo 0)
    (( mtime > latest_mtime )) && latest_mtime=${mtime}
  done

  if [[ "${#list_files[@]}" -eq 0 ]]; then
    printf '[]' > "${OPKG_PACKAGES_JSON_CACHE_FILE}"
    echo "No feed files" >&2
    echo ""
    return 1
  fi

  if [[ -f "/usr/lib/opkg/status" ]]; then
    mtime=$(stat -L -c %Y "/usr/lib/opkg/status" 2>/dev/null || echo 0)
    (( mtime > latest_mtime )) && latest_mtime=${mtime}
  fi

  if [[ -f "${OPKG_PACKAGES_JSON_CACHE_FILE}" ]]; then
    cache_mtime=$(stat -L -c %Y "${OPKG_PACKAGES_JSON_CACHE_FILE}" 2>/dev/null || echo 0)
    if (( cache_mtime >= latest_mtime )); then
      echo "${OPKG_PACKAGES_JSON_CACHE_FILE}"
      return 0
    fi
  fi

  if [[ -f "/usr/lib/opkg/status" ]]; then
    installed_source="/usr/lib/opkg/status"
    installed_mode="status"
  else
    if [[ -f "${OPKG_PACKAGES_JSON_CACHE_FILE}" ]]; then
      now=$(date +%s)
      cache_mtime=$(stat -L -c %Y "${OPKG_PACKAGES_JSON_CACHE_FILE}" 2>/dev/null || echo 0)
      if (( now - cache_mtime < cache_ttl )); then
        echo "${OPKG_PACKAGES_JSON_CACHE_FILE}"
        return 0
      fi
    fi

    tmp_installed_file=$(mktemp)
    installed_source="${tmp_installed_file}"
    installed_mode="list"
    opkg list-installed > "${installed_source}"
  fi

  cache_tmp=$(mktemp)
  printf '[' > "${cache_tmp}"
  awk \
    -v installed_file="${installed_source}" \
    -v installed_mode="${installed_mode}" \
    '
    function json_escape(s, i, c, out) {
      gsub(/[\001-\010\013\014\016-\037]/, "", s)
      gsub(/\\/, "\\\\", s)
      gsub(/"/, "\\\"", s)
      gsub(/\t/, "\\t", s)
      gsub(/\r/, "", s)
      gsub(/\n/, "\\n", s)
      return s
    }
    function flush_entry() {
      if (name != "") {
        if (printed) {
          printf ","
        }
        printed = 1
        # Output installedVersion as a string (empty if not installed)
        desc_long_out = (description_long != "" && description_long != description_short) ? description_long : ""
        printf "{\"name\":\"%s\",\"description_short\":\"%s\",\"description_long\":\"%s\",\"version\":\"%s\",\"feed\":\"%s\",\"installedVersion\":\"%s\"}", \
          json_escape(name), \
          json_escape(description_short), \
          json_escape(desc_long_out), \
          json_escape(version), \
          json_escape(feed), \
          ((name in installed) ? json_escape(installed[name]) : "")
      }
      name = ""
      version = ""
      description_short = ""
      description_long = ""
      desc_active = 0
    }
    BEGIN {
      printed = 0
      name = ""
      version = ""
      description_short = ""
      description_long = ""
      desc_active = 0

      if (installed_mode == "status") {
        # Parse /usr/lib/opkg/status stanzas and keep only installed packages
        pkg = ""; ver = ""; status = ""
        while ((getline line < installed_file) > 0) {
          if (line == "") {
            if (pkg != "" && status ~ /(^|[[:space:]])installed([[:space:]]|$)/) {
              installed[pkg] = ver
            }
            pkg = ""; ver = ""; status = ""
            continue
          }

          if (line ~ /^Package: /) {
            pkg = substr(line, 10)
          } else if (line ~ /^Version: / && pkg != "") {
            ver = substr(line, 10)
          } else if (line ~ /^Status: / && pkg != "") {
            status = substr(line, 9)
          }
        }

        if (pkg != "" && status ~ /(^|[[:space:]])installed([[:space:]]|$)/) {
          installed[pkg] = ver
        }

        close(installed_file)
      } else if (installed_mode == "list") {
        # Parse output of opkg list-installed (format: name - version - description)
        while ((getline line < installed_file) > 0) {
          split(line, parts, /[[:space:]]+-[[:space:]]+/)
          if (parts[1] != "" && parts[2] != "") {
            installed[parts[1]] = parts[2]
          }
        }
        close(installed_file)
      }
    }
    FNR == 1 {
      if (NR != 1) {
        flush_entry()
      }
      n = split(FILENAME, path_parts, "/")
      feed = path_parts[n]
    }
    {
      line = $0
      if (line == "") {
        flush_entry()
        next
      }

      if (line ~ /^ / && desc_active == 1) {
        next_line = substr(line, 2)
        if (description_long == "") {
          description_long = next_line
        } else {
          description_long = description_long " " next_line
        }
        next
      }

      if (line ~ /^Package: /) {
        name = substr(line, 10)
        next
      }

      if (line ~ /^Version: /) {
        version = substr(line, 10)
        next
      }

      if (line ~ /^Description: /) {
        description_short = substr(line, 14)
        description_long = ""
        desc_active = 1
        next
      }

      desc_active = 0
    }
    END {
      flush_entry()
    }
    ' "${list_files[@]}" >> "${cache_tmp}"
  printf ']\n' >> "${cache_tmp}"

  mv "${cache_tmp}" "${OPKG_PACKAGES_JSON_CACHE_FILE}"
  echo "${OPKG_PACKAGES_JSON_CACHE_FILE}"

  [[ -n "${tmp_installed_file}" ]] && rm -f "${tmp_installed_file}"
  
  return 0
}
 
case "${1:-}" in
	get-feeds)

		opkg_create_json_feeds_list
		;;
	add-feed)
		opkg_qml_feed_crud "add" "${2:-}" "${3:-}" "${4:-}"
		;;
	edit-feed)
		opkg_qml_feed_crud "edit" "${2:-}" "${3:-}" "${4:-}"
		;;
	remove-feed)
		opkg_qml_feed_crud "remove" "${2:-}" "" ""
		;;

  list-packages)
    opkg_qml_create_json_package_list "${2:-}"
    ;;
  install-package)
    shift
    opkg_qml_install_package "$@"
    ;;
  remove-package)
    shift
    opkg_qml_remove_package "$@"
    ;;
  upgrade-package)
    shift
    opkg_qml_upgrade_package "$@"
    ;;
  set-feed)
    opkg_common_set_feed "${1}"
    ;;
  get-feed-type)
    opkg_qml_get_feed_type
    ;;
  *)
    if [[ -n ${1:-} ]]; then
      echo "opkg-qml: incorrect command : ${1}" >&2
    fi
    ;;
esac

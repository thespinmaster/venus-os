#!/usr/bin/env bash

set -o nounset

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
qml_file="$repo_root/tests/qmlplugin-test/test-opkghelpers.qml"

if [[ -n "${1:-}" ]]; then
	if [[ "$1" = /* ]]; then
		qml_file="$1"
	else
		qml_file="$repo_root/tests/qmlplugin-test/$1"
	fi
fi
import_root="$repo_root/src/data/opkg-helpers/qml"

QT_SELECT=qt5 \
QT_QPA_PLATFORM=offscreen \
QT_QUICK_BACKEND=software \
QML2_IMPORT_PATH="$import_root" \
qmlscene "$qml_file"

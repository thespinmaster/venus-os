#!/usr/bin/env bash

this_path="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$this_path/../.." && pwd)"
opkg_common="$repo_root/src/data/opkg-helpers/opkg-common"

export VENUS_ROOT_DIR="$this_path/output/__"
mkdir -p "$VENUS_ROOT_DIR/etc/opkg"

command="${1:-}"
shift || true

case "$command" in
  add-feed)
    name="${1:-}"
    url="${2:-}"
    . "$opkg_common"
    opkg_common_add_feed "$name" "$url"
    ;;
  remove-feed)
    name="${1:-}"
    . "$opkg_common"
    opkg_common_remove_feed "$name"
    ;;
  *)
    echo "Unknown command: $command" >&2
    exit 2
    ;;
 esac

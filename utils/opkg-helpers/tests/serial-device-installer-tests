scaffold_install_usb_serial_device() {
  push_log_indent
  install_usb_serial_device
  local -i r=$?
  pop_log_indent
  return "$r"
}

# shellcheck disable=SC2120
stage_files() {
  
  local args=("$@")
  (( ${#args[@]} == 0 )) && {
    args=("serial-device-installer.test1.conf" "serial-device-installer.test1.conf.schema")
  }

  clear_output
 
  for file in "${args[@]}"; do
    [ -f "${assets_dir}/${file}" ] || { assert_file_exists "$file" "stage_file not found" >&2; return 1; }
    cp "${assets_dir}/${file}" "${output_dir}/${file}" 
  done

  return 0
}  


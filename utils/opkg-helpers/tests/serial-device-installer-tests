# tests loading the serial-device-installer.conf.schema file
test_serial_device_installer_schema() {
 
  schema_file="$this_path/assets/serial-device-installer.test1.conf.schema"

  conf_lib_lint "$schema_file"
  assert_exitcode

}

# test loading from schema file fails when required vars are missing; conf file is also missing
test_load_with_schema_fails_missing_required() {
 
  stage_files "serial-device-installer.test1.conf.schema" # only copy schema
  
  conf_file="$output_dir/serial-device-installer.test1.conf"
  assert_file_not_exist "$conf_file" $silent
  assert_file_exists "${conf_file}.schema" $silent

  local stderr=
  exec 3>&1
  stderr="$(conf_lib_load_with_schema "$conf_file" 2>&1 1>&3)"
  assert_exitcode 1 "Missing Required Values"
  assert_eq "Missing required value for '\$SERVICE_NAME'" "${stderr}" "stderr correct"

  local var_set=false
  [[ -v "SERVICE_NAME" ]] && var_set=true
  assert_eq false "$var_set" "SERVICE_NAME is unset"
 
}
# test loading from schema file fails when required vars are missing; conf file is also missing
test_load_with_schema_succeeds_required_vars_provided() {
 
  stage_files "serial-device-installer.test1.conf.schema" # only copy schema
 
  conf_file="$output_dir/serial-device-installer.test1.conf"
  assert_file_not_exist "$conf_file" $silent
  assert_file_exists "${conf_file}.schema" $silent

  local ___SERVICE_NAME=$test_SERVICE_NAME

  conf_lib_load_with_schema "$conf_file"
  assert_exitcode 0 "Missing Required Values"
  assert_eq "$SERVICE_NAME" "$test_SERVICE_NAME"
  assert_empty "${SERVICE_MAPPING_NAME:-}" $silent
  assert_empty "${TTY-}" $silent
  assert_empty "$SERIAL_STARTER_RULE" $silent
  assert_not_empty "$SERVICE_PATH" $silent
  assert_not_empty "$SERIAL_STARTER_START_SERVICE_PATH" $silent
  assert_not_empty "$SERIAL_STARTER_RULES_FILE" $silent
  assert_not_empty "$SERIAL_STARTER_CONFIG_FILE" $silent
  assert_not_empty "$SERIAL_STARTER_CONFIG_TEXT_MATCH" $silent
  assert_not_empty "$SERIAL_STARTER_RULES_TEXT_MATCH" $silent
  assert_not_empty "$UDEVADM_PROPS" $silent
  assert_not_empty "$USE_UDEVADM_MONITOR" $silent
 }
 
# test loading defaults from schema file; required vars set
test_load_with_schema_filled_required_vars() {
  
  stage_files "serial-device-installer.test1.conf"
  
  __SERVICE_NAME="$test_SERVICE_NAME"
  conf_lib_load_with_schema "$conf_file"
  assert_exitcode 0 
  assert_eq "$SERVICE_NAME" "$test_SERVICE_NAME" $silent
}
 
# test loading defaults from schema file; conf file is missing; required vars set
test_load_with_schema_filled_required_vars() {

  stage_files

  conf_file="$output_dir/serial-device-installer.test1.conf"
  
  ___SERVICE_NAME="$test_SERVICE_NAME"
  conf_lib_load_with_schema "$conf_file"
  conf_lib_save_with_schema "$conf_file"
  assert_exitcode 0 
  assert_eq "$SERVICE_NAME" "$test_SERVICE_NAME" $silent
}


#!/bin/bash

# exit on error
set -e

# note shellcheck requires +xn arguments
# shellcheck source=./install-helper
PACKAGENAME=opkg-helpers
OPKG_COMMON=/data/${PACKAGENAME}/opkg-common.sh
source "${OPKG_COMMON}"

SCRIPT="
# ${PACKAGENAME} (do not edit)
${OPKG_COMMON} \"ensure_installed\""

add_script_to_rc_local "${SCRIPT}"

add_package_name_to_custom_packages_file "${PACKAGENAME}"

echo "successfully installed ${PACKAGENAME}"


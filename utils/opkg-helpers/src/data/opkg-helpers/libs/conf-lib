#!/usr/bin/env bash
#
# Example usage:
#
#   source conf_lib.sh
#   load_vars_with_schema example.vars || exit 1
#   echo "PORT=$PORT"
#
# Provides:
#   - conf_lint        (--fix --json --strict --style)
#   - load_vars        (safe, multiline, escaped)
#   - load_schema
#   - load_vars_with_schema

set -o nounset
 
#Depends
# shellcheck disable=SC2155
declare __this_path=$(dirname "${BASH_SOURCE[0]}")

#. "$__this_path/core-lib"
. "$__this_path/string-lib"
 
# ============================================================
# Schema state
# ============================================================
declare -A __CONF_LIB_SCHEMA_TYPE=()
declare -A __CONF_LIB_SCHEMA_DEFAULT=()
declare -A __CONF_LIB_SCHEMA_FLAGS=()
declare -A __CONF_LIB_SCHEMA_VARIABLES=()

# ============================================================
# Config state
# ============================================================
declare -A CONF_LIB_STATE_FLAGS=()

__CONF_LIB_SCHEMA_FLAG_REQUIRED=0x1
__CONF_LIB_SCHEMA_FLAG_SECRET=0x2
__CONF_LIB_SCHEMA_FLAG_READONLY=0x4
#Intent flags
__CONF_LIB_STATE_FLAGS__DEFAULT_ORIGIN_MISSING=0x1
__CONF_LIB_STATE_FLAGS__DEFAULT_ORIGIN_EMPTY=0x2
__CONF_LIB_STATE_FLAGS__DEFAULT_ORIGIN_USER=0x4
# ============================================================
# Internal cleanup
# ============================================================
__conf_lib_schema_reset() {
  __CONF_LIB_SCHEMA_TYPE=()
  __CONF_LIB_SCHEMA_DEFAULT=()
  __CONF_LIB_SCHEMA_FLAGS=()
  __CONF_LIB_SCHEMA_VARIABLES=()
}

#######################################
# Internal helpers
#######################################

__conf_lib_valid_var() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; }
__conf_lib_is_multi_line() { [[ $1 =~ ^\"(.|\\)*([^\\\"]|\\)$ ]]; }
__conf_lib_has_invalid_escape() { [[ "$1" =~ \\[^\"\\] ]]; }

#######################################
# Validate a value against a schema type.
#
# Supported types:
#   string
#   int
#   bool
#   enum:a,b,c
#
# Arguments:
#   $1 - Value to validate
#   $2 - Type definition
#
# Returns:
#   0 - Value is valid
#   1 - Value is invalid
#######################################
conf_lib_schema_validate_value() {
  local value="$1" type="$2"

  case "$type" in
  string) return 0 ;;
  int) [[ "$value" =~ ^-?[0-9]+$ ]] ;;
  bool) [[ "$value" == "true" || "$value" == "false" ]] ;;
  enum:*)
    local opts="${type#enum:}"
    IFS=',' read -ra allowed <<<"$opts"
    for v in "${allowed[@]}"; do
      [[ "$value" == "$v" ]] && return 0
    done
    return 1
    ;;
  *) return 1 ;;
  esac

}

#######################################
# Load a schema definition file that
# describes allowed config variables,
# their types, defaults, and requirements.
#
# Schema format:
#   KEY | TYPE | FLAGS | DEFAULT
#
# Arguments:
#   $1 - Path to schema file
#
# Populates global associative arrays:
#   CONF_SCHEMA_TYPE
#   CONF_SCHEMA_DEFAULT
#   CONF_SCHEMA_FLAGS
#   __CONF_LIB_SCHEMA_VARIABLES
#
# Returns:
#   0 - Success
#   1 - Invalid schema file
#
# Side effects:
#   - Initializes/overwrites schema globals
#######################################

conf_lib_load_schema() {
  local schema_file="$1"
  local line skey type def flags # using skey as key appears to be reserved in bashdb
  local -i bitflags=0 lineno=0 multi_line_default=0

  if [[ ! -f "$schema_file" ]]; then
    echo "schema file not found" >&2
    return 1
  fi

  __conf_lib_schema_reset

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((lineno++))

    if ((multi_line_default)); then
      def+="${line}"$'\n'
      string_lib_ends_with_quote "${line}" || continue
    else
      #line="${line%%#*}" do not remove comments from the end of lines in a schema file
      [[ -z "${line//[[:space:]]/}" || $line == \#* ]]  && continue
 
      IFS='|' read -r skey type flags def <<<"$line"

      string_lib_remove_all_whitespace skey
      string_lib_remove_all_whitespace type
      string_lib_trim flags
      string_lib_trim_start def

      __conf_lib_valid_var "$skey" || {
        echo "$schema_file:$lineno Invalid variable '$skey'" >&2
        return 1
      }
      __CONF_LIB_SCHEMA_VARIABLES["$skey"]=1
      __CONF_LIB_SCHEMA_TYPE["$skey"]="$type"
    fi

    if [[ -n "$def" ]]; then
      if ((multi_line_default)); then
        multi_line_default=0

        def="${def:0:-1}" # remove newline we added above
        # remove any trailing spaces before end quote
        string_lib_trim_end def
        def="${def:1:-1}" # start and end quote
      elif __conf_lib_is_multi_line "$def"; then
        multi_line_default=1

        def+=$'\n'
        continue
      else
        string_lib_trim def
      fi

      if ((!multi_line_default)); then
        string_lib_unescape def
        if [[ -n "$def" ]]; then
          __CONF_LIB_SCHEMA_DEFAULT["$skey"]="$def"
        fi
      fi
    fi

    bitflags=0
    [[ "$flags" =~ required ]] && ((bitflags |= __CONF_LIB_SCHEMA_FLAG_REQUIRED))
    [[ "$flags" =~ secret ]] && ((bitflags |= __CONF_LIB_SCHEMA_FLAG_SECRET))
    [[ "$flags" =~ readonly ]] && ((bitflags |= __CONF_LIB_SCHEMA_FLAG_READONLY))

    __CONF_LIB_SCHEMA_FLAGS["$skey"]="$bitflags"

  done <"$schema_file"

  return 0
}

#######################################
# Lint a configuration file for syntax,
# style, and structural errors.
#
# Supports:
#   --fix    : Auto-fix trivial issues (trailing whitespace)
#   --strict : Enforce strict parsing rules
#   --style  : Enforce style rules (UPPERCASE public vars)
#   --json   : Emit machine-readable JSON output
#
# Arguments:
#   $1 - Path to config file
#   $@ - Optional flags (--fix, --strict, --style, --json)
#
# Returns:
#   0 - No issues
#   1 - Warnings only
#   2 - Errors found
#
# Side effects:
#   - May rewrite the config file if --fix is used
#   - Writes diagnostics to stderr or stdout (JSON mode)
#######################################
conf_lib_lint() {
  local file="$1"
  shift
  local fix=0 strict=0 json=0 style=0

  while [[ "${1:-}" ]]; do
    case "$1" in
    --fix) fix=1 ;;
    --strict) strict=1 ;;
    --json) json=1 ;;
    --style) style=1 ;;
    esac
    shift
  done
    
  [[ -f "$file" ]] || {
    echo "conf file not found" >&2
    return 1
  }

  local line lineno=0
  local in_multiline=0 in_heredoc=0 heredoc_tag=""
  local -A seen=()
  local errors=0 warnings=0
  local messages=()
  local fixed=""
  local skey=

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((lineno++))
 
    # auto-fix trailing whitespace
    if ((fix)); then
      fixed+="${line%"${line##*[![:space:]]}"}"$'\n'
    fi

    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    if ((in_multiline)); then
      string_lib_ends_with_quote "$line" && in_multiline=0
      continue
    fi

    if ((in_heredoc)); then
      [[ "$line" == "$heredoc_tag" ]] && in_heredoc=0
      continue
    fi

    # quoted assignment ([[:space:]]*)
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=\" ]]; then
      local skey="${BASH_REMATCH[1]}"

      ((strict)) && __conf_lib_has_invalid_escape "$line" && {
        messages+=("$file:$lineno ERROR invalid escape sequence")
        ((errors++))
      }

      ((style)) && ! string_lib_is_upper "$skey" && {
        messages+=("$file:$lineno WARNING '$skey' should be uppercase")
        ((warnings++))
      }

      ((seen["$skey"]++)) && {
        messages+=("$file:$lineno WARNING duplicate '$skey'")
        ((warnings++))
      }

      if ((strict)) && string_lib_ends_with_quote "$line" &&
        [[ "$line" =~ \"[[:space:]]+[^#[:space:]] ]]; then
        messages+=("$file:$lineno ERROR trailing garbage after closing quote")
        ((errors++))
      fi

      string_lib_ends_with_quote "$line" || in_multiline=1
      continue
    fi

    # heredoc
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)\<\<([A-Za-z0-9_]+)$ ]]; then
      heredoc_tag="${BASH_REMATCH[2]}"
      in_heredoc=1
      continue
    fi

    #[[ "$line" == *"="* ]] && {
    #  messages+=("$file:$lineno ERROR malformed assignment")
    #  ((errors++))
    #}
  done <"$file"

  ((in_multiline)) && messages+=("$file:$lineno ERROR unterminated quoted value")
  ((in_heredoc)) && messages+=("$file:$lineno ERROR unterminated heredoc")

  ((fix)) && printf '%s' "$fixed" >"$file"

  if ((json)); then

    printf '{ "errors": %d, "warnings": %d, "messages": [' "$errors" "$warnings"
    local first=1
    for m in "${messages[@]}"; do
      ((first)) || printf ','
      first=0
      printf '"%s"' "$m"
    done
    printf '] }\n'
    
  elif [[ "${#messages[@]}" -gt 0 ]]; then
     printf '%s\n' "${messages[@]}" >&2
  fi

  ((errors > 0)) && return 1
  ((warnings > 0)) && return 2
  return 0
  
}

#######################################
# Safely load variables from a config file
# into the current shell environment.
#
# Features:
#   - No `source` or `eval`
#   - Supports multiline quoted values
#   - Supports heredocs
#   - Handles escaped double quotes
#
# Automatically runs `conf_lint` in
# --strict and --style mode before loading.
#
# Arguments:
#   $1 - Path to config file
#
# Returns:
#   0 - Success
#   1 - Linting or parsing failure
#
# Side effects:
#   - Sets shell variables in the caller's scope
#######################################
conf_lib_load() {
  __conf_lib_schema_reset
  __conf_lib_load "$1" || return 1
  return 0
}

__conf_lib_load() {

  local file="$1"
  local using_schema=${2:-}

  conf_lib_lint "$file" --strict --style || {     
    return 1
  }
  local line skey value buffer="" heredoc_tag=""
  local -i in_multiline=0 in_heredoc=0 is_quoted=0

  check_key_exists_in_schema() {
    if [[ $using_schema ]] && [[ ! "${__CONF_LIB_SCHEMA_TYPE[$1]+aaa}" ]]; then
      echo "Key not found in schema '$1'" >&2
      return 1
    fi
    return 0
  }

  add_key_and_value() {
    printf -v "$1" '%s' "$2"
  }

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    if ((in_multiline)); then

      if string_lib_ends_with_quote "$line"; then

        buffer+="${line%\"}"
        string_lib_unescape buffer

        add_key_and_value "$skey" "$buffer"

        buffer=""
        in_multiline=0
      else
        buffer+="$line"$'\n'
      fi
      continue
    fi

    if ((in_heredoc)); then
      if [[ "$line" == "$heredoc_tag" ]]; then
        buffer="${buffer%$'\n'}" # trim trailing newline

        add_key_and_value "$skey" "$buffer"
        buffer=""
        in_heredoc=0
      else
        buffer+="$line"$'\n'
      fi
      continue
    fi

    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      skey="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"

      check_key_exists_in_schema "$skey" || return 1
      if [[ ${value:0:1} == "\"" ]]; then
        value="${value:1}"
        is_quoted=1
      else
        is_quoted=0
      fi

      if [[ $is_quoted == 0 ]] || string_lib_ends_with_quote "$line"; then
        value="${value%\"}"
        value="${value//\\\"/\"}"

        # only need to check here for return code to see if value is valid
        add_key_and_value "$skey" "$value" || return 1
      else
        buffer="$value"$'\n'
        in_multiline=1
      fi
      continue
    elif [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      skey="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
    fi

    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)\<\<([A-Za-z0-9_]+)$ ]]; then
      skey="${BASH_REMATCH[1]}"
      heredoc_tag="${BASH_REMATCH[2]}"
      check_key_exists_in_schema "$skey" || return 1
      buffer=""
      in_heredoc=1
    fi
  done <"$file"

  return 0
}

#######################################
# Load a config file with optional schema
# enforcement.
#
# Behavior:
#   - Automatically loads <config>.schema
#     if it exists
#   - Applies default values
#   - Enforces required variables
#   - Validates values against types
#
# Internally calls:
#   - load_schema (if schema exists)
#   - load_vars
#
# Arguments:
#   $1 - Path to config file
#   $2 - optional schema file; if empty .schema is appended to $1
# Returns:
#   0 - Success
#   1 - Scheme Load Errors
#   2 - Load Errors
#   3 - Scheme Validation Errors
# Side effects:
#   - Sets shell variables in the caller's scope
#######################################
conf_lib_load_with_schema() {
  local config="$1"
  local schema="${2:-${config}.schema}"
  local -i retVal=0
 
  conf_lib_load_schema "$schema" || retVal=1

  if ((retVal == 0)); then

    # reset all values in the schema before loading
    for skey in "${!__CONF_LIB_SCHEMA_TYPE[@]}"; do
      [[ -v "${skey}" ]] && unset -v "${skey}"
    done

    if [[ -f $config ]]; then
      __conf_lib_load "$config" "1" || retVal=2
    fi
  fi

  ((retVal != 0)) && {
    __conf_lib_schema_reset
    return $retVal
  }
  CONF_LIB_STATE_FLAGS=()

  local skey type flags required #errors=0

  for skey in "${!__CONF_LIB_SCHEMA_TYPE[@]}"; do
    
    local type="${__CONF_LIB_SCHEMA_TYPE["$skey"]}"
    local flags="${__CONF_LIB_SCHEMA_FLAGS["$skey"]:-0}"
    local required=0
    ((flags & __CONF_LIB_SCHEMA_FLAG_REQUIRED)) && required=1
    local resolved_value="${!skey:-}"

    if [[ ! -v "${skey}" ]]; then
      ((CONF_LIB_STATE_FLAGS["$skey"] |= __CONF_LIB_STATE_FLAGS__DEFAULT_ORIGIN_MISSING))
    elif [[ -z ${!skey} ]]; then
      ((CONF_LIB_STATE_FLAGS["$skey"] |= __CONF_LIB_STATE_FLAGS__DEFAULT_ORIGIN_EMPTY))
    fi

    if [[ -z ${!skey:-} ]]; then
      resolved_value="${__CONF_LIB_SCHEMA_DEFAULT[$skey]:-}"
    fi

    if [[ -z "$resolved_value" ]]; then
      #check if the caller supplied a default value
      local key_def="___${skey}"
      if [[ -v "${key_def}" ]]; then
        ((CONF_LIB_STATE_FLAGS["$skey"] |= __CONF_LIB_STATE_FLAGS__DEFAULT_ORIGIN_USER))
        resolved_value="${!key_def}"
      fi
    fi

    if [[ -z "$resolved_value" ]]; then
      ((required)) && {
    
        echo "Missing required value for '\$$skey'" >&2
 
        retVal=1
      }
      printf -v "$skey" '%s' "" # Ensure variable exists
      continue
    fi

    conf_lib_schema_validate_value "$resolved_value" "$type" || {
      echo "Invalid value for '$skey' (expected $type)" >&2
      retVal=1
      continue
    }
 
    printf -v "$skey" '%s' "$resolved_value"
    
    #echo "skey=$skey | type=$type | flags=$flags | readonly=$read_only | required=$required | value=""$(echo "${!skey:-(empty)}" | head -c 10)"

  done

  __conf_lib_schema_reset

  return $retVal
}

#######################################
# Update config file with current shell values
# Escapes double quotes and backslashes
#######################################
# loop though the existing file
# keeping existing comments
# for each variable found update its value
#   When updating and using a schema
#     use a supplied schama_callback to....
#       set the value to the default value if empty
#       set the value to the default value if readonly
#       validate the new value
#   store the value in the file
# For multi-line and heredoc values
# keep looping until the end of the variables end tag
# finaly add any values not found in the existing file
#     doing the same as we did with the existing variables

conf_lib_save_with_schema() {

  for opt in "$@"; do
    case "$opt" in
    --dry-run) ;;
    --diff) ;;
    --*)
      echo "invalid args"
      return 1
      ;;
    *) break ;;
    esac
  done

  local -i dry_run=0
  local -i diff=0

  local conf_file="$1"
  local schema_file=${2:-${conf_file}.schema}

  conf_lib_load_schema "${schema_file}" || return 1

  __conf_lib_save "$@" --use-schema-callback
}

conf_lib_save() {

  for opt in "$@"; do
    case "$opt" in
    --dry-run) ;;
    --diff) ;;
    --*)
      echo "invalid args"
      return 1
      ;;
    *) break ;;
    esac
  done

  __conf_lib_save "$@"
}

__conf_lib_save() {

  local conf_file=
  local -i use_schema_callback=
  local -i dry_run=
  local -i diff=

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --dry-run) dry_run=1 ;;
    --diff) diff=1 ;;
    --use-schema-callback) use_schema_callback=1 ;;
    *) break ;;
    esac
    shift
  done

  local conf_file="$1"
  local tmp="${conf_file}.tmp"
  local line skey indent heredoc_tag
  local -i in_multiline=0 in_heredoc=0 retVal=0
  local -A seen=()
  local lf=$'\n'

  escape() {
    local -n _value="$1"
    #_value="${_value//\\/\\\\}"
    _value="${_value//\"/\\\"}"
  }

  save_schema_value() {

    if ((__CONF_LIB_SCHEMA_FLAGS["$skey"] & __CONF_LIB_SCHEMA_FLAG_READONLY)); then
      # if the value is readonly keep the existing config value
      [[ -z $line ]] && { return; }
      printf '%s%s' "$line" "$lf" >>"$tmp"
      return 0
    fi

    [[ ! -v ${skey} ]] && return 0

    if [[ "${!skey}" == "${__CONF_LIB_SCHEMA_DEFAULT["$skey"]:-}" ]]; then
      if ((CONF_LIB_STATE_FLAGS["$skey"] & __CONF_LIB_STATE_FLAGS__DEFAULT_ORIGIN_EMPTY)); then
        printf '%s%s=%s' "${indent}" "$skey" "$lf" >>"$tmp"
        return 0
      elif ((CONF_LIB_STATE_FLAGS["$skey"] & __CONF_LIB_STATE_FLAGS__DEFAULT_ORIGIN_MISSING)); then
        # skey did not exit in file keep it that way
        return 0
      fi
    fi

    local value="${!skey}"
    escape value
    local type="${__CONF_LIB_SCHEMA_TYPE["$skey"]}"

    conf_lib_schema_validate_value "$value" "$type" || {
      echo "Invalid value for '$skey' 'value:'$value' (expected $type)" >&2
      retVal=1
      return
    }
    printf '%s%s="%s"%s' "${indent}" "$skey" "${value}" "$lf" >>"$tmp"
  }

  touch "$tmp"

  ((dry_run)) && [[ -f "$conf_file" ]] &&
    cp "$conf_file" "${conf_file}.bak" >"$tmp"

  local lineno=0

  # HACK: read but don't alter the lf for the last line
  # on last line set lf=''
  if [[ -f "$conf_file" ]]; then
    while IFS= read -r line || { [[ -n "$line" ]] && { lf=''; }; }; do

      if ((in_heredoc)); then
        [[ "$line" == "$heredoc_tag" ]] && in_heredoc=0
        continue
      fi

      if ((in_multiline)); then
        [[ "$line" == *'"' ]] && in_multiline=0
        continue
      fi

      if [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]]; then
        printf '%s%s' "$line" "$lf" >>"$tmp"
        continue
      fi

      if [[ "$line" =~ ^([[:space:]]*)([A-Za-z_][A-Za-z0-9_]*)\<\<([A-Za-z0-9_]+)$ ]]; then
        indent="${BASH_REMATCH[1]}"
        skey="${BASH_REMATCH[2]}"
        heredoc_tag="${BASH_REMATCH[3]}"
        seen["$skey"]=1

        if [[ -n "${!skey+x}" ]]; then
          local value="${!skey}"
          escape value
          printf '%s%s<<%s\n%s\n%s%s' "$indent" "$skey" "$heredoc_tag" \
            "$value" "$heredoc_tag" "$lf" >>"$tmp"

          in_heredoc=1
          continue
        fi
      fi

      if [[ "$line" =~ ^([[:space:]]*)([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
        indent="${BASH_REMATCH[1]}"
        skey="${BASH_REMATCH[2]}"

        ((seen["$skey"] = 1))
        #echo "skey:$skey"
        if [[ -v "$skey" ]]; then

          if [[ "${BASH_REMATCH[3]}" =~ (^|[^\\])\" ]]; then # starts with quote "
            string_lib_ends_with_quote "$line" || in_multiline=1
          fi

          if [[ $use_schema_callback ]]; then
            save_schema_value
          else
            local value="${!skey}"
            escape value
            printf '%s%s="%s"%s' "$indent" "$skey" "${value}" "$lf" >>"$tmp"
          fi

          continue
        fi
      fi

      printf '%s%s' "$line" "$lf" >>"$tmp"
    done <"$conf_file"
  fi

  # Add any new variables not origonaly in the file
  if [[ $use_schema_callback ]]; then
    line=
    indent=
    for skey in "${!__CONF_LIB_SCHEMA_TYPE[@]}"; do

      [[ -v ${skey} ]] && continue
      if [[ ! -v seen["$skey"] ]]; then
        ((__CONF_LIB_SCHEMA_FLAGS["$skey"] & __CONF_LIB_SCHEMA_FLAG_READONLY)) && continue

        save_schema_value
      fi

    done
  fi

  ((diff)) && { diff -u "$conf_file" "$tmp" || true; }
  if ((dry_run || retVal != 0)); then
    rm -f "$tmp"
  else

    [[ -f "$conf_file" ]] &&
      cp "$conf_file" "$conf_file.bak"

    [[ -f "$tmp" ]] &&
      mv "$tmp" "$conf_file"

  fi

  __conf_lib_schema_reset

  return $retVal
}

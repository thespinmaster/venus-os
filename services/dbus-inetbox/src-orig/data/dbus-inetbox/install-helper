install_helper_post_install() {
 
    __load_source_file "opkg-common"

    opkg_common_add_script_to_rc_local "${rc_local_script}"
    
    opkg_common_register_package "opkg-manager"

    opkg_common_ensure_feeds

    _install_helper_patch_files
    
    echo "restarting gui service..."
    svc -t /service/gui

    echo "please wait, updating packages..."
    opkg_common_update_packages "successfully installed ${opkg-manager}"

}

_install_helper_patch_files()
{
    echo "patching files"
    __load_source_file "file-patcher"
    local full_path=
    __appendDataDir "opkg-manager.patch" full_path

    file_patcher_apply_patch $full_path
}

install_helper_pre_remove() {
 
  __load_source_file "opkg-common"

  opkg_common_remove_script_from_rc_local "${rc_local_script}"

    echo "patching files"
    __load_source_file "file-patcher"
  local full_path=
   __appendDataDir "opkg-manager.patch" full_path
  file_patcher_revert_patch $full_path

  opkg_common_unregister_package "opkg-manager"

  opkg_common_remove_feed_symlink

}

RESTART_GUI_SERVICE=1
DBUS_SETTINGS="
		OpkgManager/CustomOverviewPages/OverviewInetbox:s:0:0:''
		OpkgManager/CustomMenus/PageSettings/PageSettingsInetboxSubMenu:s:0:0:''
	"

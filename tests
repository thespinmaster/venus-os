#!/bin/bash

# set -e

source ./string-helpers.sh

# 1. Define the multi-line string to REMOVE
IFS='' read -r -d '' SEARCH_PATTERN <<'EOF'
This is a test string
with $p€c!@l characters
and multiple lines.
EOF

# 2. Define the input file content and store it in a variable
IFS='' read -r -d '' FILE_CONTENTS <<'EOF'
Here is some introductory text.
This is a test string
with $p€c!@l characters
and multiple lines.
More text follows the match.
EOF

# 3. Define the input file content for non matches and store it in a variable
IFS='' read -r -d '' FILE_CONTENTS_NOMATCH <<'EOF'
Here is some introductory text.
This is a test string
with. $p€c!@l characters
and multiple lines.
More text follows the match.
EOF

FILE_NAME="file_contents.txt"
echo "$FILE_CONTENTS" > "$FILE_NAME"

FILE_NAME_NOMATCH="file_contents_nomatch.txt"
echo "$FILE_CONTENTS_NOMATCH" > "$FILE_NAME_NOMATCH"

# --------------------------------------------------------

# --------------------------------------------------------
# Main Script Execution
# --------------------------------------------------------
echo
echo "Running contains function on variable contents..."

# Call the function and capture its output into a new result variable
FOUND=$(multiline_string_match "$SEARCH_PATTERN" <<< "$FILE_CONTENTS")

if [[ $FOUND ]]; then
  echo "found"
else
 echo "not found"
fi

echo
echo "Running removal function on file contents..."

# Call the function and capture its output into a new result variable
RESULT=$(multiline_string_match "$SEARCH_PATTERN" < "$FILE_NAME")

# Print the result
echo "--- Modified Content ---"
echo "$RESULT"
echo "--------------------------"

echo "Running removal function on variable contents..."

# Call the function and capture its output into a new result variable
RESULT=$(multiline_string_match "$SEARCH_PATTERN" <<< "$FILE_CONTENTS")

# Print the result
echo "--- Modified Content ---"
echo "$RESULT"
echo "--------------------------"

echo "Running removal function on file contents and saving to file"
multiline_string_match "$SEARCH_PATTERN" <<< "$FILE_CONTENTS" > "$FILE_NAME.new"
echo "--- Modified Content (reading from $FILE_NAME.new) ---"
echo "$(<$FILE_NAME.new)"
echo "--------------------------"
echo
echo "=========================="
echo "NO MATCH TESTS"

echo "Running contains function on variable contents..."

# Call the function and capture its output into a new result variable
FOUND=$(multiline_string_match "$SEARCH_PATTERN" <<< "$FILE_CONTENTS_NOMATCH")

if [[ $FOUND ]]; then
  echo "found"
else
 echo "not found"
fi

echo
echo "Running removal function on file contents..."

# Call the function and capture its output into a new result variable
RESULT=$(multiline_string_match "$SEARCH_PATTERN" < "$FILE_NAME_NOMATCH")

# Print the result
echo "--- Modified Content ---"
echo "$RESULT"
echo "--------------------------"

echo "Running removal function on variable contents..."

# Call the function and capture its output into a new result variable
RESULT=$(awk_remove_multiline_string "$SEARCH_PATTERN" <<< "$FILE_CONTENTS_NOMATCH")

# Print the result
echo "--- Modified Content ---"
echo "$RESULT"
echo "--------------------------"

echo "Running removal function on file contents and saving to file"
awk_remove_multiline_string "$SEARCH_PATTERN" <<< "$FILE_CONTENTS_NOMATCH" > "$FILE_NAME_NOMATCH.new"
echo "--- Modified Content (reading from $FILE_NAME_NOMATCH.new) ---"
echo "$(<$FILE_NAME_NOMATCH.new)" 
echo "--------------------------"

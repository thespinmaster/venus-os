alias get_usb_port="/data/dev/projects/venus-os/scripts/get-usb-port.sh"
alias list_alias="cat /data/dev/projects/venus-os/scripts/my-alias.sh"
alias nano_alias="nano /data/dev/projects/venus-os/scripts/my-alias.sh;bash -l"


#!/usr/bin/env bash

# ==============================
# Bash Config Management Library
# ==============================

#######################################
# option to create a backup file (.bak)
# when writing or deleting the
#######################################
CONF_BACKUP=1

#######################################
# Read all variables from file
# Arguments:
#   $1 - file name
#######################################
conf_load_all() {
  source "$1"
}

#######################################
# Write or update a variable
# Arguments:
#   $1 - file name
#   $2 - variable name
#   $3 - variable value
#######################################
conf_set_value() {
  local conf_file="$1"
  local key="$2"
  local value="$3"

  if grep -q "^${key}=" "${conf_file}"; then
    # Update existing variable
    local opt_backup=""
    [[ $CONF_BACKUP ]] && opt_backup="-i.bak"
    sed $opt_backup "s|^${key}=.*|${key}=\'${value}\'|" "$conf_file"
  else
    # Add new variable
    echo "${key}=\"${value}\"" >> "$conf_file"
  fi
}

#######################################
# Get a variable value without sourcing
# Arguments:
#   $1 - string       ; file to read the variable from
#   $2 - string       ; variable name
#######################################
conf_get_value_and_set() {
  local conf_file="$1"
  local key="$2"
  local literal="${3}"

  local value=$(sed -n \
    -e "s/^${key}=\'\(.*\)\'$/\1/p" \
    -e "s/^${key}=\(.*\)$/\1/p" \
    "$conf_file")

  printf -v "$key" "%s" "$value"
}

conf_get_value() {
  local conf_file="$1"
  local key="$2"

  sed -n \
    -e "s/^${key}=\'\(.*\)\'$/\1/p" \
    -e "s/^${key}=\(.*\)$/\1/p" \
    "$conf_file"

}

#######################################
# Delete a variable
# Arguments:
#   $1 - file name
#   $2 - variable name
#######################################
conf_delete_value() {
  local conf_file="${1}"
  local key="$2"
  local opt_backup=""
  [[ $CONF_BACKUP ]] && opt_backup="-i.bak"

  sed $opt_backup "/^${key}=/d" "$conf_file"
}

#######################################
# Reset all variables in the config file to empty
# Preserves comments and blank lines
# Creates a single backup
# Arguments:
#   $1 - path to config file
#######################################
reset_all_values() {
  local conf_file="$1"

  [[ -f "$conf_file" ]] || { touch "$conf_file"; return; }

  # Create a single backup
  cp "$conf_file" "${conf_file}.bak"

  local key

  while IFS= read -r line; do
    # Skip blank lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue

    # Extract key
    key="${line%%=*}"

    # Reset the variable in-place
    sed -i "s|^${key}=.*|${key}=\'\'|" "$conf_file"
  done < "$conf_file"
}

#######################################
# Update all variables in the config file with their current values
# Only updates variables already defined in the file
# Creates a single backup at the start
# Arguments:
#   $1 - file name
#######################################
conf_save_all() {

  local conf_file="${1}"

  [[ -f "${conf_file}" ]] || {
    echo "Error: config file not found: ${conf_file}" >&2
    return 1
  }

  # Create a backup
  [[ $CONF_BACKUP ]] && cp "${conf_file}" "${conf_file}.bak"

  local key value

  while IFS= read -r line; do
    # Skip blank lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue

    # Extract key
    key="${line%%=*}"

    # Only update if variable exists in shell
    if [[ -n "${!key+x}" ]]; then
      value="${!key}"
      # Update the line in-place
      # Use sed -i with regex anchored to the key
      sed -i "s|^${key}=.*|${key}=\'${value}\'|" "${conf_file}"
    fi
  done < "${conf_file}"
}

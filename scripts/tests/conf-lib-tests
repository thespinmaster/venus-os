}


multi_line_match() {
  
  local varname="$1"
  local string="$2"
  local filename="$3"
  local -i debug=
  [[ "${4:-}" == "--debug" ]] && debug=1
 
  test_string="${string//\"/\\\"}"
  test_string="${varname}=\"${test_string}\""

  local -i line_start_number
  local conf_line
  line_start_number=$(awk "/${varname}=/{ print NR; exit }" "$filename")
  (( line_start_number )) || return 1
  
  while IFS= read -r line; do
    conf_line="$(sed ${line_start_number}!d "$filename")"
    (( debug )) && echo -e "file:$conf_line\n var:${line}"   
    [[ "$conf_line" != "${line}" ]] && return 1
    (( line_start_number++ ))
  done <<< "${test_string}"
}

clear_output


scaffold_test_conf_lib_load_with_schema()
{
  local filename="${1}"
  local options="${2-}"
  local skip_file_exists=
  local should_fail=
  [[ "${options}" = *"--skip-file-exists"* ]] && skip_file_exists=1
  [[ "${options}" = *"--should-fail"* ]] && should_fail=1

  # stage
  local conf_file="${output_dir}/$filename"
 
  (( skip_file_exists )) &&
    assert_file_exists "${conf_file}.schema" "--"
  
  conf_lib_load_with_schema "${conf_file}" 

  if (( ! should_fail )); then
    assert_exitcode 0 "--"
  else
    assert_exitcode_not 0 "--"
  fi

  #2000 dec 31 18:30 00s
  touch -c -a -m -t 200112311830.00 "${conf_file}"
 
}

scaffold_test_conf_lib_save_with_schema()
{

  local filename="${1}"
  local options="${2-}"
  local should_fail=

  [[ "${options}" = *"--should-fail"* ]] && should_fail=1
  
  #local skip_file_exists=
  #[[ "${options}" = *"--skip-file-exists"* ]] && skip_file_exists=1

  local conf_file="${output_dir}/$filename"

  # execute
  conf_lib_save_with_schema "${conf_file}" "${conf_file}.schema"
  local exitcode=$?
  if (( should_fail )); then
    assert_eq 1 "$exitcode" "save failed: exit code is 1"
    
    #check file has not been modified
    local modtime=; modtime=$(stat -c %y "${conf_file}")
    assert_eq "2001" "${modtime:0:4}" "file not modified"
  else
    assert_eq 0 "$exitcode" "save succeeded: exit code is 0"
 
    assert_file_exists "${conf_file}"

    local modtime=; modtime=$(stat -c %y "${conf_file}")
    assert_eq "$(date +%Y)" "${modtime:0:4}" "file modified"
  fi
  
  return $exitcode
}

scaffold_test_conf_lib_load_and_save_with_schema()
{

  local filename="$1"
  local load_options="${2:-}"
  local save_options="${3:-}"

  stage_conf_files "$filename"
 
  scaffold_test_conf_lib_load_with_schema "$filename" "${load_options}"

  scaffold_test_conf_lib_save_with_schema "$filename" "${save_options}"
}



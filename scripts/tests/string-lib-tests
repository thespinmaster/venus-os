#set -e

this_path="$(dirname "${BASH_SOURCE[0]}")"

. "$this_path/../libs/test-lib"
. "$this_path/../libs/string-lib"
 
########################################
# Test config
#EXIT_ON_FAILED_TEST=1
TEST_INDENT="   "
########################################

########################################
# test data
########################################

TEST_STRING="one
two
three
two
four"

SEARCH_TEXT="two"
 
 ########################################
RESULT=
_d=

#test strings match when they don't have a final line feed char
test_remove1() {

  assert_not_eq "${TEST_STRING: -1}" $'\n' "--TEST_STRING string does not end in newline"

  set_var RESULT < <(send_var "$TEST_STRING" | 
            string_lib_multiline_find_replace "$SEARCH_TEXT")
  expected_RESULT="one
three
four"
  assert_eq "$expected_RESULT" "$RESULT" "Removed all literal matches"
}

########################################
#test strings match when they have a final line feed char
test_remove2() {
 
  TEST_STRING+=$'\n'
  assert_eq "${TEST_STRING: -1}" $'\n' "--TEST_STRING string should end with a newline"
  set_var RESULT < <(send_var "$TEST_STRING" | 
            string_lib_multiline_find_replace "$SEARCH_TEXT")
  expected_RESULT="one
three
four
"
  assert_eq "$expected_RESULT" "$RESULT" "Removed all literal matches"
}

########################################
#test --break-on-first only first matched string is removed
test_break_on_first1() {
 
  assert_not_eq "${TEST_STRING: -1}" $'\n' "--TEST_STRING string does not end in newline"
  set_var RESULT < <(send_var "$TEST_STRING" | 
            string_lib_multiline_find_replace --break-on-first "$SEARCH_TEXT")
  expected_RESULT="one
three
two
four"
  assert_eq "$expected_RESULT" "$RESULT" "Removed only first match"
}

########################################
#test --break-on-first only first matched string is removed
test_break_on_first2() {
 
  TEST_STRING=${TEST_STRING/two/$'\n'two$'\n'}
  assert_not_eq "${TEST_STRING: -1}" $'\n' "--TEST_STRING string does not end in newline"
  set_var RESULT < <(send_var "$TEST_STRING" | 
            string_lib_multiline_find_replace --break-on-first "$SEARCH_TEXT")
  expected_RESULT="one


three
two
four"
  assert_eq "$expected_RESULT" "$RESULT" "Removed only first match preserving newlines"
}

########################################
#test --trim-lines trims surrounding newlines
test_trimLines1() {
  
  TEST_STRING=${TEST_STRING/two/$'\n'two$'\n'}
  assert_not_eq "${TEST_STRING: -1}" $'\n' "--TEST_STRING string does not end in newline"
  set_var RESULT < <(send_var "$TEST_STRING" | 
            string_lib_multiline_find_replace --trim-lines "$SEARCH_TEXT")
  expected_RESULT="one
three
four"
  make_debug_str "$RESULT" _d
  _d2=; make_debug_str "$TEST_STRING" _d2
  assert_eq "$expected_RESULT" "$RESULT" "Strings match; trimed newlines"
}

########################################
#test --trim-lines, does NOT match correctly
test_trimLines2() {
 
  # This test returns the origional string because the 
  # lines with 'two' contain whitespace (tabs & spaces)
  # --ignore-white-space is needed for a correct match
  TEST_STRING=${TEST_STRING//two/$'\n\t' two$'\n'} # add extra new lines
  TEST_STRING=${TEST_STRING/three/$'\t'three$'\t\t'} # add extra tabs
  assert_not_eq "${TEST_STRING: -1}" $'\n' "--TEST_STRING string does not end in newline"
  set_var RESULT < <(send_var "$TEST_STRING" | 
            string_lib_multiline_find_replace --trim-lines "$SEARCH_TEXT")
   expected_RESULT="one
three
four"
 
  assert_eq "$TEST_STRING" "$RESULT" "Match not found; returned origional string"
}

########################################
#test --trim-lines; --ignore-white-space; does match correctly
test_trim_lines_ignore_white_space() {
 
  # This test returns
  # lines with 'two' contain whitespace (tabs & spaces)
  # --ignore-white-space is needed for a correct match
  TEST_STRING=${TEST_STRING//two/$'\n\t' two$'\n'} # add extra new lines
  TEST_STRING=${TEST_STRING/three/$'\t'three$'\t\t'} # add extra tabs
  
  assert_not_eq "${TEST_STRING: -1}" $'\n' "--TEST_STRING string does not end in newline"
  set_var RESULT < <(send_var "$TEST_STRING" | 
    string_lib_multiline_find_replace --trim-lines --ignore-white-space "$SEARCH_TEXT")
    expected_RESULT=$'one
\tthree
four'

  assert_eq "$expected_RESULT" "$RESULT" "Match found"

}

########################################
# literal match with replacement
test_literal_match_with_replacement() {

  set_var RESULT < <(
    send_var "$TEST_STRING" |
    string_lib_multiline_find_replace "$SEARCH_TEXT" --replacement-text "REPLACED"
  )

  expected_RESULT="one
REPLACED
three
REPLACED
four"
  _d2=; make_debug_str "$expected_RESULT" _d2
  _d3=; make_debug_str "$RESULT" _d3
  assert_eq "$expected_RESULT" "$RESULT" "replaces literal matches with text"
}


########################################
# test no matches returns the origional string
test_no_matches() {
  set_var RESULT < <(
    send_var "$TEST_STRING" |
    string_lib_multiline_find_replace "nomatch"
  )

  expected_RESULT="$TEST_STRING"

  assert_eq "$expected_RESULT" "$RESULT" "no literal matches returns input unchanged"
}

########################################
# empty input returns empty output
test_empty_input() {
  set_var RESULT < <(
    send_var "" |
    string_lib_multiline_find_replace "$SEARCH_TEXT"
  )

  expected_RESULT=""

  assert_eq "$expected_RESULT" "$RESULT" "empty input returns empty output"
}

########################################
# test we only match literal strings (not regex)
test_literal_non_regex() {
TEST_STRING_REGEX="a.b
axb
a*b"

  set_var RESULT < <(
    send_var "$TEST_STRING_REGEX" |
    string_lib_multiline_find_replace "a.b"
  )

  expected_RESULT="axb
a*b"

  assert_eq "$expected_RESULT" "$RESULT" "search text is treated literally"
}

########################################
#test replace string with special characters
test_special_characters() {

  TEST_STRING="one
two \"hell#*&()|o\"
three
four"
  SEARCH_TEXT="two \"hell#*&()|o\""
  set_var RESULT < <(send_var "$TEST_STRING" | 
            string_lib_multiline_find_replace "$SEARCH_TEXT")
  expected_RESULT="one
three
four"
  assert_eq "$expected_RESULT" "$RESULT" "Removed all literal matches"
}
 

#!/usr/bin/env bash

set -o nounset
 
EXIT_ON_FAILED_TEST=
TEST_INDENT=
TEST_RUNNER_ERROR_COUNT=0
TEST_RUNNER_SUCCESS_COUNT=0
TEST_RUNNER_SILENT=
 
__assert_lib_pass_or_fail() {

  # result is always the first
  # comment is always the second
  local res=$1
  local comment="$2"
 
  shift 2 # remove result & comment
 
  if [[ -n "${comment}" ]]; then
    [[ $# -gt 0 ]] && comment="${comment//#1/\'${1}\'}"
    [[ $# -gt 1 ]] && comment="${comment//#2/\'${2}\'}"

    if [[ "${comment::2}" == "--" ]]; then
      if [[ $res == true ]]; then
        return 0 # return without printing
      fi
      comment="${comment:2:${#comment}}"
    fi
  fi  

  if [[ $res == true ]]; then
    TEST_RUNNER_SUCCESS_COUNT=$(( TEST_RUNNER_SUCCESS_COUNT+=1 ))
    # \u2714\ufe0f
    # \u2705'
    #success="PASSED"
    #echo -e "${TEST_INDENT}\033[32mPASSED\033[00m: $comment"
    (( ! TEST_RUNNER_SILENT )) && {
      printf '%s\033[32m\u2705\ufe0f - \033[00m%s\n' "${TEST_INDENT}" "${comment}"
    }
  else
    TEST_RUNNER_ERROR_COUNT=$(( TEST_RUNNER_ERROR_COUNT+=1 ))

    local lineNo="${BASH_LINENO[1]}"
    # u274c\ufe0f cross
    #echo -e "${TEST_INDENT}\033[31;1mFAILED (line:$lineNo)\033[00m: \e[9m$comment\e[0m"
    
    # (( ! TEST_RUNNER_SILENT )) && {
      local align_space=
      printf '%s\033[31;1m\u274c\ufe0f (line:%s)\033[00m: %s\e[0m\n' "${TEST_INDENT}" "${lineNo}" "${comment}"
      for (( i=1; i <= "$#"; i++ )); do 
        #((i==2)) && align_space=" "
        printf '%s%s%q\n' "${TEST_INDENT}" "${align_space}" "${!i}"
      done
    #}
    if [[ $EXIT_ON_FAILED_TEST  ]]; then
      exit 255
    fi
  fi
  # some true results are formed from fails (file not exist etc..)
  # so make sure we an exit code based on the result
  #[[ $res ]] && return 0 
  return 0
}
 
__set_comment() {
  local -n _comment="$1" 
  if [[ -z "$_comment" || "$_comment" == "--" ]]; then
    _comment+="$2"
  fi
}

###################################
# Asserts if a file exists
# Arguments:
#   $1 file name
#   $2 optional - comment; default; "File exists"
#   $3 optional - retry count; default 1
###################################
assert_file_exists() {
  local res=false
  local comment="${2:-}"
  local -i retry_count="${3:-1}"

  __set_comment comment "File exists"
  while (( retry_count > 0)); do
    [[ -f "${1}" ]] && { res=true; break; }
    (( retry_count-=1 ))
    sleep 0.25
  done

  __assert_lib_pass_or_fail $res "$comment" "file:$1"

}

###################################
# Asserts if a file does not exist
# Arguments:
#   $1 file name
#   $2 comment
###################################
assert_file_not_exist() {
  local res=false
  local comment="${2:-}"
  __set_comment comment "File does not exist"
  [[ -f "${1}" ]] || res=true
  __assert_lib_pass_or_fail $res "$comment" "file:$1"
}

###################################
# Asserts if a directory exists
# Arguments:
#   $1 directory path
#   $2 comment
###################################
assert_dir_exists() {
  local res=false
  local comment="${2:-}"
  __set_comment comment "Directory exists"
  [[ -d "${1}" ]] && res=true
  __assert_lib_pass_or_fail $res "$comment" "path:$1"
}

###################################
# Asserts if a directory does not exist
# Arguments:
#   $1 directory path
#   $2 comment
###################################
assert_dir_not_exist() {
  local res=false
  local comment="${2:-}"
  __set_comment comment "Directory does not exist"
  [[ -d "${1}" ]] || res=true
  __assert_lib_pass_or_fail $res "$comment" "path:$1"
}

###################################
# Asserts if 2 values are equal
# Arguments:
#   $1 value1
#   $2 value2
#   $3 comment
###################################
assert_eq() { 
  local res=false
  local comment="${3:-}"
  __set_comment comment "Values are equal"
  [[ "${1:-}" == "${2:-}" ]] && res=true
  __assert_lib_pass_or_fail $res "$comment" "value 1:$1" "value 2:$2"
 }
 
 ###################################
# Asserts if value1 is greater than value 2
# Arguments:
#   $1 value1
#   $2 value1
#   $3 comment
###################################
assert_gt() { 
  local res=false
  local comment="${3:-}"
  __set_comment comment "Value1 is greater than Value2"
  (( "${1}" > "${2}" )) && res=true
  __assert_lib_pass_or_fail $res "$comment" "value 1:$1" "value 2:$2"
 }

###################################
# Asserts if value1 is less than value 2
# Arguments:
#   $1 value1
#   $2 value1
#   $3 comment
###################################
assert_lt() { 
  local res=false
  local comment="${3:-}"
  __set_comment comment "Value1 is less than Value2"
  (( "${1}" < "${2}" )) && res=true
  __assert_lib_pass_or_fail $res "$comment" "value 1:$1" "value 2:$2"
 }

###################################
# Asserts if value1 is between value 2 and value 3
# Arguments:
#   $1 value1
#   $2 value2
#   $3 value3
#   $4 comment
###################################
assert_between() { 

  if (( "${2}" >= "${3}"  )); then
    echo "value1 must be greater than value 2" &>2; 
    return 0
  fi
 
  local res=false
  local comment="${4:-}"
  __set_comment comment "Value1 is less than Value2"
  (( "${1}" >= "${2}" )) && (( "${1}" <= "${3}" )) && res=true
  __assert_lib_pass_or_fail $res "$comment" "value 1:$1" "value 2:$2" "value 3:$3"
 }

###################################
# Asserts if 2 values are not equal
# Arguments:
#   $1 value1
#   $2 value2
#   $3 comment
###################################
assert_not_eq() {
  local res=false
  local comment="${3:-}"
  __set_comment comment "Values are not equal"
  [[ "${1}" != "${2}" ]] && res=true
  __assert_lib_pass_or_fail $res "$comment" "value 1:$1" "value 2:$2"
 }
 
###################################
# Asserts if the value is empty
# Arguments:
#   $1 value
#   $2 comment
###################################
assert_empty() {
  local res=false
  local comment="${2:-}"
  __set_comment comment "Value is empty"
  [[ -z "${1:-}" ]] && res=true
  __assert_lib_pass_or_fail $res "$comment" "value:${1:-}"
}

###################################
# Asserts if the value is empty
# Arguments:
#   $1 value
#   $2 comment
###################################
assert_not_empty() {
  local res=false
  local comment="${2:-}"
  __set_comment comment "Value is empty"
  [[ -n "${1:-}" ]] && res=true
  __assert_lib_pass_or_fail $res "$comment" "value:${1:-}"
}


###################################
# Asserts if two files are equal (using cmp)
# Arguments:
#   $1 file 1
#   $2 file 2
#   $3 comment
###################################
assert_files_eq() {
  local res=false
  local file1="${1}"
  local file2="${2}"
  local comment="${3:-}"
  __set_comment comment "Files are equal"
  cmp --quiet "${file1}" "${file2}" && res=true
  __assert_lib_pass_or_fail $res "$comment" "file1:${file1}" "file2:${file2}"
}

###################################
# Asserts if a variable exists (not unset)

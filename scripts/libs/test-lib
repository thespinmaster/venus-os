###################################
# Asserts if the exit code equals
# Arguments:
#   $1 - required; exit code to match
#   $2 - optional; comment
# this method must be placed directly
# after the command to check as it
# uses "$?"
###################################
assert_exitcode() {
  exitcode=$?
  local res=false
  local comment="${2:-}"
  local expected=${1:-0}
  __set_comment comment "Exit code is valid"
  (( exitcode == expected )) && res=true
  __assert_lib_pass_or_fail $res "$comment" "expected:$expected" "recieved:$exitcode"
}

###################################
# Asserts if the exit code does not equal
# Arguments:
#   $1 - required; exit code to not match
#   $2 - optional; comment
# this method must be placed directly
# after the command to check as it
# uses "$?"
###################################
assert_exitcode_not() {
  exitcode=$?
  local res=false
  local comment="${2:-}"
  local arg1 arg2
  #if [[ ! $comment ]]; then
    arg1="not expecting:$1"; arg2="recieved:$exitcode"
  #else
  #  arg1="$1"; arg2="$exitcode"
  #fi
  __set_comment comment "Exit code is valid" 
  (( exitcode != ${1} )) && res=true

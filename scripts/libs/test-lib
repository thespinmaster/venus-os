###################################
# Runs an array of test functions
# Arguments:
#   $1 an array of functions to run
#
# Each function is run in its own
# issolated process '(...)''
###################################
test_runner() {
  local -i summary=0
   [[ "${1:-}" == "--summary" ]] && { shift; summary=1; }

  local -n _tests="$1"
  local -n _comments="$2"
  local -i i=0
  local error_count=0
  local success_count=0
  local tmpFile="/tmp/test-runner-${BASHPID}"  
  local -i res=
  local saved_TEST_RUNNER_SILENT=$TEST_RUNNER_SILENT
  local style=
  local output=
  local icon=

  if (( summary )); then
    TEST_RUNNER_SILENT=1
  fi

  # shellcheck disable=SC2329,SC2317
  cleanup() { 
    TEST_RUNNER_SILENT=${saved_TEST_RUNNER_SILENT:-}
    local tmpFile="/tmp/test-runner-${BASHPID}"
    if [[ -f "$tmpFile" ]]; then
      rm "$tmpFile" 
    fi
 
  }
  
  set_print_style() {
    if (( res != 0 )) && (( res != 255 )); then
      output="---Syntax error---"$'\n'"$output"$'\n'
      style='\033[1;35m'
      icon=
    elif (( TEST_RUNNER_ERROR_COUNT > 0 )); then
      style='\033[31;1m'
      icon='\u274c\ufe0f'
    elif (( TEST_RUNNER_SUCCESS_COUNT > 0 )); then
      style='\033[32m'
      icon='\u2705\ufe0f'
    else
      style='\033[1;37m'
      icon=
    fi
  }

  # shellcheck disable=SC2329,SC2317
  exit_test() {
    echo -e "TEST_RUNNER_SUCCESS_COUNT=$TEST_RUNNER_SUCCESS_COUNT\
    TEST_RUNNER_ERROR_COUNT=$TEST_RUNNER_ERROR_COUNT\n" >"$tmpFile"
    [[ $(type -t post_test_runner) == function ]] && {
      post_test_runner; }
  }

  box_string() {
    local string="$1"
    local -i stringLen=${#string}
    (( stringLen += 2 )) # +2 for spaces
    [[ -n $icon ]] && (( stringLen += 2 ))
    printf -v "horz" '%.s─' $(seq 1 $stringLen) # create horizontal line in var horz
    printf "${style}"'\u250c%s\u2510\n\u2502'"${icon}"' %s \u2502\n\u2514%s\u2518\n\e[m' "$horz" "$string" $horz
  }

  trap 'cleanup' EXIT

  for i in "${!_tests[@]}"; do
    TEST_RUNNER_ERROR_COUNT=0
    TEST_RUNNER_SUCCESS_COUNT=0
 
    output=$(
      trap "exit_test" EXIT
      [[ $(type -t pre_test_runner) == function ]] && {
        pre_test_runner; }
        
      ${_tests[$i]} 2>&1 
    ) 
    res=$?
     
    # shellcheck disable=SC1090
    if [[ -f "$tmpFile" ]]; then
       
      source "$tmpFile"
      success_count=$(( success_count+=TEST_RUNNER_SUCCESS_COUNT ))
      error_count=$(( error_count+=TEST_RUNNER_ERROR_COUNT ))

      rm -f "$tmpFile"
    fi
  
    set_print_style
    local comment=;comment="${_comments[$i]}"
    if [[ -z "${comment}" ]]; then
      comment="${_tests[$i]//_/ }"
    fi

    printf "${style}${icon}"' %s) '\''%s'\''\n\e[0m' "$(( i+1 ))" "${comment}" 
    
    [[ -n "$output" ]] && printf "${style}"'%s\n\e[0m' "$output"

    if (( res != 0 )) && [[ $EXIT_ON_FAILED_TEST  ]]; then
      break
    fi
  done
 
  box_string "Tests completed: ${success_count} succeeded; ${error_count} failed"
   
  TEST_RUNNER_ERROR_COUNT=0
  TEST_RUNNER_SUCCESS_COUNT=0

  if (( res != 0 )) && [[ $EXIT_ON_FAILED_TEST  ]]; then
    exit 1
  fi

}

###################################
# Gets an array of public test functions
# from a file and then executes each
# function in a separate process
# Arguments:
#   $1 - optional; pass --summary, used to display 
#      a summary of the tests rather than showing 
#      each result
#   $1 - required; The file containing the 
#        tests to run
#   $2 - optional; Filters the name of the test
#        The default filter is "^assert_*"
# Each function is run in its own
# isolated process '(...)''
###################################
test_runner_all() {

  local -a summary=()
  [[ "$1" == "--summary" ]] && { shift; summary=(--summary); }
 
  local file="${1:-${BASH_SOURCE[1]}}"
  local filter="${2:-^test_.*}"
 
  [[ -f "$file" ]] || { echo "file not found: $file" >&2; return 1; }
 
  # shellcheck disable=SC2034
  local -a tests comments
 
  __get_public_functions "$file" "$filter" tests comments

  #echo "testrunner test func count: ${#tests[@]}"  
  #for i in "${!tests[@]}"; do   
  #  echo "testrunner test func: ${tests[i]}"
  #done
  #tests=("test1" "test2")
  #comments=("comment1" "comment2")
  test_runner "${summary[@]}" tests comments 
 
}

###################################
# test runner for a complete set of 
# tests in a file
# Arguments:
#   $1 - optional; pass --summary, used to display 
#      a summary of the tests rather than showing 
#      each result
#   $1 - required The file to load using the source command
#   $2 - optional bash regx filter used filter the
#      functions names
# Notes:
# The source file is loaded into a
# separate process before calling
# test_runner_all to run all the tests in the file.
###################################
 
test_runner_on_source_file() {
 
  (
      local summary=()
      [[ "${1:-}" == "--summary" ]] && { shift; summary=("--summary"); }
      local src="${1}"
      local filter="${2:-}"
 
    if head -n 10 "$src" | grep -iq "# test-runner-ignore"; then
      echo "file: $1"
      echo "test-runner:file ignored: file contains # test-runner-ignore tag" >&2
      return 0;
    fi
 
    #shellcheck disable=SC1090
    source "$src"
    
    printf '\e[48;5;25m\n%s\n\e[0m\e[K' "${src##*/}" #"$spaces"

    test_runner_all "${summary[@]}" "${src}" "${filter}"
 
  )
}

__get_public_functions() {
  local file="$1"
  local filter="$2"
  local -n _names="$3"
  local -n _comments="$4"

  _names=()
  _comments=()

  [[ -f "$file" ]] || return 1

  local last_comment=""
  local fn="" pending_func=""

  while IFS= read -r line; do
    # Capture single comment line
    if [[ "$line" =~ ^[[:space:]]*#[[:space:]]*(.*)$ ]]; then
      last_comment="${BASH_REMATCH[1]}"
      continue
    fi

    # Reset comment on blank or non-comment, non-function line
  
      # Match function definitions
    if [[ -n $pending_func ]]; then
      if [[ $line =~ ^[[:space:]]*\{ ]]; then
        fn="$pending_func"
        pending_func=""
      else
        continue
      fi
    else 
      [[ "$line" =~ ^[[:space:]]*$ ]] && { last_comment=""; continue; }
      [[ ! "$line" =~ ^[[:space:]]*(function[[:space:]]+)?[a-zA-Z_] ]] && last_comment=""

      if [[ "$line" =~ ^[[:space:]]*(function[[:space:]]+)?([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*(\(\))?[[:space:]]*\{ ]]; then
        fn="${BASH_REMATCH[2]}"

      elif [[ $line =~ ^[[:space:]]*(function[[:space:]]+)?([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*(\(\))?[[:space:]]*$ ]]; then
        pending_func="${BASH_REMATCH[1]}"
      fi
    fi

    if [[ -n $fn ]]; then
      local _fn="$fn"
      fn=""
      # Skip private functions
      [[ "$_fn" == _* ]] && last_comment="" && continue

      # Optional filter
      
      [[ -n "$filter" && ! "$_fn" =~ $filter ]] && last_comment="" && continue
  
      _names+=("$_fn")
      _comments+=("$last_comment")
      last_comment=""
    fi
  done < "$file"
 
}
 
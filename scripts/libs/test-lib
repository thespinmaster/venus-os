}

###################################
# Asserts if arg2 contains the string in arg1
# Arguments:
#   $1 - required; the string value to match
#   $1 - required; the string to look for the match in
#   $3 - optional comment
###################################
assert_contains() {
  local res=false
  local match="${1}"
  local source="${2:-}"
  local comment="${3:-}"
  __set_comment comment "Contains"
  # don't try to match if match string is empty
 
  [[ -n "${match}" ]] && [[ "$source" == *"${match}"* ]] && res=true
  __assert_lib_pass_or_fail $res "$comment" "arg1:$source" "arg2:$match"
}
###################################
# Asserts if arg2 does not contain the string in arg1
# Arguments:
#   $1 - required; the string value to match
#   $1 - required; the string to look for the match in
#   $3 - optional comment
###################################
assert_not_contain() {
   local res=false
  local match="${1}"
  local source="${2:-}"
  local comment="${3:-}"
  __set_comment comment "Contains"
  # don't try to match if match string is empty
 
  [[ -n "${match}" ]] && [[ "$source" == *"${match}"* ]] || res=true
  __assert_lib_pass_or_fail $res "$comment" "arg1:$source" "arg2:$match"
}

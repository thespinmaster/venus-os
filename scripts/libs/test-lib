  local comment="${2:-}"
  [[ ! -v $1 ]] && res=true # normalize the results to true/false
  __set_comment comment "Variable exists; ${1}"
  __assert_lib_pass_or_fail $res "$comment" "${1}"
}

###################################
# Logs the result of an external test
# Arguments:
#   $1 result
#   $2 comment
#   $3 any args
###################################
assert_result() {
  local res=false
  local comment="${2:-}"
  [[ ${1} == true ||  ${1} == 0 ]] && res=true # normalize the results to true/false
  __set_comment comment "Test Result=${1}"
  shift 2 # for args
  __assert_lib_pass_or_fail $res "$comment" "${@}"
}


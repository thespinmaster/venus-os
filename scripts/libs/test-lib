  local comment="${2:-}"
  [[ -v $1 ]] && res=true
  __set_comment comment "Variable exists; ${1}"
  __assert_lib_pass_or_fail $res "$comment" "${1}"
}

###################################
# Asserts if a variable does not exist (not unset)
# Arguments:
#   $1 variable name
#   $2 comment
###################################
assert_var_not_exist() {

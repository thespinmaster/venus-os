#!/bin/bash
# ensures the alias file exists for login and non-login bash shells
# called from /data/rc.local and setup

set -e

#declare alias_target=/data/dev/scripts/my-alias.sh
#declare alias_file=/etc/profile.d/my-alias.sh
declare command_target=/data/dev/scripts/dev-helper
declare command_link=/usr/local/bin/dev

#if [[ "$(readlink -f "${alias_file}" 2>/dev/null)" != "${alias_target}" ]]; then
#  echo "linking ${alias_file} -> ${alias_target}"
#  ln -sfn "${alias_target}" "${alias_file}"
#fi

if [[ ! -x "${command_target}" ]]; then
  chmod +x "${command_target}"
fi

if [[ "$(readlink -f "${command_link}" 2>/dev/null)" != "${command_target}" ]]; then
  echo "linking ${command_link} -> ${command_target}"
  ln -sfn "${command_target}" "${command_link}"
fi
 
echo "alias setup complete"
 
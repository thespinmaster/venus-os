#!/usr/bin/env bash
# newline_safe.sh - newline-safe Bash helpers
# Supports in-place NUL-safe pipelines, tracing, arguments, and validation.

####################################################
# Configuration
####################################################

# Enable tracing by setting to 1
: "${NUL_PIPE_TRACE:=0}"

####################################################
# Internal helpers
####################################################

_trace() {
  (( NUL_PIPE_TRACE )) && printf '[nul-pipe] %s\n' "$*" >&2
}

####################################################
# Append NUL terminator
# Arguments:
#   $1 - string to emit
####################################################
append_nul() {
  printf '%s\0' "$1"
}

####################################################
# Read NUL-terminated input into a variable
# Arguments:
#   $1 - variable name
####################################################
read_to_var() {
  local -n _out=$1
  IFS= read -r -d '' _out
}

set_var() {
  local -n _out=$1
  IFS= read -r -d '' _out
}
send_var () {
  #local -n _in=$1
  #printf '%s' "${_in}"
  #local var=$1
  #printf '%s\0' "${!var}"
  printf '%s\0' "${1}"
}

####################################################
# Assert that stdin is NUL-terminated
# Usage:
#   assert_nul
####################################################
assert_nul() {
  local data
  if ! IFS= read -r -d '' data; then
    printf 'ERROR: consumer did not emit NUL-terminated output\n' >&2
    return 1
  fi
  append_nul "$data"
}

####################################################
# Run a producer function and capture output in-place
# Arguments:
#   $1 - producer function name
#   $2 - variable name (input/output)
####################################################
output_to_var_nul() {
  local func=$1
  local var=$2

  _trace "producer → $func($var)"

  IFS= read -r -d '' tmp < <(
    "$func" "${!var}"
    printf '\0'
  )

  printf -v "$var" '%s' "$tmp"
}

####################################################
# Run a consumer function in-place (NUL-safe)
# Supports consumer arguments
# Arguments:
#   $1 - consumer function name
#   $2 - variable name (input/output)
#   $3... - optional consumer arguments
####################################################
run_consumer_nul() {
  local consumer_func=$1
  local var=$2
  shift 2

  _trace "consumer → $consumer_func("$var" $*)"

  IFS= read -r -d '' tmp < <(
    printf '%s\0' "${!var}" | "$consumer_func" "$@" | assert_nul
  )

  printf -v "$var" '%s' "$tmp"
}

####################################################
# Pipe multiple consumers in sequence (in-place)
# Supports arguments per consumer
# Arguments:
#   $1 - variable name
#   Remaining args:
#     consumer_name [args...] -- consumer_name [args...] ...
#
# Usage:
#   pipe_consumers_nul var \
#     consumer1 arg arg -- \
#     consumer2 -- \
#     consumer3 foo
####################################################
pipe_consumers_nul() {
  local var=$1
  shift

  local current=()
  local consumer

  for token in "$@"; do
    if [[ $token == -- ]]; then
      consumer=${current[0]}
      run_consumer_nul "$consumer" "$var" "${current[@]:1}"
      current=()
    else
      current+=("$token")
    fi
  done

  # Run final consumer
  if (( ${#current[@]} )); then
    consumer=${current[0]}
    run_consumer_nul "$consumer" "$var" "${current[@]:1}"
  fi
}

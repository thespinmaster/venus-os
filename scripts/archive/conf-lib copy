#!/usr/bin/env bash
# conf_lib.sh — Version 1.0.2
#
# Bash configuration library with secret support
# Features:
# - Pipe-delimited schema: NAME | TYPE | FLAGS | DEFAULT
# - Types: string, int, bool, enum
# - Flags: required, secret
# - Default values applied automatically
# - Supports heredocs, multiline strings
# - Linting: --style, --fix, --json
# - Save: --dry-run, --diff
# - Secret variables are masked in outputs
#
# Note: No longer uses set -o errexit globally

set -o pipefail
set -o nounset

# ============================================================
# Schema state
# ============================================================
declare -A CONF_LIB_SCHEMA_TYPES=()
declare -A CONF_LIB_SCHEMA_DEFAULTS=()
declare -A CONF_LIB_SCHEMA_FLAGS=()
declare -A CONF_LIB_SCHEMA_VARIABLES=()
declare -A CONF_LIB_SCHEMA_SECRET=()
CONF_SCHEMA_FLAG_REQUIRED=0x1
CONF_SCHEMA_FLAG_SECRET=0x2
CONF_SCHEMA_FLAG_READONLY=0x4

# ============================================================
# Internal cleanup
# ============================================================
_conf_lib_schema_reset() {
  CONF_LIB_SCHEMA_TYPES=()
  CONF_LIB_SCHEMA_DEFAULTS=()
  CONF_LIB_SCHEMA_FLAGS=()
  CONF_LIB_SCHEMA_VARIABLES=()
  CONF_LIB_SCHEMA_SECRET=()
}

# ============================================================
# Load pipe-delimited schema with secret support
# Arguments:
#   $1 - schema file
conf_lib_load_schema() {
  local schema_file="$1"
  _conf_lib_schema_reset
  [[ -f "$schema_file" ]] || {
    echo "ERROR: Schema file not found: $schema_file" >&2
    return 1
  }

  local line name type flags default
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    [[ "$line" =~ ^# ]] && continue

    IFS='|' read -r name type flags default <<<"$line"
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    type="${type#"${type%%[![:space:]]*}"}"
    type="${type%"${type##*[![:space:]]}"}"
    flags="${flags#"${flags%%[![:space:]]*}"}"
    flags="${flags%"${flags##*[![:space:]]}"}"
    default="${default#"${default%%[![:space:]]*}"}"
    default="${default%"${default##*[![:space:]]}"}"

    [[ -z "$name" || -z "$type" ]] && continue

    CONF_LIB_SCHEMA_VARIABLES["$name"]=1
    CONF_LIB_SCHEMA_TYPES["$name"]="$type"
    CONF_LIB_SCHEMA_FLAGS["$name"]=0
    CONF_LIB_SCHEMA_SECRET["$name"]=0

    [[ "$flags" =~ required ]] && CONF_LIB_SCHEMA_FLAGS["$name"]=1
    [[ "$flags" =~ secret ]] && CONF_LIB_SCHEMA_SECRET["$name"]=1

    CONF_LIB_SCHEMA_DEFAULTS["$name"]="$default"
  done <"$schema_file"
}

# ============================================================
# Validate value type
# Arguments:
#   $1 - variable name
#   $2 - value
conf_lib_validate_value() {
  local key="$1"
  local value="$2"
  local type
  type="${CONF_LIB_SCHEMA_TYPES[$key]}"

  if [[ "$type" =~ ^enum:(.*)$ ]]; then
    local enum_vals="${BASH_REMATCH[1]}"
    IFS=',' read -r -a allowed <<<"$enum_vals"
    for v in "${allowed[@]}"; do
      [[ "$value" == "$v" ]] && return 0
    done
    echo "ERROR: Value '$value' for '$key' is not in enum($enum_vals)" >&2
    return 1
  fi

  case "$type" in
  string) return 0 ;;
  int) [[ "$value" =~ ^-?[0-9]+$ ]] ;;
  bool) [[ "$value" == "true" || "$value" == "false" ]] ;;
  *)
    echo "ERROR: Unknown type '$type' for '$key'" >&2
    return 1
    ;;
  esac
}

# ============================================================
# Mask secret values for output
_mask_secret() {
  local key="$1"
  [[ "${CONF_LIB_SCHEMA_SECRET[$key]:-0}" == "1" ]] && printf '*****' || printf '%s' "${!key:-}"
}

# ============================================================
# Lint config file
# Arguments:
#   $1 - config file
#   $2 - schema file
# Options:
#   --style, --fix, --json
conf_lib_lint() {
  local vars_file schema_file
  local -i style=0 fix=0 json=0 display=0
  local -i errors=0 lineno=0
  local -a json_errors=()
  local in_heredoc=0 key heredoc_tag line
  local -a SEEN_KEYS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --style) style=1 ;;
    --fix) fix=1 ;;
    --json) json=1 ;;
    --display) display=1 ;;
    --)
      shift
      break
      ;;
    *)
      [[ -z "${vars_file:-}" ]] && vars_file="$1" || [[ -z "${schema_file:-}" ]] && schema_file="$1.schema"
      ;;
    esac
    shift
  done

  [[ -f "$vars_file" ]] || {
    echo "ERROR: Config file not found: $vars_file" >&2
    return 1
  }
  conf_lib_load_schema "$schema_file" || return 1
  
  while IFS= read -r line || [[ -n "$line" ]]; do
    ((lineno++))

    if ((in_heredoc)); then
      [[ "$line" == "$heredoc_tag" ]] && in_heredoc=0
      continue
    fi

    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    
    if [[ "$line" =~ ^([[:space:]]*)([A-Za-z_][A-Za-z0-9_]*)=\" ]]; then
      key="${BASH_REMATCH[1]}"
      SEEN_KEYS+=("$key")
    elif [[ "$line" =~ ^([[:space:]]*)([A-Za-z_][A-Za-z0-9_]*)=\<\<([A-Za-z0-9_]+)$ ]]; then
      key="${BASH_REMATCH[1]}"
      heredoc_tag="${BASH_REMATCH[2]}"
      SEEN_KEYS+=("$key")
      in_heredoc=1
    else
      ((errors++))
      ((display)) && printf 'line:%s,error: unknown variable: %s\n' "$lineno" "$line" >&2
      ((json)) && { json_errors+=("{\"line\":\"$line\",\"error\":\"invalid format\"}") || true; }
      continue
    fi

    if [[ -z "${CONF_LIB_SCHEMA_VARIABLES[$key]:-}" ]]; then
      ((errors++))
      ((display)) && printf 'line:%s,error: unknown variable: %s\n' "$lineno" "$line" >&2
      ((json)) && { json_errors+=("{\"line\":\"$line\",\"error\":\"unknown variable\"}") || true; }
    fi
  done <"$vars_file"

  local k
  for k in "${!CONF_LIB_SCHEMA_FLAGS[@]}"; do
    if [[ "${CONF_LIB_SCHEMA_FLAGS[$k]}" == "1" ]]; then
      if ! printf '%s\n' "${SEEN_KEYS[@]}" | grep -qx "$k"; then
        ((errors++))
        ((display)) && printf 'line:%s,error: unknown variable: %s\n' "$lineno" "$line" >&2
        ((json)) && { json_errors+=("{\"variable\":\"$k\",\"error\":\"required missing\"}") || true; }
      fi
    fi
  done

  if ((style)) || ((fix)); then
    local tmp val
    tmp="$(mktemp)"
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
        key="${BASH_REMATCH[1]}"
        val="$(_mask_secret "$key")"
        ((fix)) && printf '%s="%s"\n' "$key" "$val" >>"$tmp" || echo "$key=$val"
      else
        ((fix)) && echo "$line" >>"$tmp" || echo "$line"
      fi
    done <"$vars_file"
    ((fix)) && mv "$tmp" "$vars_file"
  fi

  if ((json)) && ((${#json_errors[@]} > 0)); then
    printf '[%s]\n' "$(
      IFS=,
      echo "${json_errors[*]}"
    )"
  fi

  _conf_lib_schema_reset
  return "$errors"
}

# ============================================================
# Load variables into shell (secrets are real values)
# Arguments:
#   $1 - config file
#   $2 - schema file
conf_lib_load() {
  local vars_file="$1" schema_file="$2"
  conf_lib_lint "$vars_file" "$schema_file" || return 1
  conf_lib_load_schema "$schema_file" || return 1

  local line key value buffer heredoc_tag in_heredoc=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if ((in_heredoc)); then
      if [[ "$line" == "$heredoc_tag" ]]; then
        buffer="${buffer%$'\n'}"
        printf -v "$key" '%s' "$buffer"
        buffer=""
        in_heredoc=0
      else
        buffer+="$line"$'\n'
      fi
      continue
    fi

    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue

    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=\"(.*)\"$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      value="${value//\\\"/\"}"
      value="${value//\\\\/\\}"
      printf -v "$key" '%s' "$value"
    elif [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=\<\<([A-Za-z0-9_]+)$ ]]; then
      key="${BASH_REMATCH[1]}"
      heredoc_tag="${BASH_REMATCH[2]}"
      buffer=""
      in_heredoc=1
    fi
  done <"$vars_file"

  local k
  for k in "${!CONF_LIB_SCHEMA_VARIABLES[@]}"; do
    if [[ -z "${!k:-}" && -n "${CONF_LIB_SCHEMA_DEFAULTS[$k]:-}" ]]; then
      printf -v "$k" '%s' "${CONF_LIB_SCHEMA_DEFAULTS[$k]}"
    fi
  done

  _conf_lib_schema_reset
}

# ============================================================
# Save / update variables back to file (mask secrets in outputs)
# Arguments:
#   --dry-run
#   --diff
#   $1 - config file
#   $2 - schema file
conf_lib_save() {
  local dry_run=0 diff=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --dry-run) dry_run=1 ;;
    --diff) diff=1 ;;
    *) break ;;
    esac
    shift
  done

  local vars_file="$1" schema_file="$2"
  conf_lib_load_schema "$schema_file" || return 1
  [[ -f "$vars_file" ]] || {
    echo "ERROR: Config file missing" >&2
    _conf_lib_schema_reset
    return 1
  }

  local tmp
  tmp="$(mktemp)"
  local line key heredoc_tag in_heredoc=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    if ((in_heredoc)); then
      echo "$line" >>"$tmp"
      [[ "$line" == "$heredoc_tag" ]] && in_heredoc=0
      continue
    fi

    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=\" ]]; then
      key="${BASH_REMATCH[1]}"
      if [[ -n "${CONF_LIB_SCHEMA_VARIABLES[$key]:-}" && -n "${!key:-}" ]]; then
        printf '%s="%s"\n' "$key" "${!key//\"/\\\"}" >>"$tmp"
      else
        echo "$line" >>"$tmp"
      fi
    elif [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=\<\<([A-Za-z0-9_]+)$ ]]; then
      key="${BASH_REMATCH[1]}"
      heredoc_tag="${BASH_REMATCH[2]}"
      in_heredoc=1
      echo "$line" >>"$tmp"
      if [[ -n "${!key:-}" ]]; then
        printf '%s\n' "${!key}" >>"$tmp"
        echo "$heredoc_tag" >>"$tmp"
        read -r _ || true
        continue
      fi
    else
      echo "$line" >>"$tmp"
    fi
  done <"$vars_file"

  ((diff)) && { diff -u "$vars_file" "$tmp" || true; }
  if ((dry_run)); then
    rm -f "$tmp"
    _conf_lib_schema_reset
    return 2
  fi
  cp "$vars_file" "$vars_file.bak"
  mv "$tmp" "$vars_file"

  _conf_lib_schema_reset
}

conf_lib_save_with_schema() {
  local var_file="$1"
  local schema_file=${var_file}.schema
  local dry_run="$2"
 
  conf_lib_load_schema "$schema_file" || return 1
  [[ ! -f "$var_file" ]] || {
    touch "$var_file" 
    
    return
  }
 
  local tmp="${var_file}.tmp"
  local line key indent heredoc_tag
  local in_multiline=0
  local in_heredoc=0
  local valid=1

  escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
  }

  [[ "$dry_run" != "--dry-run" ]] && 
    cp "$var_file" "${var_file}.bak"> "$tmp"

  while IFS= read -r line || [[ -n "$line" ]]; do

    if (( in_heredoc )); then
      [[ "$line" == "$heredoc_tag" ]] && in_heredoc=0
      continue
    fi

    if (( in_multiline )); then
      [[ "$line" == *'"' ]] && in_multiline=0
      continue
    fi

    if [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]]; then
      printf '%s\n' "$line" >> "$tmp"
      continue
    fi

    if [[ "$line" =~ ^([[:space:]]*)([A-Za-z_][A-Za-z0-9_]*)\<\<([A-Za-z0-9_]+)$ ]]; then
      indent="${BASH_REMATCH[1]}"
      key="${BASH_REMATCH[2]}"
      heredoc_tag="${BASH_REMATCH[3]}"

      if [[ -n "${!key+x}" ]]; then

        printf '%s%s<<%s\n%s\n%s\n' "$indent" "$key" "$heredoc_tag" \
                "$(escape "${!key}")" "$heredoc_tag" >> "$tmp"
 
        in_heredoc=1
        continue
      fi
    fi

    if [[ "$line" =~ ^([[:space:]]*)([A-Za-z_][A-Za-z0-9_]*)=\" ]]; then
      indent="${BASH_REMATCH[1]}"
      key="${BASH_REMATCH[2]}"

      if [[ -n "${!key+x}" ]]; then
        printf '%s%s="%s"\n' "$indent" "$key" "$(escape "${!key}")" >> "$tmp"
    
        [[ "$line" != *'"' ]] && in_multiline=1
        continue
      fi
    fi

    printf '%s\n' "$line" >> "$tmp"
  done < "$var_file"

  if (( valid )); then
    [[ "$dry_run" == "--dry-run" ]] && diff -u "$var_file" "$tmp" || mv "$tmp" "$var_file"
  else
    rm -f "$tmp"
    return 1
  fi
}